<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 全局基准字号（字体缩放，bug #10）：未显式设定 FontSize 的控件随该值变化 -->
    <sys:Double x:Key="BaseFontSize">13</sys:Double>

    <Style TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
    </Style>

    <!-- 全局控件基准字号（字体缩放，bug #10）：未显式设定 FontSize 的控件随该值变化 -->
    <Style TargetType="Control">
        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
    </Style>

    <!-- ===== 本字典私用辅助笔刷 =====
         CardBackground / CardBorderHover / ToggleOffBrush 已迁移到 LightTheme.xaml / DarkTheme.xaml，
         随亮/暗主题动态切换（bug #22：此前硬编码暗色，亮色模式下卡片仍为暗底）。 -->
    <SolidColorBrush x:Key="ModalScrimBrush" Color="#80000000"/>

    <!--
        ===== ToggleSwitch（规格 1.4：所有开关用滑动开关，无复选框） =====
        基于 ToggleButton 改造：灰色轨道 / 主题色轨道，白色旋钮左右滑动。
        用法：<ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding X}"/>
    -->
    <!--
        ===== MiniIconButtonStyle（状态栏迷你播放条 / 紧凑工具条的小图标按钮） =====
        底栏迷你条只有 22~26px 高，原先 Background="Transparent" 且无任何触发器 ——
        鼠标停在上面没有任何反馈，与标题栏按钮的 hover 反馈不一致。

        三档状态：静止透明 → 悬浮 ControlHoverBackground（150ms 淡入）→ 按下 ControlPressedBackground。
        动效用 ColorAnimation 改 Border.Background 的 Color（不是直接动画 DynamicResource 画刷，
        那是合并字典里的共享/已冻结画刷，动画它会抛异常）。
        焦点：这类小按钮点完即走，不参与 Tab 序（Focusable=False），但保留 IsTabStop=false 语义。
    -->
    <Style x:Key="MiniIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource ControlHoverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource ControlPressedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                Background="{DynamicResource ToggleOffBrush}"
                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"/>
                        <!--
                            选中态的强调色单独一层做 opacity 过渡（对齐 HTML transition:.15s ease）——
                            直接换 Track.Background 是瞬变，且那两个画刷来自合并字典、动画会抛「已冻结」。
                        -->
                        <!--
                            常态 Opacity=0，只在选中时淡入（配合下方 Trigger 的 Enter/Exit 动画）。
                            漏写 Opacity="0" 的后果：强调色层常驻 → 每个开关看起来都是「已开启」的实心色块。
                        -->
                        <Border x:Name="TrackAccent" Width="44" Height="24" CornerRadius="12"
                                Background="{DynamicResource AccentBrush}" Opacity="0"/>
                        <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White"
                                 HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="KnobX" X="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- 兜底：模板加载时即为选中态也要正确着色（动画优先级高于 Setter，正常路径走动画） -->
                            <Setter TargetName="TrackAccent" Property="Opacity" Value="1"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobX"
                                                         Storyboard.TargetProperty="X"
                                                         To="22" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="TrackAccent"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15"
                                                         FillBehavior="Stop"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobX"
                                                         Storyboard.TargetProperty="X"
                                                         To="0" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="TrackAccent"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15"
                                                         FillBehavior="Stop"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.5"/>
                            <Setter TargetName="Knob" Property="Opacity" Value="0.7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ===== Card（规格 1.4：圆角阴影，悬停放大/上浮） =====
        基于 ContentControl：外层 Border 圆角 + 阴影，悬停时上浮 6px、边框转主题色。
        用法：<ContentControl Style="{StaticResource CardStyle}"> ... 内容 ... </ContentControl>
    -->
    <Style x:Key="CardStyle" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="12" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorder}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect x:Name="Shadow" BlurRadius="10" ShadowDepth="2"
                                              Opacity="0.28" Color="Black"/>
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="Lift" Y="0"/>
                        </Border.RenderTransform>
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardBorderHover}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift"
                                                         Storyboard.TargetProperty="Y"
                                                         To="-6" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ===== CardBorder（Border 专用卡片外观） =====
        CardStyle 是 ContentControl 样式（含 ControlTemplate），不能直接套在 Border 上。
        这里提供外观等价的 Border 样式：圆角 + 1px 边框 + 卡片背景，供 Border 元素复用。
    -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!--
        ===== 横向滚动卡片流（规格 1.4：卡片流横向滚动） =====
        组合：ScrollViewer（横向）+ StackPanel（横向排布，卡片间 14px 间距由 CardStyle.Margin 提供）。
    -->
    <!--
        横向卡片流容器。
        ★ 滚轮支持（problem3）：WPF 的 ScrollViewer 对「滚轮」默认只处理垂直方向，
          横向 ScrollViewer 必须显式把垂直滚轮换算成水平偏移，否则鼠标停在内容中间时
          滚轮完全无效 —— 用户表现为「必须把鼠标移到最左/最右露出滚动条才能拖」。
        ★ CanContentScroll="False"：内容是无宽度约束的横向 StackPanel
          （CardFlowPanelStyle），按项滚动会拿不到可滚范围，必须按像素滚动。
    -->
    <Style x:Key="HorizontalScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Padding" Value="2,6,2,6"/>
        <Setter Property="CanContentScroll" Value="False"/>
        <Setter Property="PanningMode" Value="HorizontalOnly"/>
    </Style>

    <Style x:Key="CardFlowPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin" Value="0,2,0,2"/>
    </Style>

    <!--
        ===== 模态弹窗三件套（规格 1.4：模态居中、半透明遮罩、主操作右置） =====
        遮罩 Grid 覆盖整页 → 居中 Border 卡片 → 底部右置按钮行。
    -->
    <Style x:Key="ModalOverlayStyle" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource ModalScrimBrush}"/>
    </Style>

    <Style x:Key="ModalCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="22"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="MaxWidth" Value="540"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModalButtonRowStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,18,0,0"/>
    </Style>

    <!--
        ===== 按钮（主操作 / 次操作） =====
        主按钮：主题色实心；次按钮：描边幽灵按钮。供弹窗与全局复用。
    -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!-- 默认居中，但允许调用方用 HorizontalContentAlignment="Left" 覆盖（模板必须 TemplateBinding 才吃得到） -->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"/>
                        <Border x:Name="HoverMask" CornerRadius="8" IsHitTestVisible="False" Opacity="0"
                                Background="{DynamicResource AccentHoverBrush}"/>
                        <Border Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverMask"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverMask"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource ButtonDisabledBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="Margin" Value="10,0,0,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}"/>
                        <Border x:Name="HoverMask" CornerRadius="8" IsHitTestVisible="False" Opacity="0"
                                Background="{DynamicResource ControlHoverBackground}"/>
                        <Border Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverMask"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverMask"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ===== 全局隐式按钮样式（bug #27：移除 WPF 原生按键外观，统一沿用设计语言） =====
        所有未显式指定 Style 的 Button 均套用此样式（圆角 8 / 主题边框 / 悬停主题色描边）。
        已显式使用 PrimaryButtonStyle / GhostButtonStyle 或自带 Button.Style 的按钮不受影响。
    -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <!--
            默认居中（保持既有观感），但模板改成了 TemplateBinding，
            调用方显式写 HorizontalContentAlignment="Left" 现在能真正生效 ——
            此前模板把 HorizontalAlignment 写死为 Center，任何 Left 都被忽略
            （音乐播放列表「条目文字居中、应该靠左」即由此而来）。
        -->
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!--
                        动效：悬停 / 按下改成**过渡**而不是瞬变（对齐 HTML .btn 的
                        transition: .15s ease）。

                        实现要点：不直接动画 Background / BorderBrush ——
                        它们由 DynamicResource 提供、是合并字典里的**共享画刷**，动画会抛
                        「无法冻结/已被冻结」一类异常。这里改为在上面叠一层
                        **Opacity 过渡的高亮蒙版**，既拿到平滑过渡，又完全不碰共享画刷。
                    -->
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"/>
                        <Border x:Name="HoverMask" CornerRadius="8" IsHitTestVisible="False" Opacity="0"
                                Background="{DynamicResource ControlHoverBackground}"/>
                        <!--
                            ★ 内容必须单独一层、压在蒙版**之上**。
                              ControlHoverBackground 是**不透明**色（亮 #F0F0F0 / 暗 #252830），
                              蒙版盖住内容就等于把按钮文字抹掉 —— 上一轮把 ContentPresenter
                              放在蒙版下面是个错误，这里修正。
                        -->
                        <Border Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverMask"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverMask"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ===== 全局隐式下拉框样式（圆角 8 / 主题边框 / 悬停主题色描边；下拉弹层随亮暗主题着色） =====
        提供完整 ControlTemplate：下拉弹出层（Popup）用 ControlBackground 着色，暗色下不再退回系统亮白底；
        已显式指定 Style 的 ComboBox 不受影响。
    -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" StaysOpen="False"
                               Placement="Bottom" VerticalOffset="2"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                               PopupAnimation="Slide">
                            <Border Background="{DynamicResource ControlBackground}"
                                    BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                    CornerRadius="8"
                                    TextElement.Foreground="{DynamicResource PrimaryForeground}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" SnapsToDevicePixels="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>

                        <ToggleButton x:Name="ToggleButton"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
                                        <Border x:Name="HoverMask" CornerRadius="8" IsHitTestVisible="False" Opacity="0"
                                                Background="{DynamicResource ControlHoverBackground}"/>
                                        <!-- 内容层：保持原几何（文本左内边距 8、右侧给箭头留 28、箭头距右 10） -->
                                        <Grid>
                                            <ContentPresenter x:Name="ContentSite"
                                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                              HorizontalAlignment="Left" VerticalAlignment="Center"
                                                              Margin="8,0,28,0" IsHitTestVisible="False"
                                                              TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                            <!-- 展开时箭头旋转 180°（对齐 HTML 下拉的 chevron 翻转） -->
                                            <Path x:Name="Arrow" Data="M 0 0 L 4 4 L 8 0"
                                                  Stroke="{DynamicResource SecondaryForeground}" StrokeThickness="1.5"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="ArrowRotate" Angle="0"/>
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverMask"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="1" Duration="0:0:0.15"
                                                                         EasingFunction="{StaticResource MotionEase}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="HoverMask"
                                                                         Storyboard.TargetProperty="Opacity"
                                                                         To="0" Duration="0:0:0.12"
                                                                         EasingFunction="{StaticResource MotionEase}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                                         Storyboard.TargetProperty="Angle"
                                                                         To="180" Duration="0:0:0.15"
                                                                         EasingFunction="{StaticResource MotionEase}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="ArrowRotate"
                                                                         Storyboard.TargetProperty="Angle"
                                                                         To="0" Duration="0:0:0.15"
                                                                         EasingFunction="{StaticResource MotionEase}"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}"
                                 Margin="8,0,28,0" VerticalContentAlignment="Center"
                                 Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"
                                 Background="Transparent" Foreground="{DynamicResource PrimaryForeground}"
                                 BorderThickness="0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        ===== 下拉项（ComboBoxItem）：随亮/暗主题着色；亮色下用 PrimaryForeground 保证对比度，不再过淡 =====
    -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Border Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        <Border x:Name="HoverMask" IsHitTestVisible="False" Opacity="0"
                                Background="{DynamicResource AccentBrush}"/>
                        <Border Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ControlHoverBackground}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsSelected" Value="True"/>
                    <Condition Property="IsMouseOver" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="White"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!--
        ===== 右键菜单 / 菜单项（ContextMenu / MenuItem）：随亮暗主题着色，避免暗色下退回系统亮白底 =====
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.30" Color="Black"/>
                        </Border.Effect>
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        ===== ToggleChip：切换/分段型按钮（取色、皮肤编辑器 2D/3D 等） =====
        这批按钮此前没有样式，落回 WPF 默认外观（系统灰方框 + 系统字体），
        与全局 Button 样式明显不是一套语言。这里给出同款圆角胶囊外观，选中态用强调色实底。
        用法：<ToggleButton Style="{StaticResource ToggleChipStyle}" IsChecked="{Binding X}"/>
    -->
    <Style x:Key="ToggleChipStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"/>
                        <!-- 悬停蒙版在下、选中蒙版在上：已选中的开关悬停时保持强调色实底，观感稳定 -->
                        <Border x:Name="HoverMask" CornerRadius="8" IsHitTestVisible="False" Opacity="0"
                                Background="{DynamicResource ControlHoverBackground}"/>
                        <Border x:Name="CheckMask" CornerRadius="8" IsHitTestVisible="False" Opacity="0"
                                Background="{DynamicResource AccentBrush}"/>
                        <Border Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverMask"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverMask"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMask" Property="Opacity" Value="1"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckMask"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckMask"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ===== CheckBox / RadioButton：强制继承主题前景，避免暗色下退回系统黑字 =====
    -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!--
        ===== 暗色主题：强制文本型控件继承主题前景，避免黑底黑字 =====
        默认 WPF 模板在暗色下会回退到 SystemColors.WindowTextBrush（黑），
        下面统一覆盖常用文本容器与输入控件的前景色/背景。
        注意：隐式样式（TargetType 无 x:Key）不要写 BasedOn="{x:Type X}"，该写法在合并字典里
        按静态资源查找默认主题样式，常因解析失败抛 XamlParseException（性能页崩溃即源于此）。
        省略 BasedOn 时 WPF 会自动把默认主题样式作为基样式（保留控件模板），效果等价且更安全。
    -->
    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
    </Style>
    <Style TargetType="ListView">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
    </Style>
    <!-- ===== 统一文本框样式（清单 #61）=====
         统一内边距 / 最小高度 / 垂直居中，并给出悬停、聚焦、禁用三态反馈；
         带占位提示的 PlaceholderTextBoxStyle 基于本样式派生。 -->
    <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource InputForeground}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 密码框沿用文本框的统一样式（此前无全局样式，随主题切换会掉色） -->
    <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource InputForeground}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource InputFocusBorder}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 富文本框（Markdown 渲染等）同样纳入全局配色 -->
    <Style TargetType="RichTextBox">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,3"/>
    </Style>
    <!-- 进度条 / 滑块 / 树形控件：此前无全局样式，深色主题下会出现系统色掉色 -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource ProgressBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource ProgressForeground}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <!-- P13 底栏迷你进度条（方案 02）：胶囊轨道 + hover 显形拖柄。
         拖柄常态不显示，鼠标移入才淡入；点击轨道任意位置即可跳转。
         用法 Style="{StaticResource MiniSeekBarStyle}"；色值一律走主题 key。 -->
    <Style x:Key="MiniSeekBarStyle" TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="TrackRoot" Background="Transparent" Height="16" SnapsToDevicePixels="True">
                        <Border Height="6" CornerRadius="3" VerticalAlignment="Center"
                                Background="{DynamicResource ProgressBackground}"/>
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" CornerRadius="3"
                                                    Background="{DynamicResource AccentBrush}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" Background="Transparent"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="SeekThumb" Width="12" Height="12" Opacity="0" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="12" Height="12" SnapsToDevicePixels="True"
                                                     Fill="{DynamicResource AccentBrush}"
                                                     Stroke="{DynamicResource WindowBackground}" StrokeThickness="1.5"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SeekThumb"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SeekThumb"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TrackRoot" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="TreeView">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
    </Style>
    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
    </Style>
    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- 带占位提示的文本框（清单 2.6）：Tag 作为占位文案，仅在内容为空且未聚焦时显示。
         用法 Style="{StaticResource PlaceholderTextBoxStyle}" Tag="{theme:Loc xxx}" -->
    <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            <TextBlock x:Name="PART_Hint" Text="{TemplateBinding Tag}"
                                       Foreground="{DynamicResource SecondaryForeground}" Opacity="0.6"
                                       Margin="5,0,0,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PART_Hint" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="PART_Hint" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="RowBackground" Value="{DynamicResource InputBackground}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ControlBorder}"/>
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ControlBorder}"/>
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
    </Style>
    <!--
        ===== 列表项容器（ListBoxItem）=====
        WPF 默认模板的悬停/选中是**系统色瞬变**，暗色主题下尤其突兀。
        这里给出与全局控件同语言的容器：圆角 6、悬停蒙版、选中用强调色 18% 淡底，
        两者都走 opacity 过渡（对齐 HTML 列表项的 transition:.12s）。
        注意 HorizontalContentAlignment=Stretch：默认的 Left 会让整行内容不撑满，
        表格化列表（音乐播放列表）会因此错位。
    -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent"/>
                        <Border x:Name="HoverMask" CornerRadius="6" IsHitTestVisible="False" Opacity="0"
                                Background="{DynamicResource ControlHoverBackground}"/>
                        <Border x:Name="SelMask" CornerRadius="6" IsHitTestVisible="False" Opacity="0"
                                Background="{DynamicResource AccentBrush}"/>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverMask"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverMask"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelMask" Property="Opacity" Value="0.18"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelMask"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.18" Duration="0:0:0.15"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="SelMask"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.12"
                                                         EasingFunction="{StaticResource MotionEase}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
