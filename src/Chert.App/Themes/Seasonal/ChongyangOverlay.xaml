<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    =========================================================================
      重阳节节日特效叠加层（第一期）
      —— 由 SeasonalThemeManager 挂载到 Application.Resources.MergedDictionaries 末尾，
         作为「置顶半透明特效层」叠加于界面之上，不整体换肤、不切换主题。

      设计原则与 MidAutumnOverlay 一致：
        1. 只覆盖「颜色级」资源，不碰任何控件 Style / Template / 布局；
        2. 色值在 Light / Dark 两种底上都可读协调；
        3. 选用半透明 alpha，保留底层主题纹理，营造「叠加」而非「替换」的观感。

      配色取自重阳节意象：菊橙 / 暖金 / 枫红 / 秋褐 / 奶白，呼应网页端橙黄花瓣。
    =========================================================================
    -->

    <!-- ===== 重阳色板：菊橙 / 暖金 / 枫红 / 秋褐 / 奶白 ===== -->
    <Color x:Key="ChongyangChrysanthemum">#E8943A</Color>
    <Color x:Key="ChongyangGold">#F0A93B</Color>
    <Color x:Key="ChongyangMaple">#C75B2E</Color>
    <Color x:Key="ChongyangBrown">#3A2A20</Color>
    <Color x:Key="ChongyangCream">#FFF3E0</Color>

    <!-- ===== 强调色：菊橙 ===== -->
    <SolidColorBrush x:Key="AccentBrush" Color="#E8943A"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D17E28"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#2A1A0E"/>
    <SolidColorBrush x:Key="ProgressForeground" Color="#E8943A"/>

    <!-- ===== 按钮：菊橙主调 ===== -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#E8943A"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#D17E28"/>

    <!-- ===== 标题栏：秋褐（可被标签主题覆盖，属预期行为） ===== -->
    <SolidColorBrush x:Key="TitleBarBrush" Color="#3A2A20"/>

    <!-- ===== 卡片交互描边：菊橙微光 ===== -->
    <SolidColorBrush x:Key="CardBorderHover" Color="#CCE8943A"/>

    <!-- ===== 四色索引贴：重阳配色 =====
         Tab*Brush 经 Application.FindResource 取值后赋给 SolidColorBrush.Color，
         因此支持 alpha，半透明可生效。 -->
    <SolidColorBrush x:Key="TabGameBrush" Color="#CCBF6B3A"/>
    <SolidColorBrush x:Key="TabGameDimBrush" Color="#A6955430"/>
    <SolidColorBrush x:Key="TabGameActiveBrush" Color="#CCD98A3F"/>
    <SolidColorBrush x:Key="TabGameUnderlineBrush" Color="#FFFFF3E0"/>

    <SolidColorBrush x:Key="TabDownloadBrush" Color="#CC9A7B4E"/>
    <SolidColorBrush x:Key="TabDownloadDimBrush" Color="#A6786340"/>
    <SolidColorBrush x:Key="TabDownloadActiveBrush" Color="#CCB5894F"/>
    <SolidColorBrush x:Key="TabDownloadUnderlineBrush" Color="#FFFFF3E0"/>

    <SolidColorBrush x:Key="TabToolboxBrush" Color="#CCE8943A"/>
    <SolidColorBrush x:Key="TabToolboxDimBrush" Color="#A6B06F28"/>
    <SolidColorBrush x:Key="TabToolboxActiveBrush" Color="#CCF2A94E"/>
    <SolidColorBrush x:Key="TabToolboxUnderlineBrush" Color="#FFFFF3E0"/>

    <SolidColorBrush x:Key="TabSettingsBrush" Color="#CC5A4530"/>
    <SolidColorBrush x:Key="TabSettingsDimBrush" Color="#A6483A26"/>
    <SolidColorBrush x:Key="TabSettingsActiveBrush" Color="#CC6E5538"/>
    <SolidColorBrush x:Key="TabSettingsUnderlineBrush" Color="#FFFFF3E0"/>

    <!-- ===== 装饰资源：供后续「节日置顶装饰 / 角标」直接使用 ===== -->
    <SolidColorBrush x:Key="SeasonalOverlayBrush" Color="#1F5A3A24"/>
    <SolidColorBrush x:Key="SeasonalCornerBadgeBrush" Color="#CCE8943A"/>
    <SolidColorBrush x:Key="SeasonalCornerBadgeForeground" Color="#2A1A0E"/>

</ResourceDictionary>
