<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====== Light Theme ====== -->

    <!-- Window / Control backgrounds -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#F0F0F0"/>

    <!-- 卡片（规格 1.4：圆角阴影；半透明玻璃质感，随亮/暗主题切换） -->
    <SolidColorBrush x:Key="CardBackground" Color="#E6FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderHover" Color="#2563EB"/>
    <!-- 开关轨道（关闭态） -->
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#D1D5DB"/>

    <!-- Foreground -->
    <SolidColorBrush x:Key="PrimaryForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SecondaryForeground" Color="#4B5563"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#2563EB"/>
    <SolidColorBrush x:Key="StatusForeground" Color="#4B5563"/>

    <!-- 标题栏前景（窗口控制图标 / 标题文字）：亮色主题下标题栏偏亮，用近黑，保证对比度 -->
    <SolidColorBrush x:Key="TitleBarForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TitleBarOverlayForeground" Color="#26000000"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626"/>

    <!-- ListView -->
    <SolidColorBrush x:Key="ListViewBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ListViewHeaderBackground" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="ListViewBorder" Color="#D1D5DB"/>

    <!-- TabControl -->
    <SolidColorBrush x:Key="TabBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="TabItemBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TabItemSelectedBackground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="TabItemHoverBackground" Color="#EBEBEB"/>

    <!-- Button -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#2563EB"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="ButtonDisabledBackground" Color="#D1D5DB"/>

    <!-- TextBox / ComboBox -->
    <SolidColorBrush x:Key="InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="InputBorder" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="InputFocusBorder" Color="#2563EB"/>

    <!-- Progress -->
    <SolidColorBrush x:Key="ProgressBackground" Color="#D1D5DB"/>
    <SolidColorBrush x:Key="ProgressForeground" Color="#2563EB"/>

</ResourceDictionary>
