<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        清单 #16：简约毛玻璃（暗色版）。
        对照稿：design/chert_layout.html 的「简约布局（Minimal Layout）」。

        设计稿是中性深色半透明玻璃，与经典/安卓布局**共用同一套配色**，
        仅把「面板表面」换成半透明层、边框改为白 8% 细边，并开启毛玻璃虚化：
          · 窗口底   rgba(15,17,21,.72)   → #B80F1115
          · 面板     rgba(26,29,36,.45)   → #731A1D24
          · 标题/状态栏 rgba(26,29,36,.55) → #8C1A1D24
          · 侧栏/列表 rgba(26,29,36,.40)   → #661A1D24
          · 细边/悬停 白 8%               → #14FFFFFF
          · 强调色   --accent 蓝 #3B82F6  → #FF3B82F6
          · 前景     --fg #FFFFFF / --fg2 #C8CDD6
        因此本字典去掉旧的青色科技风（#4DD0E1 / #0E1620），全部取值回到设计稿中性玻璃。
    -->

    <!-- 背景 -->
    <SolidColorBrush x:Key="WindowBackground" Color="#B80F1115"/>
    <SolidColorBrush x:Key="CardBackground" Color="#731A1D24"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#731A1D24"/>
    <SolidColorBrush x:Key="ListViewBackground" Color="#661A1D24"/>

    <!-- 分割线：白 8% 细边 -->
    <SolidColorBrush x:Key="ControlBorder" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="ListViewBorder" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="InputBorder" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="InputFocusBorder" Color="#FF3B82F6"/>

    <!-- 交互态 -->
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderHover" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#FF2B6FE0"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ButtonDisabledBackground" Color="#2A2A2F3A"/>

    <!-- 强调色：设计稿 --accent 蓝 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF2B6FE0"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFFFF"/>

    <!-- 前景 -->
    <SolidColorBrush x:Key="PrimaryForeground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SecondaryForeground" Color="#FFC8CDD6"/>
    <SolidColorBrush x:Key="StatusForeground" Color="#FFC8CDD6"/>

    <!-- 输入控件 -->
    <SolidColorBrush x:Key="InputBackground" Color="#661A1D24"/>
    <SolidColorBrush x:Key="InputForeground" Color="#FFE6E6E6"/>

    <!-- 进度条 / 开关 -->
    <SolidColorBrush x:Key="ProgressBackground" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="ProgressForeground" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#332A2F3A"/>

    <!-- 标签页 / 标题栏 / 状态栏 -->
    <SolidColorBrush x:Key="TabBackground" Color="#B80F1115"/>
    <SolidColorBrush x:Key="TabItemBackground" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="TabItemHoverBackground" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="TabItemSelectedBackground" Color="#332A2F3A"/>
    <SolidColorBrush x:Key="ListViewHeaderBackground" Color="#661A1D24"/>

    <!-- 危险色 -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FFE74C3C"/>

</ResourceDictionary>
