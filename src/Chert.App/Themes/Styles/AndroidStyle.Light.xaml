<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 清单 #15：简约安卓式（Material 配色，亮色版）。
         仅覆盖必要画刷键；未覆盖的键沿用 LightTheme.xaml，保证任何风格都能完整跑通。 -->

    <!-- 背景：Material 的浅灰底 -->
    <SolidColorBrush x:Key="WindowBackground" Color="#FFF4F6F8"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ListViewBackground" Color="#FFFFFFFF"/>

    <!-- 分割线：更细更淡 -->
    <SolidColorBrush x:Key="ControlBorder" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="ListViewBorder" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="InputBorder" Color="#FFBDBDBD"/>
    <SolidColorBrush x:Key="InputFocusBorder" Color="#FF6750A4"/>

    <!-- 交互态：Material 的 state layer -->
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#FFF0EDF4"/>
    <SolidColorBrush x:Key="CardBorderHover" Color="#FF6750A4"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#FFEADDFF"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#FFD9CBFA"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#FF1D192B"/>
    <SolidColorBrush x:Key="ButtonDisabledBackground" Color="#FFE7E0EC"/>

    <!-- 强调色：Material You 紫 -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF6750A4"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF7F67BE"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFFFF"/>

    <!-- 前景 -->
    <SolidColorBrush x:Key="PrimaryForeground" Color="#FF1D1B20"/>
    <SolidColorBrush x:Key="SecondaryForeground" Color="#FF625B71"/>
    <SolidColorBrush x:Key="StatusForeground" Color="#FF49454F"/>

    <!-- 输入控件：填充式文本框 -->
    <SolidColorBrush x:Key="InputBackground" Color="#FFE7E0EC"/>
    <SolidColorBrush x:Key="InputForeground" Color="#FF1D1B20"/>

    <!-- 进度条 / 开关 -->
    <SolidColorBrush x:Key="ProgressBackground" Color="#FFE7E0EC"/>
    <SolidColorBrush x:Key="ProgressForeground" Color="#FF6750A4"/>
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#FFCAC4D0"/>

    <!-- 标签页 / 标题栏 -->
    <SolidColorBrush x:Key="TabBackground" Color="#FFF4F6F8"/>
    <SolidColorBrush x:Key="TabItemBackground" Color="#FFF4F6F8"/>
    <SolidColorBrush x:Key="TabItemHoverBackground" Color="#FFE7E0EC"/>
    <SolidColorBrush x:Key="TabItemSelectedBackground" Color="#FFEADDFF"/>
    <SolidColorBrush x:Key="ListViewHeaderBackground" Color="#FFF4F6F8"/>

    <!-- 危险色 -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FFB3261E"/>

</ResourceDictionary>
