<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        清单 #15：简约安卓式（暗色版）。
        对照稿：design/chert_layout.html 的「安卓布局」。

        设计稿里安卓布局与经典布局**共用同一套配色**，差异只在布局形态：
          · 底部四色导航（64px，选中项用该标签自身的四色 + 12% 同色底）
          · 顶部横向子标签（42px，下载/工具箱/设置）
          · 标题栏用 --accent 蓝（而非随主标签变色）
          · 隐藏侧边栏，内容整宽
        因此本字典不再自造 Material You 配色，取值与 DarkTheme.xaml 一致：
          --win:#0F1115 / --ctrl:#1A1D24 / --ctrl-border:#2A2F3A / --ctrl-hover:#252830
          --accent:#3B82F6 / --accent-hover:#2B6FE0 / --danger:#E74C3C
          --input:#14161C / --input-border:#2A2F3A / --toggle-off:#3A3F4A
          --fg:#FFFFFF / --fg2:#C8CDD6
    -->

    <!-- 背景 -->
    <SolidColorBrush x:Key="WindowBackground" Color="#FF0F1115"/>
    <SolidColorBrush x:Key="CardBackground" Color="#B31A1D24"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#FF1A1D24"/>
    <SolidColorBrush x:Key="ListViewBackground" Color="#FF14161C"/>

    <!-- 分割线 -->
    <SolidColorBrush x:Key="ControlBorder" Color="#FF2A2F3A"/>
    <SolidColorBrush x:Key="ListViewBorder" Color="#FF2A2F3A"/>
    <SolidColorBrush x:Key="InputBorder" Color="#FF2A2F3A"/>
    <SolidColorBrush x:Key="InputFocusBorder" Color="#FF3B82F6"/>

    <!-- 交互态 -->
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#FF252830"/>
    <SolidColorBrush x:Key="CardBorderHover" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#FF2B6FE0"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="ButtonDisabledBackground" Color="#FF3A3F4A"/>

    <!-- 强调色：设计稿 --accent 蓝（底部导航选中项另取该标签四色） -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF2B6FE0"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFFFF"/>

    <!-- 前景 -->
    <SolidColorBrush x:Key="PrimaryForeground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SecondaryForeground" Color="#FFC8CDD6"/>
    <SolidColorBrush x:Key="StatusForeground" Color="#FFC8CDD6"/>

    <!-- 输入控件 -->
    <SolidColorBrush x:Key="InputBackground" Color="#FF14161C"/>
    <SolidColorBrush x:Key="InputForeground" Color="#FFE6E6E6"/>

    <!-- 进度条 / 开关 -->
    <SolidColorBrush x:Key="ProgressBackground" Color="#FF2A2F3A"/>
    <SolidColorBrush x:Key="ProgressForeground" Color="#FF3B82F6"/>
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#FF3A3F4A"/>

    <!-- 标签页 / 标题栏 / 状态栏 -->
    <SolidColorBrush x:Key="TabBackground" Color="#FF0F1115"/>
    <SolidColorBrush x:Key="TabItemBackground" Color="#FF1A1D24"/>
    <SolidColorBrush x:Key="TabItemHoverBackground" Color="#FF252830"/>
    <SolidColorBrush x:Key="TabItemSelectedBackground" Color="#FF252830"/>
    <SolidColorBrush x:Key="ListViewHeaderBackground" Color="#FF1E2128"/>
    <SolidColorBrush x:Key="TitleBarForeground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="TitleBarOverlayForeground" Color="#40FFFFFF"/>

    <!-- 危险色 -->
    <SolidColorBrush x:Key="DangerBrush" Color="#FFE74C3C"/>

</ResourceDictionary>
