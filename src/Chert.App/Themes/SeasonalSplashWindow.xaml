<Window x:Class="Chert.App.Themes.SeasonalSplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chert"
        Width="520" Height="260"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Opacity="0">

    <Border CornerRadius="14"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1"
            Padding="28">

        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="24" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="SeasonText"
                       Grid.Row="0"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryForeground}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="GreetingText"
                       Grid.Row="1"
                       Margin="0,14,0,0"
                       FontSize="14"
                       Foreground="{DynamicResource SecondaryForeground}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"/>

            <TextBlock x:Name="LauncherText"
                       Grid.Row="2"
                       FontSize="12"
                       Foreground="{DynamicResource SecondaryForeground}"
                       HorizontalAlignment="Center"
                       Opacity="0.75"/>
        </Grid>
    </Border>
</Window>
