<UserControl x:Class="Chert.App.Views.MusicPlayerView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"

             xmlns:conv="clr-namespace:Chert.App.Converters"
             xmlns:theme="clr-namespace:Chert.App.Themes">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVisibility"/>

        <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis"/>

    </UserControl.Resources>

    <Grid Margin="14">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- 音源切换 -->

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">

            <TextBlock Text="{theme:Loc music.m181}" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.8"/>

            <Button Content="{theme:Loc music.m182}" Command="{Binding SetSourceCommand}" CommandParameter="Local"

                    Padding="10,4" Margin="0,0,6,0"/>

            <!-- 在线音源（API 模式）：未启用时干脆不给入口，免得用户点进去必然失败 -->

            <Button Content="{theme:Loc music.source_api}" Command="{Binding SetSourceCommand}" CommandParameter="Online"

                    Padding="10,4" Margin="0,0,6,0"

                    Visibility="{Binding ApiEnabled, Converter={StaticResource BoolToVisibility}}"/>

            <Button Content="{theme:Loc music.m184}" Command="{Binding SetSourceCommand}" CommandParameter="McOst"

                    Padding="10,4" Margin="0,0,6,0"/>

            <!-- 本地客户端模式（规格 6.1）：总开关关闭时整个入口隐藏 -->

            <Button Content="{theme:Loc music.client_mode}" Command="{Binding SetSourceCommand}" CommandParameter="Client"

                    Padding="10,4"

                    Visibility="{Binding ClientModeAvailable, Converter={StaticResource BoolToVisibility}}"/>

        </StackPanel>



        <!-- 当前曲目 + 传输控制 -->

        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ControlBorder}"

                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10"

                Visibility="{Binding IsLocalClient, Converter={StaticResource InvBoolToVisibility}}">

            <StackPanel>

                <TextBlock FontSize="14" FontWeight="Bold" Text="{Binding CurrentTrackDisplay}" TextTrimming="CharacterEllipsis"/>

                <!-- bug #10：歌手 · 专辑 元数据（读不到则为空） -->

                <TextBlock FontSize="11" Opacity="0.7" Margin="0,1,0,2" TextTrimming="CharacterEllipsis"

                           Visibility="{Binding HasTrack, Converter={StaticResource BoolToVisibility}}">

                    <Run Text="{Binding CurrentTrack.Artist, Mode=OneWay}"/>

                    <Run Text=" · " Foreground="{DynamicResource PrimaryForeground}"/>

                    <Run Text="{Binding CurrentTrack.Album, Mode=OneWay}"/>

                </TextBlock>

                <TextBlock FontSize="11" Opacity="0.6" Text="{Binding StatusText}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>



                <!-- bug #10：进度条 -->

                <Grid Margin="0,0,0,8" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.8"/>

                    <Slider Grid.Column="1" x:Name="SeekBar" Minimum="0" Maximum="100"

                            Style="{StaticResource MiniSeekBarStyle}"

                            Value="{Binding ProgressRatio, Mode=OneWay}"

                            VerticalAlignment="Center" IsMoveToPointEnabled="True"/>

                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.8"/>

                </Grid>



                <StackPanel Orientation="Horizontal">

                    <Button Command="{Binding PreviousCommand}" Width="46" Height="40" Margin="0,0,8,0" Background="Transparent" BorderThickness="0">
                        <theme:PngIcon Token="previous" Size="16"/>
                    </Button>

                    <Button Command="{Binding PlayPauseCommand}" Width="54" Height="40"
                            Background="Transparent" BorderThickness="0" Margin="0,0,8,0">
                        <theme:PngIcon Size="18">
                            <theme:PngIcon.Style>
                                <Style TargetType="theme:PngIcon">
                                    <Setter Property="Token" Value="play"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Token" Value="pause"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </theme:PngIcon.Style>
                        </theme:PngIcon>
                    </Button>

                    <Button Command="{Binding NextCommand}" Width="46" Height="40" Margin="0,0,8,0" Background="Transparent" BorderThickness="0">
                        <theme:PngIcon Token="next" Size="16"/>
                    </Button>

                    <Button Command="{Binding SetModeCommand}" Width="46" Height="40"
                            ToolTip="{Binding Mode}" Margin="0,0,12,0" Background="Transparent" BorderThickness="0">
                        <Viewbox Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center">
                            <Path Fill="{DynamicResource PrimaryForeground}"
                                  Data="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z"/>
                        </Viewbox>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">

                        <theme:PngIcon Token="mic" Size="16" Margin="0,0,6,0" VerticalAlignment="Center"/>

                        <Slider Minimum="0" Maximum="100" Width="140" Value="{Binding Volume}"

                                Style="{StaticResource MiniSeekBarStyle}"

                                VerticalAlignment="Center"/>

                    </StackPanel>

                </StackPanel>

            </StackPanel>

        </Border>



        <!-- 歌词（规格实现项 4：行数随「歌词固定方式」变化；行切换淡入淡出 + 轻微上移） -->

        <Border Grid.Row="2" Margin="0,0,0,8" MinHeight="64" Padding="14,10" CornerRadius="8"

                Background="{DynamicResource CardBackground}"

                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"

                Visibility="{Binding HasLyric, Converter={StaticResource BoolToVisibility}}">

            <TextBlock x:Name="LyricBox" Text="{Binding LyricText}" FontSize="13" LineHeight="22"

                       Opacity="0.92" TextWrapping="Wrap" TextAlignment="Center"

                       VerticalAlignment="Center" HorizontalAlignment="Stretch"/>

        </Border>

        <!-- 无歌词时不显示歌词框（规格：静默隐藏，不弹错误提示） -->

        <TextBlock Grid.Row="2" Text="{theme:Loc music.set_lyric_pin_tip}" FontSize="11" Opacity="0.55"

                   TextAlignment="Center" Margin="0,0,0,8"

                   Visibility="{Binding HasLyric, Converter={StaticResource InvBoolToVisibility}}"/>

        <!-- 音源专属操作 -->

        <StackPanel Grid.Row="3" Margin="0,0,0,8"

                    Visibility="{Binding IsLocalClient, Converter={StaticResource InvBoolToVisibility}}">

            <!-- 本地 -->

            <StackPanel Orientation="Horizontal" Visibility="{Binding IsLocal, Converter={StaticResource BoolToVisibility}}">

                <Button Content="{theme:Loc music.m185}" Command="{Binding LoadLocalFolderCommand}"

                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"

                        Padding="10,4"/>

            </StackPanel>

            <!-- 在线音源（规格 MusicSourceMode.Api）：搜索、歌单、登录 -->

            <StackPanel Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}">

                <!-- 搜索行：回车等同于点「搜索」 -->

                <Grid Margin="0,0,0,6">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding OnlineKeyword, UpdateSourceTrigger=PropertyChanged}"

                             IsEnabled="{Binding OnlineIdle}" Padding="6,4" VerticalContentAlignment="Center"

                             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                             BorderBrush="{DynamicResource InputBorder}"

                             ToolTip="{theme:Loc music.api_keyword_tip}">

                        <TextBox.InputBindings>

                            <KeyBinding Key="Enter" Command="{Binding SearchOnlineCommand}"/>

                        </TextBox.InputBindings>

                    </TextBox>

                    <Button Grid.Column="1" Content="{theme:Loc music.api_search}" Command="{Binding SearchOnlineCommand}"

                            IsEnabled="{Binding OnlineIdle}" Margin="6,0,0,0" Padding="10,4"

                            Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>

                    <!-- 「我的歌单 / 登录」只有支持登录的数据源才出现 -->

                    <Button Grid.Column="2" Content="{theme:Loc music.api_my_playlists}" Command="{Binding RefreshMyPlaylistsCommand}"

                            Margin="6,0,0,0" Padding="10,4"

                            Visibility="{Binding CanOnlineLogin, Converter={StaticResource BoolToVisibility}}"/>

                    <Button Grid.Column="3" Content="{theme:Loc music.api_login}" Command="{Binding StartApiLoginCommand}"

                            Margin="6,0,0,0" Padding="10,4"

                            Visibility="{Binding CanOnlineLogin, Converter={StaticResource BoolToVisibility}}"/>

                    <Button Grid.Column="4" Content="{theme:Loc music.api_logout}" Command="{Binding ApiLogoutCommand}"

                            Margin="6,0,0,0" Padding="10,4"

                            Visibility="{Binding IsOnlineLoggedIn, Converter={StaticResource BoolToVisibility}}"/>

                </Grid>

                <!-- 账户 + 状态（歌单入口在下方，登录后才会出现） -->

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6"

                            Visibility="{Binding CanOnlineLogin, Converter={StaticResource BoolToVisibility}}">

                    <TextBlock Text="{theme:Loc music.api_account}" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.8"/>

                    <TextBlock Text="{Binding ApiAccountLabel}" VerticalAlignment="Center" Opacity="0.9"/>

                </StackPanel>

                <!-- 我的歌单：空集合时 ItemsControl 自然不占高度，无需额外显隐控制 -->

                <ItemsControl ItemsSource="{Binding MyPlaylists}" Margin="0,0,0,6">

                    <ItemsControl.ItemsPanel>

                        <ItemsPanelTemplate>

                            <WrapPanel/>

                        </ItemsPanelTemplate>

                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <Button Command="{Binding DataContext.ImportPlaylistCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                    CommandParameter="{Binding}" Margin="0,2,6,2" Padding="8,4"

                                    Background="Transparent" BorderThickness="0"

                                    Foreground="{DynamicResource InputForeground}"

                                    ToolTip="{theme:Loc music.api_my_playlists}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>

                                    <TextBlock Text="{Binding MetaText}" FontSize="11" Opacity="0.6" Margin="8,0,0,0"/>

                                </StackPanel>

                            </Button>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

                <!-- 手填歌单 ID（部分数据源没有「搜歌单」能力） -->

                <Grid Margin="0,0,0,6">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding PlaylistIdInput, UpdateSourceTrigger=PropertyChanged}"

                             Padding="6,4" VerticalContentAlignment="Center"

                             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                             BorderBrush="{DynamicResource InputBorder}"

                             ToolTip="{theme:Loc music.api_playlist_id}"/>

                    <Button Grid.Column="1" Content="{theme:Loc music.api_import}" Command="{Binding ImportPlaylistCommand}"

                            Margin="6,0,0,0" Padding="10,4"/>

                </Grid>

                <TextBlock Text="{Binding OnlineStatus}" FontSize="11" Opacity="0.75" Margin="0,0,0,2"

                           Visibility="{Binding OnlineStatus, Converter={StaticResource NonEmptyToVis}}"/>

            </StackPanel>

            <!-- MC 原声 -->

            <StackPanel Orientation="Horizontal" Visibility="{Binding IsMcOst, Converter={StaticResource BoolToVisibility}}">

                <Button Content="{theme:Loc music.m188}" Command="{Binding ScanMcOstCommand}"

                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="10,4"/>

                <TextBlock Text="{Binding McOstStatus}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8"/>

            </StackPanel>

        </StackPanel>



        <!-- 列表 -->

        <Grid Grid.Row="4" Visibility="{Binding IsLocalClient, Converter={StaticResource InvBoolToVisibility}}">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <!-- 列头（对齐 problem/建议的音乐列表样式：资源管理器式详细信息表头）。
                 列宽与行内表格逐列一致；右侧留出滚动条宽度，避免表头与数据行错位。 -->

            <Border Grid.Row="0" Visibility="{Binding IsMcOst, Converter={StaticResource InvBoolToVisibility}}"

                    Background="{DynamicResource ListViewHeaderBackground}"

                    BorderBrush="{DynamicResource ListViewBorder}" BorderThickness="0,0,0,1"

                    Margin="2,0,20,2" Padding="0" CornerRadius="4">

                <Grid Margin="8,4">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.4*"/>

                        <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="64"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{theme:Loc music.col_name}" FontSize="12" FontWeight="SemiBold"

                               Foreground="{DynamicResource SecondaryForeground}"/>

                    <TextBlock Grid.Column="1" Text="{theme:Loc music.col_title}" FontSize="12" FontWeight="SemiBold"

                               Foreground="{DynamicResource SecondaryForeground}"/>

                    <TextBlock Grid.Column="2" Text="{theme:Loc music.col_artist}" FontSize="12" FontWeight="SemiBold"

                               Foreground="{DynamicResource SecondaryForeground}"/>

                    <TextBlock Grid.Column="3" Text="{theme:Loc music.col_album}" FontSize="12" FontWeight="SemiBold"

                               Foreground="{DynamicResource SecondaryForeground}"/>

                    <TextBlock Grid.Column="4" Text="{theme:Loc music.col_duration}" FontSize="12" FontWeight="SemiBold"

                               Foreground="{DynamicResource SecondaryForeground}"/>

                </Grid>

            </Border>

            <!-- 本地 / 在线：统一播放列表。
                 滚动结构：把「自带滚动条 + 最大高度」直接交给 ListBox 自己管。
                 不要写成「外层 ScrollViewer 包住 ListBox、同时禁用 ListBox 自身滚动」——
                 ListBox 在这种嵌套里会吃掉鼠标滚轮事件，表现就是列表滚不动（用户反馈）。 -->

            <ListBox Grid.Row="1" Visibility="{Binding IsMcOst, Converter={StaticResource InvBoolToVisibility}}"

                     ItemsSource="{Binding Tracks}"

                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                     BorderBrush="{DynamicResource InputBorder}"

                     HorizontalContentAlignment="Stretch"

                     MaxHeight="360"

                     ScrollViewer.VerticalScrollBarVisibility="Auto"

                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <DockPanel>

                            <Button DockPanel.Dock="Right" Width="32" Padding="0"
                                    Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" ToolTip="{theme:Loc music.m189}"
                                    Background="Transparent" BorderThickness="0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right">
                                <theme:PngIcon Token="close" Size="12"/>
                            </Button>

                            <Button Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"

                                    CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="0,4"

                                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InputForeground}">

                                <!-- 表格列：名称 / 标题 / 艺术家 / 专辑 / 时长（列宽与下方表头逐列一致） -->

                                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.4*"/>

                        <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="64"/>

                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="2" Text="{Binding Artist}" TextTrimming="CharacterEllipsis"

                                               Foreground="{DynamicResource SecondaryForeground}"/>

                                    <TextBlock Grid.Column="3" Text="{Binding Album}" TextTrimming="CharacterEllipsis"

                                               Foreground="{DynamicResource SecondaryForeground}"/>

                                    <TextBlock Grid.Column="4" Text="{Binding DurationText}"

                                               Foreground="{DynamicResource SecondaryForeground}"/>

                                </Grid>

                            </Button>

                        </DockPanel>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>



            <!-- MC 原声：按分类分组 -->

            <ScrollViewer Grid.Row="1" Visibility="{Binding IsMcOst, Converter={StaticResource BoolToVisibility}}"

                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"

                          MaxHeight="360">

                <ItemsControl ItemsSource="{Binding McOstGroups}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <StackPanel Margin="0,0,0,10">

                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Margin="0,4,0,4" Opacity="0.85"/>

                                <ItemsControl ItemsSource="{Binding Tracks}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                        <Button Content="{Binding Title}"

                                                Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                                CommandParameter="{Binding}" HorizontalContentAlignment="Left" Padding="6,4"

                                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InputForeground}"/>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

            <!-- 在线搜索结果（点一条即点播：先换直链再加入播放列表，列宽与播放列表一致） -->

            <TextBlock Grid.Row="2" Text="{theme:Loc music.api_results}" FontSize="12" FontWeight="SemiBold"

                       Foreground="{DynamicResource SecondaryForeground}" Margin="8,10,0,2"

                       Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}"/>

            <ListBox Grid.Row="3" Visibility="{Binding IsOnline, Converter={StaticResource BoolToVisibility}}"

                     ItemsSource="{Binding OnlineResults}"

                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                     BorderBrush="{DynamicResource InputBorder}"

                     HorizontalContentAlignment="Stretch"

                     MaxHeight="300"

                     ScrollViewer.VerticalScrollBarVisibility="Auto"

                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <Button Command="{Binding DataContext.PlayOnlineTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"

                                CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="0,4"

                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InputForeground}">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.4*"/>

                                    <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="64"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Column="1" Text="{Binding Artist}" TextTrimming="CharacterEllipsis"

                                           Foreground="{DynamicResource SecondaryForeground}"/>

                                <TextBlock Grid.Column="2" Text="{Binding Album}" TextTrimming="CharacterEllipsis"

                                           Foreground="{DynamicResource SecondaryForeground}"/>

                                <TextBlock Grid.Column="3" Text="{Binding MetaText}" TextTrimming="CharacterEllipsis"

                                           Foreground="{DynamicResource SecondaryForeground}"/>

                                <TextBlock Grid.Column="4" Text="{Binding DurationText}"

                                           Foreground="{DynamicResource SecondaryForeground}"/>

                            </Grid>

                        </Button>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </Grid>

        <!-- 本地客户端模式整页（规格 6.1：空白页 + 状态说明卡片 + 客户端选择/启动 + 歌词叠加层）
             用 Grid.RowSpan="3" 覆盖上面三行，故这三行在 Client 模式下折叠。 -->

        <Grid Grid.Row="1" Grid.RowSpan="4"

              Visibility="{Binding IsLocalClient, Converter={StaticResource BoolToVisibility}}">

            <Grid.RowDefinitions>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <!-- 状态说明卡片 -->

            <Border Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"

                    MaxWidth="520" Background="{DynamicResource CardBackground}"

                    BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="10" Padding="24">

                <StackPanel>

                    <TextBlock Text="{theme:Loc music.client_title}" FontSize="15" FontWeight="Bold"

                               HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <TextBlock Text="{theme:Loc music.client_desc}" FontSize="12" Opacity="0.8"

                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding ClientStatus}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"

                               TextAlignment="Center" Margin="0,0,0,4"/>

                    <TextBlock Text="{Binding ClientRunning}" FontSize="11" Opacity="0.6" TextWrapping="Wrap"

                               TextAlignment="Center" Margin="0,0,0,14"

                               Visibility="{Binding ClientRunning, Converter={StaticResource NonEmptyToVis}}"/>

                    <!-- 客户端程序选择 -->

                    <Grid Margin="0,0,0,12">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"

                                   FontSize="12" Opacity="0.85" TextTrimming="CharacterEllipsis"

                                   Text="{Binding ClientDisplayName, FallbackValue=''}"/>

                        <Button Grid.Column="1" Content="{theme:Loc music.client_choose}"

                                Command="{Binding BrowseClientCommand}" Padding="10,4" Margin="0,0,8,0"/>

                        <Button Grid.Column="2" Content="{theme:Loc music.client_launch}"

                                Command="{Binding LaunchClientCommand}" Padding="10,4"

                                Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>

                    </Grid>

                    <!-- 歌词叠加层（规格实现项 4：行数随「歌词固定方式」变化） -->

                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ControlBorder}"

                            BorderThickness="1" CornerRadius="8" Padding="14,10" MinHeight="72"

                            Visibility="{Binding HasLyric, Converter={StaticResource BoolToVisibility}}">

                            <TextBlock x:Name="LyricBoxClient" Text="{Binding LyricText}" FontSize="13" LineHeight="22"

                                       Opacity="0.92" TextWrapping="Wrap" TextAlignment="Center"

                                       VerticalAlignment="Center" HorizontalAlignment="Stretch"/>

                    </Border>

                    <!-- 无歌词时不显示歌词框，改为一行提示（规格：静默隐藏，不弹错误） -->

                    <TextBlock Text="{theme:Loc music.client_lyric_hint}" FontSize="11" Opacity="0.55"

                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"

                               Visibility="{Binding HasLyric, Converter={StaticResource InvBoolToVisibility}}"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>

