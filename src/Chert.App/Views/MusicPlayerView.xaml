<UserControl x:Class="Chert.App.Views.MusicPlayerView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"

             xmlns:conv="clr-namespace:Chert.App.Converters"
             xmlns:theme="clr-namespace:Chert.App.Themes">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVisibility"/>

    </UserControl.Resources>

    <Grid Margin="14">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- 音源切换 -->

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">

            <TextBlock Text="{theme:Loc music.m181}" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.8"/>

            <Button Content="{theme:Loc music.m182}" Command="{Binding SetSourceCommand}" CommandParameter="Local"

                    Padding="10,4" Margin="0,0,6,0"/>

            <!-- 流媒体音源入口本期屏蔽（清单 #70，待评估后再启用） -->

            <Button Content="{theme:Loc music.m184}" Command="{Binding SetSourceCommand}" CommandParameter="McOst"

                    Padding="10,4"/>

        </StackPanel>



        <!-- 当前曲目 + 传输控制 -->

        <Border Grid.Row="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ControlBorder}"

                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">

            <StackPanel>

                <TextBlock FontSize="14" FontWeight="Bold" Text="{Binding CurrentTrackDisplay}" TextTrimming="CharacterEllipsis"/>

                <!-- bug #10：歌手 · 专辑 元数据（读不到则为空） -->

                <TextBlock FontSize="11" Opacity="0.7" Margin="0,1,0,2" TextTrimming="CharacterEllipsis"

                           Visibility="{Binding HasTrack, Converter={StaticResource BoolToVisibility}}">

                    <Run Text="{Binding CurrentTrack.Artist, Mode=OneWay}"/>

                    <Run Text=" · " Foreground="{DynamicResource PrimaryForeground}"/>

                    <Run Text="{Binding CurrentTrack.Album, Mode=OneWay}"/>

                </TextBlock>

                <TextBlock FontSize="11" Opacity="0.6" Text="{Binding StatusText}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>



                <!-- bug #10：进度条 -->

                <Grid Margin="0,0,0,8" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVisibility}}">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" Opacity="0.8"/>

                    <Slider Grid.Column="1" x:Name="SeekBar" Minimum="0" Maximum="100"

                            Style="{StaticResource MiniSeekBarStyle}"

                            Value="{Binding ProgressRatio, Mode=OneWay}"

                            VerticalAlignment="Center" IsMoveToPointEnabled="True"/>

                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.8"/>

                </Grid>



                <StackPanel Orientation="Horizontal">

                    <Button Content="⏮" Command="{Binding PreviousCommand}" Width="46" Height="40" FontSize="16" Margin="0,0,8,0"/>

                    <Button Command="{Binding PlayPauseCommand}" Width="54" Height="40" FontSize="17"

                            Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Margin="0,0,8,0">

                        <Button.Style>

                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">

                                <Setter Property="Content" Value="▶"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">

                                        <Setter Property="Content" Value="⏸"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>

                    <Button Content="⏭" Command="{Binding NextCommand}" Width="46" Height="40" FontSize="16" Margin="0,0,8,0"/>

                    <Button Content="🔁" Command="{Binding SetModeCommand}" Width="46" Height="40" FontSize="15"

                            ToolTip="{Binding Mode}" Margin="0,0,12,0"/>

                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">

                        <TextBlock Text="🔊" VerticalAlignment="Center" Margin="0,0,6,0"/>

                        <Slider Minimum="0" Maximum="100" Width="140" Value="{Binding Volume}"

                                Style="{StaticResource MiniSeekBarStyle}"

                                VerticalAlignment="Center"/>

                    </StackPanel>

                </StackPanel>

            </StackPanel>

        </Border>



        <!-- 音源专属操作 -->

        <StackPanel Grid.Row="2" Margin="0,0,0,8">

            <!-- 本地 -->

            <StackPanel Orientation="Horizontal" Visibility="{Binding IsLocal, Converter={StaticResource BoolToVisibility}}">

                <Button Content="{theme:Loc music.m185}" Command="{Binding LoadLocalFolderCommand}"

                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"

                        Padding="10,4"/>

            </StackPanel>

            <!-- 在线流媒体（清单 #70）：本期屏蔽，相关逻辑保留在 MusicPlayerViewModel 内待评估后启用 -->

            <!-- MC 原声 -->

            <StackPanel Orientation="Horizontal" Visibility="{Binding IsMcOst, Converter={StaticResource BoolToVisibility}}">

                <Button Content="{theme:Loc music.m188}" Command="{Binding ScanMcOstCommand}"

                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="10,4"/>

                <TextBlock Text="{Binding McOstStatus}" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8"/>

            </StackPanel>

        </StackPanel>



        <!-- 列表 -->

        <Grid Grid.Row="3">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <!-- 列头（对齐 problem/建议的音乐列表样式：资源管理器式详细信息表头）。
                 列宽与行内表格逐列一致；右侧留出滚动条宽度，避免表头与数据行错位。 -->

            <Border Grid.Row="0" Visibility="{Binding IsMcOst, Converter={StaticResource InvBoolToVisibility}}"

                    Background="{DynamicResource ListViewHeaderBackground}"

                    BorderBrush="{DynamicResource ListViewBorder}" BorderThickness="0,0,0,1"

                    Margin="2,0,20,2" Padding="0" CornerRadius="4">

                <Grid Margin="8,4">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.4*"/>

                        <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="64"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{theme:Loc music.col_name}" FontSize="12" FontWeight="SemiBold"

                               Foreground="{DynamicResource SecondaryForeground}"/>

                    <TextBlock Grid.Column="1" Text="{theme:Loc music.col_title}" FontSize="12" FontWeight="SemiBold"

                               Foreground="{DynamicResource SecondaryForeground}"/>

                    <TextBlock Grid.Column="2" Text="{theme:Loc music.col_artist}" FontSize="12" FontWeight="SemiBold"

                               Foreground="{DynamicResource SecondaryForeground}"/>

                    <TextBlock Grid.Column="3" Text="{theme:Loc music.col_album}" FontSize="12" FontWeight="SemiBold"

                               Foreground="{DynamicResource SecondaryForeground}"/>

                    <TextBlock Grid.Column="4" Text="{theme:Loc music.col_duration}" FontSize="12" FontWeight="SemiBold"

                               Foreground="{DynamicResource SecondaryForeground}"/>

                </Grid>

            </Border>

            <!-- 本地 / 在线：统一播放列表。
                 滚动结构：把「自带滚动条 + 最大高度」直接交给 ListBox 自己管。
                 不要写成「外层 ScrollViewer 包住 ListBox、同时禁用 ListBox 自身滚动」——
                 ListBox 在这种嵌套里会吃掉鼠标滚轮事件，表现就是列表滚不动（用户反馈）。 -->

            <ListBox Grid.Row="1" Visibility="{Binding IsMcOst, Converter={StaticResource InvBoolToVisibility}}"

                     ItemsSource="{Binding Tracks}"

                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                     BorderBrush="{DynamicResource InputBorder}"

                     HorizontalContentAlignment="Stretch"

                     MaxHeight="360"

                     ScrollViewer.VerticalScrollBarVisibility="Auto"

                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <DockPanel>

                            <Button DockPanel.Dock="Right" Content="✕" Width="32" Padding="0"

                                    Command="{Binding DataContext.RemoveTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"

                                    CommandParameter="{Binding}" ToolTip="{theme:Loc music.m189}"

                                    Background="Transparent" BorderThickness="0"

                                    Foreground="{DynamicResource SecondaryForeground}" VerticalAlignment="Center"

                                    HorizontalAlignment="Right"/>

                            <Button Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"

                                    CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="0,4"

                                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InputForeground}">

                                <!-- 表格列：名称 / 标题 / 艺术家 / 专辑 / 时长（列宽与下方表头逐列一致） -->

                                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.4*"/>

                        <ColumnDefinition Width="1.4*"/><ColumnDefinition Width="64"/>

                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>

                                    <TextBlock Grid.Column="2" Text="{Binding Artist}" TextTrimming="CharacterEllipsis"

                                               Foreground="{DynamicResource SecondaryForeground}"/>

                                    <TextBlock Grid.Column="3" Text="{Binding Album}" TextTrimming="CharacterEllipsis"

                                               Foreground="{DynamicResource SecondaryForeground}"/>

                                    <TextBlock Grid.Column="4" Text="{Binding DurationText}"

                                               Foreground="{DynamicResource SecondaryForeground}"/>

                                </Grid>

                            </Button>

                        </DockPanel>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>



            <!-- MC 原声：按分类分组 -->

            <ScrollViewer Grid.Row="1" Visibility="{Binding IsMcOst, Converter={StaticResource BoolToVisibility}}"

                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"

                          MaxHeight="360">

                <ItemsControl ItemsSource="{Binding McOstGroups}">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate>

                            <StackPanel Margin="0,0,0,10">

                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Margin="0,4,0,4" Opacity="0.85"/>

                                <ItemsControl ItemsSource="{Binding Tracks}">

                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                        <Button Content="{Binding Title}"

                                                Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                                CommandParameter="{Binding}" HorizontalContentAlignment="Left" Padding="6,4"

                                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InputForeground}"/>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>

                            </StackPanel>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>

    </Grid>

</UserControl>

