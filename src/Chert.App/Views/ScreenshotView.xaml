<UserControl x:Class="Chert.App.Views.ScreenshotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chert.App.ViewModels">
    <UserControl.DataContext>
        <vm:ScreenshotViewModel/>
    </UserControl.DataContext>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="刷新" Command="{Binding RefreshCommand}" Width="70" Padding="0,2"/>
            <Button Content="打包分享" Command="{Binding PackageCommand}" Width="90" Padding="0,2" Margin="8,0,0,0"/>
            <Button Content="删除选中" Command="{Binding DeleteCommand}" Width="90" Padding="0,2" Margin="8,0,0,0"/>
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Shots}"
                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                 BorderBrush="{DynamicResource InputBorder}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="0,0,12,0"/>
                            <TextBlock Text="{Binding SizeBytes, StringFormat={}{0:N0} B}"
                                       Foreground="{DynamicResource SecondaryForeground}" FontSize="11"/>
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource StatusForeground}" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
