<UserControl x:Class="Chert.App.Views.AfkWorkflowView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:theme="clr-namespace:Chert.App.Themes">

    <UserControl.DataContext>

        <vm:AfkWorkflowViewModel/>

    </UserControl.DataContext>

    <UserControl.Resources>

        <Style x:Key="ActionTypeButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">

            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>

            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>

            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Padding" Value="8,6"/>

        </Style>

    </UserControl.Resources>



    <Grid>

        <Grid Margin="12">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="*"/>

            <ColumnDefinition Width="220"/>

        </Grid.ColumnDefinitions>



        <!-- 左侧：动作列表 + 编辑 -->

        <Grid Grid.Column="0" Margin="0,0,8,0">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>



            <WrapPanel Grid.Row="0" Margin="0,0,0,6">

                <Button Content="{theme:Loc afk.add_action}" Command="{Binding AddActionCommand}" Width="90" Padding="0,4"/>

                <Button Content="{theme:Loc btn.delete}" Command="{Binding RemoveActionCommand}" Width="60" Padding="0,4" Margin="4,0,0,0"/>

                <Button Content="↑" Command="{Binding MoveUpCommand}" Width="36" Padding="0,2" Margin="4,0,0,0"

                        FontWeight="Bold"/>

                <Button Content="↓" Command="{Binding MoveDownCommand}" Width="36" Padding="0,2" Margin="2,0,0,0"

                        FontWeight="Bold"/>

            </WrapPanel>



            <ListBox Grid.Row="1" ItemsSource="{Binding Actions}" SelectedItem="{Binding SelectedAction}"

                     Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"

                     HorizontalContentAlignment="Stretch">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <Grid Margin="0,2">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="Auto"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" CornerRadius="3" Padding="5,1" VerticalAlignment="Center"

                                    Background="{DynamicResource AccentBrush}" Margin="0,0,8,0">

                                <TextBlock Text="{Binding ActionType}" FontSize="10" Foreground="White"

                                           FontWeight="Bold" Width="14" TextAlignment="Center"/>

                            </Border>

                            <TextBlock Grid.Column="1" Text="{Binding Display}" FontSize="12"

                                       VerticalAlignment="Center" Foreground="{DynamicResource PrimaryForeground}"/>

                        </Grid>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>



            <!-- 编辑选中动作 -->

            <Border Grid.Row="2" Background="{DynamicResource ControlBackground}" CornerRadius="6"

                    Padding="10,8" Margin="0,6,0,0">

                <StackPanel Visibility="{Binding SelectedAction, Converter={StaticResource BoolToVis}}">

                    <WrapPanel>

                        <TextBlock Text="{theme:Loc afk.action_type}" VerticalAlignment="Center" Width="70"

                                   Foreground="{DynamicResource SecondaryForeground}"/>

                        <!-- bug #13：此前用 SelectedItem 绑定，选中值被赋成 ComboBoxItem 本身而非 Tag，

                             导致无论选哪种动作类型，生成/保存的都还是默认的帧率限制 (F)。 -->

                        <ComboBox SelectedValue="{Binding SelectedAction.ActionType, Mode=TwoWay}" SelectedValuePath="Tag" Width="140">

                            <ComboBoxItem Content="{theme:Loc afk.type_f}" Tag="F"/>

                            <ComboBoxItem Content="{theme:Loc afk.type_d}" Tag="D"/>

                            <ComboBoxItem Content="{theme:Loc afk.type_l}" Tag="L"/>

                            <ComboBoxItem Content="{theme:Loc afk.type_k}" Tag="K"/>

                            <ComboBoxItem Content="{theme:Loc afk.type_c}" Tag="C"/>

                            <ComboBoxItem Content="{theme:Loc afk.type_r}" Tag="R"/>

                            <ComboBoxItem Content="{theme:Loc afk.type_m}" Tag="M"/>

                            <ComboBoxItem Content="{theme:Loc afk.type_s}" Tag="S"/>

                            <ComboBoxItem Content="{theme:Loc afk.type_t}" Tag="T"/>

                            <ComboBoxItem Content="{theme:Loc afk.type_g}" Tag="G"/>

                            <ComboBoxItem Content="{theme:Loc afk.type_u}" Tag="U"/>

                            <ComboBoxItem Content="{theme:Loc afk.type_j}" Tag="J"/>

                            <ComboBoxItem Content="{theme:Loc afk.type_e}" Tag="E"/>

                            <ComboBoxItem Content="{theme:Loc afk.type_loop}" Tag="*"/>

                        </ComboBox>

                    </WrapPanel>

                    <WrapPanel Margin="0,6,0,0">

                        <TextBlock Text="{theme:Loc afk.param}" VerticalAlignment="Center" Width="70"

                                   Foreground="{DynamicResource SecondaryForeground}"/>

                        <TextBox Text="{Binding SelectedAction.Param, UpdateSourceTrigger=PropertyChanged}"

                                 Width="160" Padding="4,2"

                                 Background="{DynamicResource InputBackground}"

                                 Foreground="{DynamicResource InputForeground}"

                                 BorderBrush="{DynamicResource InputBorder}"

                                 Visibility="{Binding SelectedAction.ActionType, Converter={StaticResource StrNotEqualsVis}, ConverterParameter=T}"/>

                        <TextBox Text="{Binding SelectedAction.PlainText, UpdateSourceTrigger=PropertyChanged}"

                                 Width="220" Padding="4,2" Margin="8,0,0,0"

                                 Background="{DynamicResource InputBackground}"

                                 Foreground="{DynamicResource InputForeground}"

                                 BorderBrush="{DynamicResource InputBorder}"

                                 ToolTip="{theme:Loc afk.plaintext_tip}"

                                 Visibility="{Binding SelectedAction.ActionType, Converter={StaticResource StrEqualsVis}, ConverterParameter=T}"/>

                    </WrapPanel>

                    <TextBlock Margin="70,4,0,0" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"

                               Text="{Binding SelectedAction.ParamHint}"/>

                    <TextBlock Margin="70,4,0,0" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"

                               Text="{Binding SelectedAction.ParamHint}"/>

                </StackPanel>

            </Border>



            <!-- 运行 / 停止 + Token 预览 -->

            <Border Grid.Row="3" Background="{DynamicResource ControlBackground}" CornerRadius="6"

                    Padding="10,8" Margin="0,6,0,0">

                <StackPanel>

                    <WrapPanel>

                        <Button Content="{theme:Loc afk.run}" Command="{Binding RunCommand}" Width="80" Padding="0,4"

                                Style="{StaticResource PrimaryButtonStyle}"

                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisInvert}}"/>

                        <Button Content="{theme:Loc afk.stop}" Command="{Binding StopCommand}" Width="80" Padding="0,4"

                                Margin="8,0,0,0"

                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="{theme:Loc afk.token}" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                        <TextBlock Text="{Binding TokenText}" Margin="8,0,0,0" FontSize="12"

                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"

                                   TextTrimming="CharacterEllipsis" MaxWidth="360"/>

                        <Button Content="{theme:Loc btn.copy}" Command="{Binding CopyTokenCommand}" Width="56" Padding="0,2"

                                Margin="12,0,0,0"/>

                    </WrapPanel>

                    <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource PrimaryForeground}"

                               Text="{Binding TargetText}"/>

                    <TextBlock Margin="0,2,0,0" FontSize="12" FontWeight="Bold"

                               Foreground="{DynamicResource AccentBrush}" Text="{Binding RunStatus}"/>

                </StackPanel>

            </Border>

        </Grid>



        <!-- 右侧：保存/载入/导入 -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>



            <StackPanel Grid.Row="0">

                <TextBlock Text="{theme:Loc afk.save_workflow}" FontWeight="Bold" Margin="0,0,0,6"

                           Foreground="{DynamicResource PrimaryForeground}"/>

                <TextBox Text="{Binding WorkflowName, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"

                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                         BorderBrush="{DynamicResource InputBorder}"/>

                <Button Content="{theme:Loc btn.save}" Command="{Binding SaveCommand}" Width="80" Padding="0,4"

                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,6,0,0"/>

            </StackPanel>



            <StackPanel Grid.Row="1" Margin="0,16,0,0">

                <TextBlock Text="{theme:Loc afk.import_token}" FontWeight="Bold" Margin="0,0,0,6"

                           Foreground="{DynamicResource PrimaryForeground}"/>

                <TextBox Text="{Binding ImportToken, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" Height="48"

                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"

                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                         BorderBrush="{DynamicResource InputBorder}"/>

                <Button Content="{theme:Loc afk.import_from_token}" Command="{Binding ImportCommand}" Width="100" Padding="0,4"

                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,6,0,0"/>

            </StackPanel>



            <StackPanel Grid.Row="2" Margin="0,16,0,0">

                <TextBlock Text="{theme:Loc afk.saved_workflows}" FontWeight="Bold" Margin="0,0,0,6"

                           Foreground="{DynamicResource PrimaryForeground}"/>

                <ListBox ItemsSource="{Binding SavedNames}" Background="{DynamicResource ControlBackground}"

                         BorderBrush="{DynamicResource ControlBorder}" MaxHeight="200">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"

                                           Foreground="{DynamicResource PrimaryForeground}"/>

                                <Button Grid.Column="1" Content="{theme:Loc afk.load}" Width="48" Padding="0,2"

                                        Command="{Binding DataContext.LoadCommand,

                                            RelativeSource={RelativeSource AncestorType=ListBox}}"

                                        CommandParameter="{Binding}" Margin="0,0,4,0"/>

                                <!-- bug #13：删除按钮此前与「载入」同处 Grid.Column=1，被完全遮挡点不到 -->

                                <Button Grid.Column="2" Content="✕" Width="30" Padding="0,2"

                                        Command="{Binding DataContext.DeleteCommand,

                                            RelativeSource={RelativeSource AncestorType=ListBox}}"

                                        CommandParameter="{Binding}" Foreground="#E74C3C"

                                        ToolTip="{theme:Loc afk.delete_workflow_tip}"/>

                            </Grid>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </StackPanel>



            <!-- bug #13：操作结果此前没有任何反馈位置，保存/删除看起来"没反应" -->

            <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,10,0,0" FontSize="12"

                       TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}"/>

        </Grid>



        <!-- bug #73：添加动作 → 整页居中模态弹窗。

             改用 Popup 并以 Placement=Center 绑定整个 Window，使卡片真正居中于整窗

             （而非仅居中于 AFK 视图这一小块区域）。 -->

        <Popup IsOpen="{Binding IsActionPickerOpen}"

               Placement="Center"

               PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}}"

               StaysOpen="False"

               AllowsTransparency="True">

            <Border Style="{StaticResource ModalCardStyle}" MaxWidth="420">

                <StackPanel>

                    <TextBlock Text="{theme:Loc afk.picker_title}" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"

                               Foreground="{DynamicResource PrimaryForeground}"/>

                    <TextBlock Text="{theme:Loc afk.picker_hint}" FontSize="12" Margin="0,0,0,12"

                               Foreground="{DynamicResource SecondaryForeground}"/>

                    <WrapPanel Orientation="Horizontal">

                        <Button Content="{theme:Loc afk.type_f}" Style="{StaticResource ActionTypeButtonStyle}"

                                Command="{Binding PickActionCommand}" CommandParameter="F" Width="120" Margin="4"/>

                        <Button Content="{theme:Loc afk.type_d}" Style="{StaticResource ActionTypeButtonStyle}"

                                Command="{Binding PickActionCommand}" CommandParameter="D" Width="120" Margin="4"/>

                        <Button Content="{theme:Loc afk.type_l}" Style="{StaticResource ActionTypeButtonStyle}"

                                Command="{Binding PickActionCommand}" CommandParameter="L" Width="120" Margin="4"/>

                        <Button Content="{theme:Loc afk.type_k}" Style="{StaticResource ActionTypeButtonStyle}"

                                Command="{Binding PickActionCommand}" CommandParameter="K" Width="120" Margin="4"/>

                        <Button Content="{theme:Loc afk.type_c}" Style="{StaticResource ActionTypeButtonStyle}"

                                Command="{Binding PickActionCommand}" CommandParameter="C" Width="120" Margin="4"/>

                        <Button Content="{theme:Loc afk.type_r}" Style="{StaticResource ActionTypeButtonStyle}"

                                Command="{Binding PickActionCommand}" CommandParameter="R" Width="120" Margin="4"/>

                        <Button Content="{theme:Loc afk.type_m}" Style="{StaticResource ActionTypeButtonStyle}"

                                Command="{Binding PickActionCommand}" CommandParameter="M" Width="120" Margin="4"/>

                        <Button Content="{theme:Loc afk.type_s}" Style="{StaticResource ActionTypeButtonStyle}"

                                Command="{Binding PickActionCommand}" CommandParameter="S" Width="120" Margin="4"/>

                        <Button Content="{theme:Loc afk.type_t}" Style="{StaticResource ActionTypeButtonStyle}"

                                Command="{Binding PickActionCommand}" CommandParameter="T" Width="120" Margin="4"/>

                        <Button Content="{theme:Loc afk.type_g}" Style="{StaticResource ActionTypeButtonStyle}"

                                Command="{Binding PickActionCommand}" CommandParameter="G" Width="120" Margin="4"/>

                        <Button Content="{theme:Loc afk.type_u}" Style="{StaticResource ActionTypeButtonStyle}"

                                Command="{Binding PickActionCommand}" CommandParameter="U" Width="120" Margin="4"/>

                        <Button Content="{theme:Loc afk.type_j}" Style="{StaticResource ActionTypeButtonStyle}"

                                Command="{Binding PickActionCommand}" CommandParameter="J" Width="120" Margin="4"/>

                        <Button Content="{theme:Loc afk.type_e}" Style="{StaticResource ActionTypeButtonStyle}"

                                Command="{Binding PickActionCommand}" CommandParameter="E" Width="120" Margin="4"/>

                        <Button Content="{theme:Loc afk.type_loop}" Style="{StaticResource ActionTypeButtonStyle}"

                                Command="{Binding PickActionCommand}" CommandParameter="*" Width="120" Margin="4"/>

                    </WrapPanel>

                    <Button Content="{theme:Loc btn.cancel}" Style="{StaticResource ActionTypeButtonStyle}"

                            Command="{Binding CancelPickerCommand}" Width="80" Margin="4,12,0,0"

                            HorizontalAlignment="Right"/>

                </StackPanel>

            </Border>

        </Popup>

    </Grid>

    </Grid>

</UserControl>

