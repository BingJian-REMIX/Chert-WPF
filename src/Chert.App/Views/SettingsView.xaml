<UserControl x:Class="Chert.App.Views.SettingsView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"

             xmlns:conv="clr-namespace:Chert.App.Converters"

             xmlns:theme="clr-namespace:Chert.App.Themes"

             xmlns:core="clr-namespace:Chert.Core.Utils;assembly=Chert.Core"

             xmlns:ctrl="clr-namespace:Chert.App.Controls"

             xmlns:views="clr-namespace:Chert.App.Views">

    <UserControl.Resources>

        <conv:StringEqualsConverter x:Key="StrEq"/>

        <!--
            外观页「界面布局」卡片（对齐 design/chert_layout.html 的 .layout-card）：
            每张卡 = 布局缩略图 + 名称，选中时描边转强调色并显示「使用中」徽标。
            用 RadioButton 承载是为了天然互斥；IsChecked 由 SelectedUiStyle 比较得出（单向）。
        -->
        <Style x:Key="StyleCardStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="10" Padding="8,8,8,6" BorderThickness="2"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource ControlBorder}">
                            <StackPanel>
                                <ContentPresenter/>
                                <Border x:Name="PickBtn" CornerRadius="6" Margin="0,8,0,0" Padding="0,3"
                                        Background="{DynamicResource ControlBackground}">
                                    <TextBlock Text="{theme:Loc settings.ui_style_pick}" FontSize="11"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryForeground}"/>
                                </Border>
                                <Border x:Name="InUseBtn" CornerRadius="6" Margin="0,8,0,0" Padding="0,3"
                                        Background="{DynamicResource AccentBrush}" Visibility="Collapsed">
                                    <TextBlock Text="{theme:Loc settings.ui_style_inuse}" FontSize="11"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource AccentForeground}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="PickBtn" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="InUseBtn" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <UserControl.DataContext>

        <vm:SettingsViewModel/>

    </UserControl.DataContext>

    <Grid Margin="12">

        <Grid.ColumnDefinitions>

            <!-- bug #2：副侧边栏与全局侧边栏（Sidebar.Settings 同为 8 项）功能完全重复，列宽收为 0 -->

            <ColumnDefinition Width="0"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>



        <!-- bug #2：设置页内置分类导航已隐藏，分类切换统一由全局侧边栏路由

             （MainWindow.RouteSidebar → SettingsView.ShowSidebarItem）。

             控件本身保留，ShowCategory 仍借它同步选中态。 -->

        <ListBox x:Name="CategoryList" Grid.Column="0" Visibility="Collapsed"

                 SelectionChanged="CategoryList_SelectionChanged"

                 Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}">

            <ListBoxItem Tag="General" Content="{theme:Loc settings.general}"/>

            <ListBoxItem Tag="Launch" Content="{theme:Loc game.btn_start}"/>

            <ListBoxItem Tag="Download" Content="{theme:Loc settings.download}"/>

            <ListBoxItem Tag="Recommend" Content="{theme:Loc settings.recommend}"/>

            <ListBoxItem Tag="Accounts" Content="{theme:Loc settings.account}"/>

            <ListBoxItem Tag="Ai" Content="{theme:Loc tool.aichat}"/>

            <ListBoxItem Tag="Appearance" Content="{theme:Loc settings.appearance}"/>

            <ListBoxItem Tag="About" Content="{theme:Loc settings.about}"/>

        </ListBox>



        <ScrollViewer Grid.Column="1" Margin="0" VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <!-- 通用 -->

                <Grid x:Name="GridGeneral">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{theme:Loc settings.general}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.lang}" VerticalAlignment="Center" Width="90"/>

                        <ComboBox Width="140" SelectedValue="{Binding SelectedLanguage}" SelectedValuePath="Tag">

                            <ComboBoxItem Content="{theme:Loc lbl.chinese}" Tag="zh_CN"/>

                            <ComboBoxItem Content="{theme:Loc lbl.english}" Tag="en_US"/>
                            <ComboBoxItem Content="{theme:Loc lbl.traditional}" Tag="zh_TW"/>

                        </ComboBox>

                    </StackPanel>

                    <WrapPanel Grid.Row="2" Margin="0,3">

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding AutoStartLauncher, Mode=TwoWay}"/>

                        <TextBlock Text="{theme:Loc settings.autostart}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                    </WrapPanel>

                    <WrapPanel Grid.Row="3" Margin="0,3">

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"/>

                        <TextBlock Text="{theme:Loc settings.minimize_tray}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                    </WrapPanel>

                    <WrapPanel Grid.Row="4" Margin="0,3">

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding AnimationsEnabled, Mode=TwoWay}"/>

                        <TextBlock Text="{theme:Loc settings.animations}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                    </WrapPanel>

                    <WrapPanel Grid.Row="5" Margin="0,3">

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding MusicAutoDuck, Mode=TwoWay}"/>

                        <TextBlock Text="{theme:Loc settings.music_autoduck}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                    </WrapPanel>

                    <WrapPanel Grid.Row="7" Margin="0,3">

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding MusicResumeOnLaunch, Mode=TwoWay}"/>

                        <TextBlock Text="{theme:Loc settings.music_resume}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                    </WrapPanel>

                    <WrapPanel Grid.Row="6" Margin="0,3">

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding FileWatchEnabled, Mode=TwoWay}"/>

                        <TextBlock Text="{theme:Loc tool.filewatch}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                    </WrapPanel>

                    <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.default_isolation}" VerticalAlignment="Center" Width="150"/>

                        <ComboBox Width="170" Margin="8,0,0,0" SelectedValue="{Binding DefaultVersionIsolation, Mode=TwoWay}" SelectedValuePath="Tag"

                                  ToolTip="{theme:Loc settings.isolation_tip}">

                            <ComboBoxItem Content="{theme:Loc settings.isolation_shared_label}" Tag="Shared"/>

                            <ComboBoxItem Content="{theme:Loc settings.isolation_auto_label}" Tag="Auto"/>

                        </ComboBox>

                    </StackPanel>

                    <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="{theme:Loc settings.toast_duration}" VerticalAlignment="Center" Width="150"/>
                        <ComboBox Width="170" Margin="8,0,0,0"
                                  SelectedValue="{Binding ToastDurationSeconds, Mode=TwoWay}" SelectedValuePath="Tag">
                            <ComboBoxItem Content="3 秒" Tag="3"/>
                            <ComboBoxItem Content="5 秒（默认）" Tag="5"/>
                            <ComboBoxItem Content="8 秒" Tag="8"/>
                            <ComboBoxItem Content="10 秒" Tag="10"/>
                            <ComboBoxItem Content="永久显示" Tag="0"/>
                        </ComboBox>
                    </StackPanel>

                    <WrapPanel Grid.Row="10" Margin="0,3">
                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding SeasonalEffectsEnabled, Mode=TwoWay}"/>
                        <TextBlock Text="{theme:Loc settings.seasonal_effects}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource PrimaryForeground}"/>
                    </WrapPanel>

                </Grid>



                <!-- 启动 -->

                <Grid x:Name="GridLaunch" Visibility="Collapsed">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{theme:Loc game.btn_start}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <!-- 游戏目录（bug #26）：可自定义 .minecraft 位置，留空即使用系统默认 -->

                    <StackPanel Grid.Row="1" Margin="0,3">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="{theme:Loc settings.game_dir_label}" VerticalAlignment="Center" Width="90"/>

                            <TextBox Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}" Width="300"

                                     ToolTip="{theme:Loc settings.game_dir_tip}"

                                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}" BorderBrush="{DynamicResource InputBorder}"/>

                            <Button Content="{theme:Loc btn.browse}" Command="{Binding BrowseGameRootCommand}" Width="70" Margin="8,0,0,0" Padding="0,2"/>

                            <Button Content="{theme:Loc settings.open_label}" Command="{Binding OpenGameRootCommand}" Width="56" Margin="6,0,0,0" Padding="0,2"/>

                            <Button Content="{theme:Loc settings.reset_default}" Command="{Binding ResetGameRootCommand}" Width="80" Margin="6,0,0,0" Padding="0,2"/>

                        </StackPanel>

                        <TextBlock Text="{Binding DefaultGamePathHint, StringFormat='默认：{0}'}"

                                   Margin="90,4,0,0" FontSize="11"

                                   Foreground="{DynamicResource SecondaryForeground}"/>

                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,3">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="{theme:Loc settings.java_path}" VerticalAlignment="Center" Width="90"/>

                            <!-- Java 下拉：清单来自已交叉校验的 JavaValidator.DetectValidatedAsync -->
                            <ComboBox Width="300" VerticalContentAlignment="Center"
                                      ItemsSource="{Binding DetectedJavas}"
                                      DisplayMemberPath="Display" SelectedValuePath="Key"
                                      SelectedValue="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="{Binding JavaPath}"/>

                            <Button Content="{theme:Loc settings.auto_detect}" Command="{Binding AutoDetectJavaCommand}" Width="80" Margin="8,0,0,0" Padding="0,2"/>

                        </StackPanel>

                        <TextBlock Text="{theme:Loc settings.java_path_hint}" Margin="90,4,0,0" FontSize="11"
                                   Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap" Opacity="0.85"/>

                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.memory_mb}" VerticalAlignment="Center" Width="90"/>

                        <TextBox Text="{Binding MaxMemoryMb, UpdateSourceTrigger=PropertyChanged}" Width="120"

                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}" BorderBrush="{DynamicResource InputBorder}"/>

                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.offline_username}" VerticalAlignment="Center" Width="90"/>

                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Width="200"

                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}" BorderBrush="{DynamicResource InputBorder}"/>

                    </StackPanel>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.jvm_args}" VerticalAlignment="Center" Width="90"/>

                        <TextBox Text="{Binding ExtraJvmArgs, UpdateSourceTrigger=PropertyChanged}" Width="300"

                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}" BorderBrush="{DynamicResource InputBorder}"/>

                    </StackPanel>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.crash_autorepair_label}" VerticalAlignment="Center" Width="90"/>

                        <ComboBox Width="150" SelectedValue="{Binding SelectedRepairPolicy}" SelectedValuePath="Tag">

                            <ComboBoxItem Content="{theme:Loc crash.policy.always}" Tag="Always"/>

                            <ComboBoxItem Content="{theme:Loc settings.repair_ask}" Tag="Ask"/>

                            <ComboBoxItem Content="{theme:Loc crash.policy.never}" Tag="Never"/>

                        </ComboBox>

                    </StackPanel>

                    <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.java_source}" VerticalAlignment="Center" Width="90"/>

                        <ComboBox Width="150" SelectedValue="{Binding SelectedJavaVendor}" SelectedValuePath="Tag">

                            <ComboBoxItem Content="{theme:Loc settings.dl_mirror_auto}" Tag="Auto"/>

                            <ComboBoxItem Content="{theme:Loc settings.java_temurin}" Tag="Temurin"/>

                            <ComboBoxItem Content="{theme:Loc settings.java_oracle}" Tag="Oracle"/>

                        </ComboBox>

                        <TextBlock Text="{theme:Loc settings.missing_dep_label}" VerticalAlignment="Center" Width="70" Margin="12,0,0,0"/>

                        <ComboBox Width="120" SelectedValue="{Binding SelectedAutoInstallMods}" SelectedValuePath="Tag">

                            <ComboBoxItem Content="{theme:Loc settings.on_label}" Tag="Always"/>

                            <ComboBoxItem Content="{theme:Loc settings.auto_deps_ask}" Tag="Ask"/>

                            <ComboBoxItem Content="{theme:Loc settings.auto_deps_off}" Tag="Never"/>

                        </ComboBox>

                    </StackPanel>

                    <WrapPanel Grid.Row="8" Margin="0,3">

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding PrewarmEnabled, Mode=TwoWay}"/>

                        <TextBlock Text="{theme:Loc settings.prewarm}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                    </WrapPanel>

                    <WrapPanel Grid.Row="9" Margin="0,3">

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding HudEnabled, Mode=TwoWay}"/>

                        <TextBlock Text="{theme:Loc settings.hud_label}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                    </WrapPanel>

                    <WrapPanel Grid.Row="10" Margin="0,3">

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding LaunchCompatCheckEnabled, Mode=TwoWay}"/>

                        <TextBlock Text="{theme:Loc settings.launch_compat_label}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                    </WrapPanel>

                    <!-- HUD 可配置化（清单 #54） -->
                    <Border Grid.Row="11" Margin="0,8,0,4" Padding="10" CornerRadius="8"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                            Visibility="{Binding HudEnabled, Converter={x:Static vm:VisibilityHelper.BoolToVis}, FallbackValue=Collapsed}">
                        <StackPanel>
                            <TextBlock Text="{theme:Loc settings.hud_config}" FontWeight="Bold" Margin="0,0,0,6"
                                       Foreground="{DynamicResource PrimaryForeground}"/>

                            <TextBlock Text="{theme:Loc settings.hud_fields}" Margin="0,0,0,4"
                                       Foreground="{DynamicResource SecondaryForeground}"/>
                            <!--
                                字段一律 4 列 2 行对齐排布（此前是 WrapPanel：每个条目按自身内容宽度排，
                                开关与文字在列上参差不齐 —— 用户反馈的「开关未贴合」）。
                                UniformGrid 让每格等宽，开关落在同一条竖线上。
                            -->
                            <ItemsControl ItemsSource="{Binding HudFields}" HorizontalAlignment="Left">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="2" Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,18,8"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">

                                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>

                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       TextTrimming="CharacterEllipsis"

                                                       Foreground="{DynamicResource PrimaryForeground}"/>

                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                                <TextBlock Text="{theme:Loc settings.hud_anchor}" VerticalAlignment="Center" Width="90"
                                           Foreground="{DynamicResource PrimaryForeground}"/>
                                <ComboBox Width="120" SelectedValue="{Binding HudAnchorKey}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="{theme:Loc settings.hud_anchor_tl}" Tag="TopLeft"/>
                                    <ComboBoxItem Content="{theme:Loc settings.hud_anchor_tr}" Tag="TopRight"/>
                                    <ComboBoxItem Content="{theme:Loc settings.hud_anchor_bl}" Tag="BottomLeft"/>
                                    <ComboBoxItem Content="{theme:Loc settings.hud_anchor_br}" Tag="BottomRight"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="{theme:Loc settings.hud_font_size}" VerticalAlignment="Center" Width="90"
                                           Foreground="{DynamicResource PrimaryForeground}"/>
                                <Slider Width="160" Minimum="8" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" Value="{Binding HudFontSize, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding HudFontSize}" VerticalAlignment="Center" Margin="10,0,0,0" Width="32"
                                           Foreground="{DynamicResource PrimaryForeground}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="{theme:Loc settings.hud_opacity}" VerticalAlignment="Center" Width="90"
                                           Foreground="{DynamicResource PrimaryForeground}"/>
                                <Slider Width="160" Minimum="0.1" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" Value="{Binding HudOpacity, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding HudOpacity, StringFormat={}{0:P0}}" VerticalAlignment="Center"
                                           Margin="10,0,0,0" Width="40" Foreground="{DynamicResource PrimaryForeground}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="{theme:Loc settings.hud_refresh}" VerticalAlignment="Center" Width="90"
                                           Foreground="{DynamicResource PrimaryForeground}"/>
                                <Slider Width="160" Minimum="200" Maximum="5000" TickFrequency="100" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" Value="{Binding HudRefreshMs, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding HudRefreshMs, StringFormat={}{0} ms}" VerticalAlignment="Center"
                                           Margin="10,0,0,0" Width="60" Foreground="{DynamicResource PrimaryForeground}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="{theme:Loc settings.hud_margin}" VerticalAlignment="Center" Width="90"
                                           Foreground="{DynamicResource PrimaryForeground}"/>
                                <Slider Width="160" Minimum="0" Maximum="64" TickFrequency="2" IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" Value="{Binding HudMargin, Mode=TwoWay}"/>
                                <TextBlock Text="{Binding HudMargin}" VerticalAlignment="Center" Margin="10,0,0,0" Width="32"
                                           Foreground="{DynamicResource PrimaryForeground}"/>
                            </StackPanel>

                            <!-- 三个开关同样按等宽列对齐（与上面的 4 列字段格同一套对齐语言） -->
                            <UniformGrid Rows="1" Columns="3" HorizontalAlignment="Left" Margin="0,8,0,2">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding HudShowBackground, Mode=TwoWay}"/>
                                    <TextBlock Text="{theme:Loc settings.hud_background}" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{DynamicResource PrimaryForeground}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding HudClickThrough, Mode=TwoWay}"/>
                                    <TextBlock Text="{theme:Loc settings.hud_click_through}" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{DynamicResource PrimaryForeground}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding HudOnlyWhenForeground, Mode=TwoWay}"/>
                                    <TextBlock Text="{theme:Loc settings.hud_foreground_only}" VerticalAlignment="Center" Margin="8,0,0,0"
                                               Foreground="{DynamicResource PrimaryForeground}"/>
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="{theme:Loc settings.hud_reset}" Command="{Binding ResetHudCommand}" Padding="10,4"/>
                            </StackPanel>

                            <TextBlock Text="{theme:Loc settings.hud_tip}" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryForeground}"/>
                        </StackPanel>
                    </Border>

                    <!-- 清单 #63：全局快捷键 -->
                    <StackPanel Grid.Row="12" Margin="0,8,0,4">
                        <WrapPanel>
                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding GlobalHotkeysEnabled, Mode=TwoWay}"/>
                            <TextBlock Text="{theme:Loc settings.global_hotkeys}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{DynamicResource PrimaryForeground}"/>
                        </WrapPanel>
                        <TextBlock Text="{theme:Loc settings.global_hotkeys_tip}" Margin="0,4,0,0" FontSize="11"
                                   TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForeground}"/>
                    </StackPanel>

                    <!-- 清单 #11：触屏模式（启动区：开启后随游戏进程显示虚拟按键面板） -->
                    <Grid Grid.Row="13" Margin="0,8,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="0,3">
                            <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding TouchModeEnabled, Mode=TwoWay}"/>
                            <TextBlock Text="{theme:Loc settings.touch_mode}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{DynamicResource PrimaryForeground}"
                                       ToolTip="{theme:Loc settings.touch_mode_tip}"/>
                        </WrapPanel>
                        <Border Grid.Row="1" Margin="0,6,0,0" Padding="10" CornerRadius="8"
                                Background="{DynamicResource ControlBackground}"
                                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                                Visibility="{Binding TouchModeEnabled, Converter={x:Static vm:VisibilityHelper.BoolToVis}, FallbackValue=Collapsed}">
                            <StackPanel>
                                <TextBlock Text="{theme:Loc settings.touch_config}" FontWeight="Bold" Margin="0,0,0,6"
                                           Foreground="{DynamicResource PrimaryForeground}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="{theme:Loc settings.touch_edit}" Command="{Binding EditTouchLayoutCommand}" Padding="10,4"/>
                                    <Button Content="{theme:Loc settings.touch_reset}" Command="{Binding ResetTouchLayoutCommand}" Padding="10,4" Margin="8,0,0,0"/>
                                    <TextBlock Text="{Binding TouchButtonCount}" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{DynamicResource SecondaryForeground}"/>
                                </StackPanel>
                                <TextBlock Text="{theme:Loc settings.touch_tip}" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryForeground}"/>
                            </StackPanel>
                        </Border>
                    </Grid>



                </Grid>



                <!-- 下载 -->

                <Grid x:Name="GridDownload" Visibility="Collapsed">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{theme:Loc settings.download}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.download_source}" VerticalAlignment="Center" Width="90"/>

                        <ComboBox Width="150" SelectedValue="{Binding SelectedDownloadSource}" SelectedValuePath="Tag">

                            <ComboBoxItem Content="{theme:Loc settings.mirror_first}" Tag="MirrorFirst"/>

                            <ComboBoxItem Content="{theme:Loc settings.official_first}" Tag="OfficialFirst"/>

                        </ComboBox>

                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.max_concurrent}" VerticalAlignment="Center" Width="90"/>

                        <TextBox Text="{Binding MaxConcurrentDownloads, UpdateSourceTrigger=PropertyChanged}" Width="80"

                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}" BorderBrush="{DynamicResource InputBorder}"/>

                    </StackPanel>

                    <WrapPanel Grid.Row="4" Margin="0,3">

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding AutoRepairResourcePacks, Mode=TwoWay}"/>

                        <TextBlock Text="{theme:Loc settings.autorepair_rp_label}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                    </WrapPanel>

                    <WrapPanel Grid.Row="5" Margin="0,3">

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding ServerPackCacheEnabled, Mode=TwoWay}"/>

                        <TextBlock Text="{theme:Loc settings.server_pack_cache}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                    </WrapPanel>

                    <!-- CurseForge：Key 三层策略（启动参数 > 此处自定义 > 构建时注入的内置 Key） -->

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,3">

                        <TextBlock Text="{theme:Loc settings.cf_section}" FontSize="14" FontWeight="Bold"

                                   VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding CurseForgeEnabled, Mode=TwoWay}"/>

                        <TextBlock Text="{Binding CurseForgeStatusText}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

                    </StackPanel>

                    <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.cf_key}" VerticalAlignment="Center" Width="90"/>

                        <TextBox Text="{Binding CurseForgeApiKey, UpdateSourceTrigger=PropertyChanged}" Width="300"

                                 ToolTip="{theme:Loc settings.cf_key_hint}"

                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                                 BorderBrush="{DynamicResource InputBorder}"/>

                        <Button Content="{theme:Loc settings.cf_test}" Command="{Binding TestCurseForgeCommand}"

                                Width="80" Margin="8,0,0,0" Padding="0,2"/>

                    </StackPanel>

                    <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.cf_root}" VerticalAlignment="Center" Width="90"/>

                        <TextBox Text="{Binding CurseForgeApiRoot, UpdateSourceTrigger=PropertyChanged}" Width="300"

                                 ToolTip="{theme:Loc settings.cf_root_hint}"

                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                                 BorderBrush="{DynamicResource InputBorder}"/>

                    </StackPanel>

                    <TextBlock Grid.Row="8" Margin="0,3" FontSize="11" TextWrapping="Wrap"

                               Foreground="{DynamicResource SecondaryForeground}"

                               Text="{theme:Loc settings.cf_tip}"/>

                </Grid>



                <!-- 推荐 -->

                <Grid x:Name="GridRecommend" Visibility="Collapsed">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{theme:Loc game.recommend}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.recommend_master}" VerticalAlignment="Center" Width="90"/>

                        <ComboBox Width="150" SelectedValue="{Binding SelectedIntelliRecommend}" SelectedValuePath="Tag">

                            <ComboBoxItem Content="{theme:Loc settings.recommend_enable_label}" Tag="Enabled"/>

                            <ComboBoxItem Content="{theme:Loc settings.recommend_local}" Tag="LocalOnly"/>

                            <ComboBoxItem Content="{theme:Loc settings.recommend_off}" Tag="Disabled"/>

                        </ComboBox>

                    </StackPanel>

                    <ItemsControl Grid.Row="2" ItemsSource="{Binding CategoryPreferences}" Margin="0,8">

                        <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>

                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <WrapPanel Margin="0,0,12,0" VerticalAlignment="Center">

                                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"/>

                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="6,0,0,0"

                                               Foreground="{DynamicResource PrimaryForeground}"/>

                                </WrapPanel>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </Grid>



                <!-- 账号 -->

                <Grid x:Name="GridAccounts" Visibility="Collapsed">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{theme:Loc settings.account_mgmt}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.ms_client_id}" VerticalAlignment="Center" Width="120" Foreground="{DynamicResource PrimaryForeground}"/>

                        <TextBox Text="{Binding MicrosoftOAuthClientId, UpdateSourceTrigger=PropertyChanged}" Width="300"

                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}" BorderBrush="{DynamicResource InputBorder}" VerticalContentAlignment="Center"

                                 ToolTip="{theme:Loc settings.ms_client_id_tip}"/>

                        <TextBlock Text="{theme:Loc settings.ms_client_id_note}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

                    </StackPanel>

                    <TextBlock Grid.Row="2" Text="{theme:Loc settings.ms_devicecode_desc}"

                               TextWrapping="Wrap" MaxWidth="640" Margin="0,0,0,8" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

                    <ListBox Grid.Row="3" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"

                             Height="140" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}" BorderBrush="{DynamicResource InputBorder}" Margin="0,8,0,0">

                        <ListBox.ItemTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Width="160"/>

                                    <TextBlock Text="{Binding AuthType}" Foreground="{DynamicResource SecondaryForeground}"/>

                                </StackPanel>

                            </DataTemplate>

                        </ListBox.ItemTemplate>

                    </ListBox>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8">

                        <Button Content="{theme:Loc settings.set_current}" Command="{Binding SetActiveAccountCommand}" Width="90" Padding="0,2"/>

                        <Button Content="{theme:Loc btn.delete}" Command="{Binding RemoveAccountCommand}" CommandParameter="{Binding SelectedAccount}" Width="80" Margin="8,0,0,0" Padding="0,2"/>

                        <Button Content="{theme:Loc settings.login_ms}" Command="{Binding LoginMicrosoftCommand}" Width="90" Margin="8,0,0,0" Padding="0,2"/>

                    </StackPanel>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,6">

                        <TextBox Text="{Binding NewOfflineName, UpdateSourceTrigger=PropertyChanged}" Width="160"

                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}" BorderBrush="{DynamicResource InputBorder}" VerticalContentAlignment="Center"/>

                        <Button Content="{theme:Loc settings.add_offline}" Command="{Binding AddOfflineAccountCommand}" Width="110" Margin="8,0,0,0" Padding="0,2"/>

                    </StackPanel>

                    <StackPanel Grid.Row="6" Margin="0,6">

                        <TextBlock Text="{theme:Loc settings.authlib_title}" FontWeight="Bold" Margin="0,0,0,4"/>

                        <TextBlock TextWrapping="Wrap" MaxWidth="640" Margin="0,0,0,6" Opacity="0.8" FontSize="12"

                                   Foreground="{DynamicResource SecondaryForeground}"

                                   Text="{theme:Loc settings.authlib_desc}"/>

                        <!-- 竖排：服务器地址 / 邮箱 / 密码 各占一行；宽度约占整页一半，框内带占位提示 -->
                        <StackPanel Margin="0,2">

                            <StackPanel Orientation="Horizontal">

                                <TextBox Style="{StaticResource PlaceholderTextBoxStyle}"
                                         Text="{Binding AuthlibServerUrl, UpdateSourceTrigger=PropertyChanged}" Width="420"
                                         VerticalContentAlignment="Center"
                                         Tag="{theme:Loc settings.authlib_url_ph}"/>

                                <Button Content="{theme:Loc settings.use_littleskin}" Command="{Binding UseLittleSkinCommand}"
                                        Width="110" Margin="8,0,0,0" Padding="0,2"
                                        ToolTip="{theme:Loc settings.use_littleskin_tip}"/>

                            </StackPanel>

                            <TextBox Style="{StaticResource PlaceholderTextBoxStyle}" Margin="0,4,0,0"
                                     Text="{Binding AuthlibEmail, UpdateSourceTrigger=PropertyChanged}" Width="420"
                                     VerticalContentAlignment="Center"
                                     Tag="{theme:Loc settings.authlib_email_ph}"/>

                            <PasswordBox x:Name="AuthlibPw" Width="420" Margin="0,4,0,0"/>

                            <Button Content="{theme:Loc btn.add}" Click="AddAuthlib_Click" Width="90"
                                    HorizontalAlignment="Left" Margin="0,6,0,0" Padding="0,2"/>

                    </StackPanel>

                    </StackPanel>

                </Grid>



                <!-- AI 助手（独立页面，布局对齐 Linux AiSettingsView）-->

                <views:AiSettingsView x:Name="AiSettingsHost" DataContext="{Binding AiSettingsVM}" Visibility="Collapsed"/>



                <!-- 外观 -->

                <Grid x:Name="GridAppearance" Visibility="Collapsed">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/>   <!-- 9 窗口背景色 -->
                        <RowDefinition Height="Auto"/>   <!-- 10 显示毛玻璃效果 -->
                        <RowDefinition Height="Auto"/>   <!-- 11 毛玻璃透度 -->
                        <RowDefinition Height="Auto"/>   <!-- 12 隐藏侧边栏图标标签 -->
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{theme:Loc settings.appearance}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.theme}" VerticalAlignment="Center" Width="90"/>

                        <ComboBox Width="120" SelectedValue="{Binding SelectedTheme}" SelectedValuePath="Tag"

                                  IsEnabled="{Binding ManualThemeEnabled}">

                            <ComboBoxItem Content="{theme:Loc lbl.dark}" Tag="Dark"/>

                            <ComboBoxItem Content="{theme:Loc lbl.light}" Tag="Light"/>

                        </ComboBox>

                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,3">

                        <StackPanel Orientation="Horizontal">

                            <TextBlock Text="{theme:Loc settings.theme_color}" VerticalAlignment="Center" Width="90"/>

                            <TextBox Text="{Binding ThemeColor, UpdateSourceTrigger=PropertyChanged}" Width="100"

                                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}" BorderBrush="{DynamicResource InputBorder}"/>

                            <Rectangle Width="24" Height="24" Margin="8,0,0,0" RadiusX="4" RadiusY="4"

                                       Fill="{Binding ThemeColor, Converter={x:Static conv:StringToBrushConverter.Instance}}"/>

                            <ToggleButton x:Name="ThemeColorPickerToggle" Style="{StaticResource ToggleChipStyle}"
                                         Content="{theme:Loc settings.pick_color}"

                                         Width="76" Margin="8,0,0,0" Padding="0,2"/>

                        </StackPanel>

                        <!-- 清单 #59：主题色选择复用皮肤编辑器的全色域取色器与全色板 -->

                        <Border Margin="90,6,0,0" Padding="6" CornerRadius="6" HorizontalAlignment="Left"

                                Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"

                                Visibility="{Binding IsChecked, ElementName=ThemeColorPickerToggle, Converter={StaticResource BoolToVis}}">

                            <ctrl:ColorPicker SelectedColor="{Binding ThemeColorValue, Mode=TwoWay}"/>

                        </Border>

                        <!-- 清单 #17：8 个预设主题色点（对齐 design/chert_layout.html 的 .theme-dot） -->

                        <ItemsControl ItemsSource="{Binding ThemeSwatches}" Margin="90,6,0,0" HorizontalAlignment="Left">

                            <ItemsControl.ItemsPanel>

                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>

                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Button Width="22" Height="22" Margin="0,0,8,0" Cursor="Hand"

                                            ToolTip="{Binding Hex}"

                                            Command="{Binding DataContext.PickThemeColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"

                                            CommandParameter="{Binding Hex}">

                                        <Button.Template>

                                            <ControlTemplate TargetType="Button">

                                                <Ellipse Fill="{Binding SwatchBrush}" Stroke="{DynamicResource ControlBorder}" StrokeThickness="1"/>

                                            </ControlTemplate>

                                        </Button.Template>

                                    </Button>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.bg_image}" VerticalAlignment="Center" Width="90"/>

                        <TextBox Text="{Binding BackgroundImagePath, UpdateSourceTrigger=PropertyChanged}" Width="240"

                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}" BorderBrush="{DynamicResource InputBorder}"/>

                        <Button Content="{theme:Loc btn.browse}" Command="{Binding BrowseBackgroundCommand}" Width="70" Margin="8,0,0,0" Padding="0,2"/>

                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.font_scaling}" VerticalAlignment="Center" Width="90"/>

                        <Slider Minimum="0.8" Maximum="1.5" TickFrequency="0.1" Value="{Binding FontScale}" Width="200"/>

                        <TextBlock Text="{Binding FontScale, StringFormat={}{0:P0}}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                        <TextBlock Text="{Binding FontScale, StringFormat={}{0:F1}x}" VerticalAlignment="Center" Margin="8,0,0,0"/>

                    </StackPanel>

                    <WrapPanel Grid.Row="5" Margin="0,3">

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding HighDpiEnabled, Mode=TwoWay}"/>

                        <TextBlock Text="{theme:Loc settings.high_dpi}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                    </WrapPanel>

                    <WrapPanel Grid.Row="6" Margin="0,3">

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding ShowControlBorders, Mode=TwoWay}"/>

                        <TextBlock Text="{theme:Loc settings.show_borders}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                    </WrapPanel>

                    <WrapPanel Grid.Row="7" Margin="0,3">

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding FollowSystemTheme, Mode=TwoWay}"/>

                        <TextBlock Text="{theme:Loc settings.follow_system_theme}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"

                                   ToolTip="{theme:Loc settings.follow_system_theme_tip}"/>

                    </WrapPanel>

                    <!-- 清单 #12 / #15 / #16 / #17：界面布局（对齐 design/chert_layout.html 的 4 张布局卡片） -->
                    <StackPanel Grid.Row="8" Margin="0,3">
                        <TextBlock Text="{theme:Loc settings.ui_style}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryForeground}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="UiStyleCard" Style="{StaticResource StyleCardStyle}"

                                     IsChecked="{Binding SelectedUiStyle, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=standard}"

                                     Command="{Binding SelectUiStyleCommand}" CommandParameter="standard"

                                     ToolTip="{theme:Loc settings.ui_style_tip}">

                            <StackPanel Width="132">

                                <Grid Height="72">

                                            <Grid.RowDefinitions>

                                                <RowDefinition Height="12"/><RowDefinition Height="*"/>

                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Background="{DynamicResource TabGameBrush}"/>

                                            <Grid Grid.Row="1">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="18"/><ColumnDefinition Width="*"/>

                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Background="{DynamicResource ControlBorder}"/>

                                                <Border Grid.Column="1" Background="{DynamicResource WindowBackground}" Margin="3"/>

                                            </Grid>

                                        </Grid>
                                <TextBlock Text="{theme:Loc settings.ui_style_standard}" FontSize="12" Margin="0,7,0,0"

                                           HorizontalAlignment="Center" TextWrapping="Wrap"

                                           Foreground="{DynamicResource PrimaryForeground}"/>

                            </StackPanel>

                        </RadioButton>
                            <RadioButton GroupName="UiStyleCard" Style="{StaticResource StyleCardStyle}"

                                     IsChecked="{Binding SelectedUiStyle, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=dynamic}"

                                     Command="{Binding SelectUiStyleCommand}" CommandParameter="dynamic"

                                     ToolTip="{theme:Loc settings.ui_style_tip}">

                            <StackPanel Width="132">

                                <Grid Height="72">

                                            <Border Background="{DynamicResource TabGameBrush}"/>

                                            <Border Margin="4,16,4,4" CornerRadius="9" Background="{DynamicResource WindowBackground}"/>

                                        </Grid>
                                <TextBlock Text="{theme:Loc settings.ui_style_dynamic}" FontSize="12" Margin="0,7,0,0"

                                           HorizontalAlignment="Center" TextWrapping="Wrap"

                                           Foreground="{DynamicResource PrimaryForeground}"/>

                            </StackPanel>

                        </RadioButton>
                            <RadioButton GroupName="UiStyleCard" Style="{StaticResource StyleCardStyle}"

                                     IsChecked="{Binding SelectedUiStyle, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=android}"

                                     Command="{Binding SelectUiStyleCommand}" CommandParameter="android"

                                     ToolTip="{theme:Loc settings.ui_style_tip}">

                            <StackPanel Width="132">

                                <Grid Height="72">

                                            <Grid.RowDefinitions>

                                                <RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/>

                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"/>

                                            <Border Grid.Row="1" Background="{DynamicResource WindowBackground}"/>

                                            <UniformGrid Grid.Row="2" Rows="1">

                                                <Border Background="{DynamicResource TabGameBrush}"/>

                                                <Border Background="{DynamicResource TabDownloadBrush}"/>

                                                <Border Background="{DynamicResource TabToolboxBrush}"/>

                                                <Border Background="{DynamicResource TabSettingsBrush}"/>

                                            </UniformGrid>

                                        </Grid>
                                <TextBlock Text="{theme:Loc settings.ui_style_android}" FontSize="12" Margin="0,7,0,0"

                                           HorizontalAlignment="Center" TextWrapping="Wrap"

                                           Foreground="{DynamicResource PrimaryForeground}"/>

                            </StackPanel>

                        </RadioButton>
                            <RadioButton GroupName="UiStyleCard" Style="{StaticResource StyleCardStyle}"

                                     IsChecked="{Binding SelectedUiStyle, Mode=OneWay, Converter={StaticResource StrEq}, ConverterParameter=glass}"

                                     Command="{Binding SelectUiStyleCommand}" CommandParameter="glass"

                                     ToolTip="{theme:Loc settings.ui_style_tip}">

                            <StackPanel Width="132">

                                <Grid Height="72">

                                            <Grid.RowDefinitions>

                                                <RowDefinition Height="9"/><RowDefinition Height="*"/><RowDefinition Height="7"/>

                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" Background="{DynamicResource ControlBackground}"/>

                                            <Grid Grid.Row="1">

                                                <Grid.ColumnDefinitions>

                                                    <ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>

                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" Background="{DynamicResource ControlBackground}"/>

                                                <Border Grid.Column="1" Background="{DynamicResource WindowBackground}"/>

                                            </Grid>

                                            <Border Grid.Row="2" Background="{DynamicResource ControlBackground}"/>

                                        </Grid>
                                <TextBlock Text="{theme:Loc settings.ui_style_glass}" FontSize="12" Margin="0,7,0,0"

                                           HorizontalAlignment="Center" TextWrapping="Wrap"

                                           Foreground="{DynamicResource PrimaryForeground}"/>

                            </StackPanel>

                        </RadioButton>
                        </StackPanel>
                    </StackPanel>

                    <!-- 清单 #17：窗口背景色（空 = 跟随主题） -->

                    <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.window_bg_color}" VerticalAlignment="Center" Width="90"/>

                        <TextBox Text="{Binding WindowBackgroundColor, UpdateSourceTrigger=PropertyChanged}" Width="100"

                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}" BorderBrush="{DynamicResource InputBorder}"/>

                        <Rectangle Width="24" Height="24" Margin="8,0,0,0" RadiusX="4" RadiusY="4"

                                   Fill="{Binding WindowBackgroundColor, Converter={x:Static conv:StringToBrushConverter.Instance}}"/>

                    </StackPanel>

                    <WrapPanel Grid.Row="10" Margin="0,3">

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding GlassBlurEnabled, Mode=TwoWay}"/>

                        <TextBlock Text="{theme:Loc settings.glass_blur}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                    </WrapPanel>

                    <WrapPanel Grid.Row="11" Margin="0,3">

                        <TextBlock Text="{theme:Loc settings.glass_opacity}" VerticalAlignment="Center" Width="90"/>

                        <Slider Minimum="30" Maximum="100" TickFrequency="1" Width="160"
                                Value="{Binding GlassOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="{Binding GlassOpacity, StringFormat={}{0:F0}%}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   Foreground="{DynamicResource PrimaryForeground}"/>

                    </WrapPanel>

                    <WrapPanel Grid.Row="12" Margin="0,3">

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding HideSidebarLabels, Mode=TwoWay}"/>

                        <TextBlock Text="{theme:Loc settings.hide_sidebar_labels}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                    </WrapPanel>

                </Grid>




                <!-- 关于 -->

                <Grid x:Name="GridAbout" Visibility="Collapsed">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{theme:Loc settings.about}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Margin="0,3">

                        <Run Text="{theme:Loc about.version}"/>

                        <Run Text="{Binding LauncherVersion, Mode=OneWay}" FontWeight="Bold"/>

                    </TextBlock>

                    <WrapPanel Grid.Row="2" Margin="0,3">

                        <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                      IsChecked="{Binding AutoUpdateCheck, Mode=TwoWay}"/>

                        <TextBlock Text="{theme:Loc settings.autoupdate_check}" VerticalAlignment="Center" Margin="8,0,0,0"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                    </WrapPanel>

                    <Button Grid.Row="3" Content="{theme:Loc about.check_update}" Command="{Binding CheckUpdateCommand}" Width="100" HorizontalAlignment="Left" Padding="0,4" Margin="0,3"/>

                    <TextBlock Grid.Row="4" Text="{Binding UpdateMessage}" Foreground="{DynamicResource StatusForeground}" Margin="0,2,0,0"/>

                    <TextBlock Grid.Row="5" Margin="0,8,0,0" Foreground="{DynamicResource SecondaryForeground}" FontSize="11">

                        <Hyperlink NavigateUri="{x:Static core:GameConstants.GitHubRepoUri}" RequestNavigate="OpenUrl_Click">

                            <!-- 注意：{theme:Loc} 是标记扩展，只能出现在「属性」位置。
                                 之前写成 <Hyperlink> 的元素内容，结果界面上原样显示了
                                 "{theme:Loc settings.license_github}" 字面量。 -->

                            <Run Text="{theme:Loc settings.license_github}"/>

                        </Hyperlink>

                    </TextBlock>

                </Grid>



                <!-- 保存 -->

                <Button Content="{theme:Loc settings.save_settings}" Command="{Binding SaveCommand}" Width="120" HorizontalAlignment="Left"

                        Margin="0,16,0,0" Padding="0,6" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>

                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource StatusForeground}" Margin="0,8,0,0"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>

