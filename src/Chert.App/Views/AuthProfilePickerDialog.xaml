<Window x:Class="Chert.App.Views.AuthProfilePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:theme="clr-namespace:Chert.App.Themes"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="选择游戏角色" Width="420" Height="360">
    <Grid x:Name="RootGrid" Style="{StaticResource ModalOverlayStyle}">
        <!-- 居中卡片：复用已定义的 ModalCardStyle（暗色底 / 圆角 / 阴影） -->
        <Border x:Name="Card" Width="400" MaxHeight="360" VerticalAlignment="Center" HorizontalAlignment="Center"
                Style="{StaticResource ModalCardStyle}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" FontSize="19" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForeground}"
                           Text="{theme:Loc authlib.pick_title}"/>
                <TextBlock DockPanel.Dock="Top" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource SecondaryForeground}"
                           Text="{theme:Loc authlib.pick_subtitle}"/>

                <!-- 按钮行：复用 ModalButtonRowStyle（右置主操作） -->
                <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource ModalButtonRowStyle}">
                    <Button x:Name="CancelButton" Content="{theme:Loc authlib.pick_cancel}" Width="96" Padding="0,8"
                            Margin="0,0,10,0" Background="{DynamicResource ControlBackground}"
                            Foreground="{DynamicResource PrimaryForeground}" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorder}" Click="Cancel_Click"/>
                    <Button x:Name="OkButton" Content="{theme:Loc authlib.pick_confirm}" Width="150" Padding="0,8"
                            Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                            Click="Ok_Click" IsEnabled="False"/>
                </StackPanel>

                <!-- 角色列表（由代码填充） -->
                <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ProfilePanel" Orientation="Vertical"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
