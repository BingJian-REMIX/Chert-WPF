<UserControl x:Class="Chert.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:conv="clr-namespace:Chert.App.Converters">
    <UserControl.DataContext>
        <vm:LogViewModel/>
    </UserControl.DataContext>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="刷新" Command="{Binding RefreshCommand}" Width="70" Padding="0,2"/>
            <Button Content="导出" Command="{Binding ExportCommand}" Width="70" Padding="0,2" Margin="8,0,0,0"/>
        </StackPanel>

        <ListBox Grid.Column="0" Grid.Row="1" ItemsSource="{Binding Files}"
                 SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                 BorderBrush="{DynamicResource InputBorder}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2">
                        <TextBlock FontWeight="Bold" Text="{Binding Name}"/>
                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryForeground}">
                            <Run Text="{Binding Kind}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding SizeBytes, StringFormat={}{0:N0} B}"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBox Width="200" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}" VerticalContentAlignment="Center"/>
                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding OnlyErrors, Mode=TwoWay}" Margin="12,0,4,0"
                              VerticalAlignment="Center"/>
                <TextBlock Text="仅错误" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <Button Content="刷新" Command="{Binding RefreshCommand}" Width="70" Padding="0,2" Margin="12,0,0,0"/>
            </StackPanel>
            <ListBox Grid.Row="1" ItemsSource="{Binding Lines}"
                     Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"
                     Foreground="{DynamicResource PrimaryForeground}"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                   Foreground="{Binding Severity, Converter={x:Static conv:LogSeverityToColor.Instance}}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
