<UserControl x:Class="Chert.App.Views.LogView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"

             xmlns:conv="clr-namespace:Chert.App.Converters"
             xmlns:theme="clr-namespace:Chert.App.Themes">

    <UserControl.DataContext>

        <vm:LogViewModel/>

    </UserControl.DataContext>

    <Grid Margin="12">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="280"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">

            <Button Content="{theme:Loc mods.refresh}" Command="{Binding RefreshCommand}" Width="70" Padding="0,2"/>

            <Button Content="{theme:Loc btn.export}" Command="{Binding ExportCommand}" Width="70" Padding="0,2" Margin="8,0,0,0"/>

        </StackPanel>



        <ListBox Grid.Column="0" Grid.Row="1" ItemsSource="{Binding Files}"

                 SelectedItem="{Binding SelectedFile, Mode=TwoWay}"

                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                 BorderBrush="{DynamicResource InputBorder}">

            <ListBox.ItemTemplate>

                <DataTemplate>

                    <StackPanel Margin="2">

                        <TextBlock FontWeight="Bold" Text="{Binding Name}"/>

                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryForeground}">

                            <Run Text="{Binding Kind}"/>

                            <Run Text=" · "/>

                            <Run Text="{Binding SizeBytes, StringFormat={}{0:N0} B}"/>

                        </TextBlock>

                    </StackPanel>

                </DataTemplate>

            </ListBox.ItemTemplate>

        </ListBox>



        <Grid Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="12,0,0,0">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>

                <RowDefinition Height="*"/>

                <!-- P11：聊天记录页签 -->

                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">

                <TextBox Width="200" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}"

                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                         BorderBrush="{DynamicResource InputBorder}" VerticalContentAlignment="Center"/>

                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                              IsChecked="{Binding OnlyErrors, Mode=TwoWay}" Margin="12,0,4,0"

                              VerticalAlignment="Center"/>

                <TextBlock Text="{theme:Loc log.m164}" VerticalAlignment="Center"

                           Foreground="{DynamicResource PrimaryForeground}"/>

                <Button Content="{theme:Loc mods.refresh}" Command="{Binding RefreshCommand}" Width="70" Padding="0,2" Margin="12,0,0,0"/>

                <!-- 聊天记录开关（用户要求：与上方「只显示错误」同款的开关式，不用页签） -->
                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding ShowChatPanel, Mode=TwoWay}" Margin="16,0,4,0"
                              VerticalAlignment="Center"
                              ToolTip="在日志正文下方展开 / 收起聊天记录"/>
                <TextBlock Text="聊天记录" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <TextBlock Text="{Binding ChatCountText}" VerticalAlignment="Center" Margin="6,0,0,0"
                           Foreground="{DynamicResource SecondaryForeground}" FontSize="11"/>

                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="16,0,0,0"
                           Foreground="{DynamicResource SecondaryForeground}" FontSize="11" TextTrimming="CharacterEllipsis"/>

            </StackPanel>

            <!-- P11：聊天记录改为开关控制的下方折叠区（不再是页签） -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox Grid.Row="0" ItemsSource="{Binding Lines}"
                         Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"
                         Foreground="{DynamicResource PrimaryForeground}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                       Foreground="{Binding Severity, Converter={x:Static conv:LogSeverityToColor.Instance}}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 聊天记录区：仅在开关打开时显示 -->
                <Border Grid.Row="1" Margin="0,8,0,0" Padding="8" CornerRadius="6"
                        Background="{DynamicResource ControlBackground}"
                        BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                        MaxHeight="320"
                        Visibility="{Binding ShowChatPanel, Converter={x:Static vm:VisibilityHelper.BoolToVis}, FallbackValue=Collapsed}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 标题行：条数 + 导出 -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ChatStatus}" FontSize="11"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource SecondaryForeground}"/>
                            <Button Grid.Column="1" Content="导出 .txt" Width="82" Padding="0,3" Margin="6,0,0,0"
                                    Command="{Binding ExportChatCommand}" CommandParameter="txt"
                                    IsEnabled="{Binding HasChat}" ToolTip="导出为纯文本"/>
                            <Button Grid.Column="2" Content="导出 .md" Width="82" Padding="0,3" Margin="6,0,0,0"
                                    Command="{Binding ExportChatCommand}" CommandParameter="md"
                                    IsEnabled="{Binding HasChat}" ToolTip="导出为 Markdown 表格"/>
                        </Grid>

                        <!-- 内容区：有数据显示绿色行；无数据显示空态说明（否则用户以为染色坏了） -->
                        <Grid Grid.Row="1">
                            <ListBox ItemsSource="{Binding ChatEntries}"
                                     Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     Visibility="{Binding HasChat, Converter={x:Static vm:VisibilityHelper.BoolToVis}, FallbackValue=Collapsed}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" Margin="0,1,0,1"
                                                   Foreground="{DynamicResource ChatForeground}">
                                            <Run Text="{Binding Time, Mode=OneWay}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Player, Mode=OneWay}" FontWeight="SemiBold"/>
                                            <Run Text=": "/>
                                            <Run Text="{Binding Message, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 空态：明确告诉用户「这份日志里没有聊天记录」，而不是空白 -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Visibility="{Binding HasChat, Converter={x:Static vm:VisibilityHelper.BoolToVisInvert}, FallbackValue=Visible}">
                                <TextBlock Text="这份日志里没有聊天记录" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryForeground}"/>
                                <TextBlock Text="游戏内发送消息（单机为 &lt;玩家名&gt; 格式）后重新载入即可看到"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="11"
                                           Foreground="{DynamicResource SecondaryForeground}" Opacity="0.8"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

    </Grid>

</UserControl>

