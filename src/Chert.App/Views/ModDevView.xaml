<UserControl x:Class="Chert.App.Views.ModDevView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chert.App.ViewModels">
    <UserControl.DataContext>
        <vm:ModDevViewModel/>
    </UserControl.DataContext>
    <ScrollViewer Margin="18">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Mod 开发环境" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryForeground}" Margin="0,0,0,14"/>

            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="Mod ID" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ModId}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="显示名称" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ModName}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="加载器" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,4"/>
                <ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding Loader}" MinWidth="160"
                          Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="目标 MC 版本" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding McVersion}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,12">
                <TextBlock Text="目标目录" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding TargetDir}" Margin="0,0,8,0"
                             Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>
                    <Button Grid.Column="1" Content="浏览…" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SelectDirCommand}"/>
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="生成 Mod 骨架" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding GenerateCommand}" IsEnabled="{Binding !Busy}"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource SecondaryForeground}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
