<UserControl x:Class="Chert.App.Views.ModDevView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:theme="clr-namespace:Chert.App.Themes">

    <UserControl.DataContext>

        <vm:ModDevViewModel/>

    </UserControl.DataContext>

    <ScrollViewer Margin="18">

        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Text="{theme:Loc tool.moddev}" FontSize="16" FontWeight="Bold"

                       Foreground="{DynamicResource PrimaryForeground}" Margin="0,0,0,14"/>



            <StackPanel Margin="0,0,0,12">

                <TextBlock Text="Mod ID" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,4"/>

                <TextBox Text="{Binding ModId}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>

            </StackPanel>

            <StackPanel Margin="0,0,0,12">

                <TextBlock Text="{theme:Loc moddev.m166}" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,4"/>

                <TextBox Text="{Binding ModName}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>

            </StackPanel>

            <StackPanel Margin="0,0,0,12">

                <TextBlock Text="{theme:Loc dev.m97}" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,4"/>

                <ComboBox ItemsSource="{Binding Loaders}" SelectedItem="{Binding Loader}" MinWidth="160"

                          Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>

            </StackPanel>

            <StackPanel Margin="0,0,0,12">

                <TextBlock Text="{theme:Loc moddev.m167}" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,4"/>

                <TextBox Text="{Binding McVersion}" Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>

            </StackPanel>

            <StackPanel Margin="0,0,0,12">

                <TextBlock Text="{theme:Loc moddev.m168}" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,4"/>

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding TargetDir}" Margin="0,0,8,0"

                             Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>

                    <Button Grid.Column="1" Content="{theme:Loc backup.m48}" Style="{StaticResource PrimaryButtonStyle}"

                            Command="{Binding SelectDirCommand}"/>

                </Grid>

            </StackPanel>



            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">

                <Button Content="{theme:Loc moddev.m169}" Style="{StaticResource PrimaryButtonStyle}"

                        Command="{Binding GenerateCommand}" IsEnabled="{Binding !Busy}"/>

                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"

                           Foreground="{DynamicResource SecondaryForeground}"/>

            </StackPanel>

        </StackPanel>

    </ScrollViewer>

</UserControl>

