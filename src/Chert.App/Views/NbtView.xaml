<UserControl x:Class="Chert.App.Views.NbtView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chert.App.ViewModels">
    <UserControl.DataContext>
        <vm:NbtViewModel/>
    </UserControl.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 工具栏 -->
            <RowDefinition Height="*"/>      <!-- 树 + 编辑区 -->
            <RowDefinition Height="Auto"/>   <!-- 状态 -->
        </Grid.RowDefinitions>

        <!-- ===== 工具栏 ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="打开…" Command="{Binding OpenCommand}" Width="70" Padding="0,3"/>
            <Button Grid.Column="1" Content="保存" Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="14,4" Margin="8,0,0,0"/>
            <Button Grid.Column="2" Content="另存为…" Command="{Binding SaveAsCommand}" Width="80" Padding="0,3" Margin="6,0,0,0"/>
            <Button Grid.Column="3" Content="导出文本" Command="{Binding ExportTextCommand}" Width="80" Padding="0,3" Margin="6,0,0,0"/>

            <ToggleButton Grid.Column="4" Style="{StaticResource ToggleSwitchStyle}"
                          IsChecked="{Binding AutoBackup, Mode=TwoWay}" Margin="18,0,0,0"
                          VerticalAlignment="Center" ToolTip="保存时先把原文件复制一份 .bak"/>
            <TextBlock Grid.Column="5" Text="保存前自动备份" VerticalAlignment="Center" Margin="8,0,0,0"
                       Foreground="{DynamicResource PrimaryForeground}"/>

            <ComboBox Grid.Column="6" ItemsSource="{Binding QuickFiles}" Margin="18,0,8,0"
                      SelectionChanged="QuickFile_SelectionChanged"
                      ToolTip="存档的 level.dat 快捷入口">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Column="7" Text="{Binding TitleText}" VerticalAlignment="Center"
                       FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>
        </Grid>

        <!-- ===== 树 + 编辑区 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource ListViewBorder}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,6"
                                Background="Transparent">
                        <Button Content="全部展开" Command="{Binding ExpandAllCommand}" Width="76" Padding="0,2"/>
                        <Button Content="全部折叠" Command="{Binding CollapseAllCommand}" Width="76" Padding="0,2" Margin="6,0,0,0"/>
                        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="14,0,0,0"
                                   FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
                    </StackPanel>

                    <TreeView Grid.Row="1" x:Name="NbtTree" ItemsSource="{Binding Roots}"
                              Background="{DynamicResource ListViewBackground}" BorderThickness="0"
                              SelectedItemChanged="NbtTree_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="{DynamicResource ControlBackground}" CornerRadius="3"
                                            Padding="4,0" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding TypeText}" FontSize="10"
                                                   Foreground="{DynamicResource SecondaryForeground}"/>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" = " Foreground="{DynamicResource SecondaryForeground}"/>
                                    <TextBlock Text="{Binding ValueText}" MaxWidth="320"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- 右侧编辑面板 -->
            <Border Grid.Column="2" Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                    CornerRadius="8" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="选中节点" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForeground}" Margin="0,0,0,8"/>

                        <TextBlock Text="路径" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
                        <TextBox Text="{Binding SelectedPath, Mode=OneWay}" IsReadOnly="True" Margin="0,2,0,8"
                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                                 BorderBrush="{DynamicResource InputBorder}" Padding="6,3" TextWrapping="Wrap"/>

                        <TextBlock Text="类型" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
                        <TextBlock Text="{Binding SelectedTypeText}" Margin="0,2,0,10"
                                   Foreground="{DynamicResource PrimaryForeground}"/>

                        <TextBlock Text="值（仅标量可编辑）" FontSize="11"
                                   Foreground="{DynamicResource SecondaryForeground}"/>
                        <TextBox Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanEditValue}" Margin="0,2,0,6"
                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                                 BorderBrush="{DynamicResource InputBorder}" Padding="6,3"
                                 AcceptsReturn="False" TextWrapping="Wrap"/>
                        <Button Content="应用修改" Command="{Binding ApplyValueCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Padding="14,4"
                                HorizontalAlignment="Left"/>

                        <Separator Margin="0,14,0,10" Background="{DynamicResource ControlBorder}"/>

                        <TextBlock Text="新增 / 重命名" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryForeground}" Margin="0,0,0,6"/>
                        <TextBlock Text="名称" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
                        <TextBox Text="{Binding NewChildName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"
                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                                 BorderBrush="{DynamicResource InputBorder}" Padding="6,3"/>

                        <TextBlock Text="类型" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
                        <ComboBox ItemsSource="{Binding NewChildTypes}" SelectedItem="{Binding NewChildType}"
                                  Margin="0,2,0,8"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="新增子标签" Command="{Binding AddChildCommand}" Width="94" Padding="0,3"/>
                            <Button Content="重命名" Command="{Binding RenameCommand}" Width="70" Padding="0,3" Margin="6,0,0,0"/>
                        </StackPanel>

                        <Button Content="删除选中标签" Command="{Binding RemoveCommand}" Margin="0,10,0,0"
                                Padding="0,4" HorizontalAlignment="Stretch"
                                Foreground="White" Background="{DynamicResource DangerBrush}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Margin="0,8,0,0"
                   Foreground="{DynamicResource StatusForeground}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
