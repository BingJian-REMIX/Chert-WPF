<UserControl x:Class="Chert.App.Views.ServerPackView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:theme="clr-namespace:Chert.App.Themes">

    <UserControl.DataContext>

        <vm:ServerPackViewModel/>

    </UserControl.DataContext>



    <Grid Margin="12">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>   <!-- 工具栏 -->

            <RowDefinition Height="Auto"/>   <!-- 概览 -->

            <RowDefinition Height="*"/>      <!-- 列表 -->

            <RowDefinition Height="Auto"/>   <!-- 选中操作 -->

            <RowDefinition Height="Auto"/>   <!-- 状态 -->

        </Grid.RowDefinitions>



        <!-- ===== 工具栏 ===== -->

        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">

            <TextBlock Text="{theme:Loc server.m231}" VerticalAlignment="Center" Margin="0,0,6,0"

                       Foreground="{DynamicResource SecondaryForeground}"/>

            <TextBox Text="{Binding CapacityMb, UpdateSourceTrigger=PropertyChanged}" Width="64"

                     Padding="6,3" VerticalContentAlignment="Center"

                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                     BorderBrush="{DynamicResource InputBorder}" ToolTip="{theme:Loc server.m232}"/>

            <TextBlock Text="MB" VerticalAlignment="Center" Margin="4,0,16,0"

                       Foreground="{DynamicResource SecondaryForeground}"/>



            <Button Content="{theme:Loc server.m233}" Command="{Binding ExportCommand}" Width="104" Padding="0,4"

                    Margin="0,0,8,0"/>

            <Button Content="{theme:Loc server.m234}" Command="{Binding OpenFolderCommand}" Width="96" Padding="0,4"

                    Margin="0,0,8,0"/>

            <Button Content="{theme:Loc server.m235}" Command="{Binding ClearCommand}" Width="60" Padding="0,4"

                    Margin="0,0,8,0"/>

            <Button Content="{theme:Loc mods.refresh}" Command="{Binding RefreshCommand}" Width="60" Padding="0,4"/>

        </WrapPanel>



        <!-- ===== 概览 ===== -->

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="10,7" Margin="0,0,0,10">

            <StackPanel Orientation="Horizontal">

                <TextBlock Foreground="{DynamicResource SecondaryForeground}">

                    <Run Text="{theme:Loc server.m236}"/>

                    <Run Text="{Binding Stats.Count, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>

                    <Run Text="{theme:Loc server.m237}"/>

                    <Run Text="{Binding Stats.TotalMb}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>

                    <Run Text="{theme:Loc server.m238}"/>

                    <Run Text="{Binding Stats.TotalHits}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>

                    <Run Text="{theme:Loc server.m239}"/>

                    <Run Text="{Binding CapacityMb}" FontWeight="Bold" Foreground="{DynamicResource PrimaryForeground}"/>

                    <Run Text=" MB"/>

                </TextBlock>

            </StackPanel>

        </Border>



        <!-- ===== 列表 ===== -->

        <Border Grid.Row="2" BorderBrush="{DynamicResource ListViewBorder}" BorderThickness="1" CornerRadius="6">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>



                <Border Grid.Row="0" Background="{DynamicResource ListViewHeaderBackground}" Padding="10,5">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="160"/>

                            <ColumnDefinition Width="90"/>

                            <ColumnDefinition Width="60"/>

                            <ColumnDefinition Width="120"/>

                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{theme:Loc server.m240}" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

                        <TextBlock Grid.Column="1" Text="{theme:Loc server.m241}" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

                        <TextBlock Grid.Column="2" Text="{theme:Loc backup.m67}" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

                        <TextBlock Grid.Column="3" Text="{theme:Loc server.m242}" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

                        <TextBlock Grid.Column="4" Text="{theme:Loc server.m243}" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

                    </Grid>

                </Border>



                <ListBox Grid.Row="1" ItemsSource="{Binding Packs}" SelectedItem="{Binding Selected}"

                         Background="{DynamicResource ListViewBackground}" BorderThickness="0"

                         HorizontalContentAlignment="Stretch">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Grid Margin="0,3">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="160"/>

                                    <ColumnDefinition Width="90"/>

                                    <ColumnDefinition Width="60"/>

                                    <ColumnDefinition Width="120"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontWeight="SemiBold"

                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Url}"/>

                                <TextBlock Grid.Column="1" Text="{Binding ServerAddress}" FontSize="11"

                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryForeground}"/>

                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11"

                                           Foreground="{DynamicResource SecondaryForeground}"/>

                                <TextBlock Grid.Column="3" Text="{Binding Hits}" FontSize="11"

                                           Foreground="{DynamicResource SecondaryForeground}"/>

                                <TextBlock Grid.Column="4" Text="{Binding LastUsed, StringFormat={}{0:yyyy-MM-dd HH:mm}}"

                                           FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

                            </Grid>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>



                <TextBlock Grid.Row="1" Text="{theme:Loc server.m244}"

                           Foreground="{DynamicResource SecondaryForeground}" FontSize="12"

                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"

                           MaxWidth="420" TextAlignment="Center">

                    <TextBlock.Style>

                        <Style TargetType="TextBlock">

                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding Packs.Count}" Value="0">

                                    <Setter Property="Visibility" Value="Visible"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </TextBlock.Style>

                </TextBlock>

            </Grid>

        </Border>



        <!-- ===== 选中操作 ===== -->

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">

            <Button Content="{theme:Loc server.m245}" Command="{Binding ExportToResourcePacksCommand}" Width="136"

                    Padding="0,4" Margin="0,0,8,0"/>

            <Button Content="{theme:Loc backup.m70}" Command="{Binding RemoveCommand}" Width="84" Padding="0,4"/>

        </StackPanel>



        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Margin="0,6,0,0"

                   Foreground="{DynamicResource StatusForeground}" TextWrapping="Wrap"/>

    </Grid>

</UserControl>

