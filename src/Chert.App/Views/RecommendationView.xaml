<UserControl x:Class="Chert.App.Views.RecommendationView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:theme="clr-namespace:Chert.App.Themes">

    <UserControl.Resources>

        <Style x:Key="CardBorder" TargetType="Border">

            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="CornerRadius" Value="6"/>

            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>

            <Setter Property="Width" Value="240"/>

            <Setter Property="Margin" Value="8"/>

            <Setter Property="Padding" Value="10"/>

        </Style>

    </UserControl.Resources>

    <UserControl.DataContext>

        <vm:RecommendationViewModel/>

    </UserControl.DataContext>

    <Grid Margin="12">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">

            <TextBlock Text="{theme:Loc game.recommend}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>

            <Button Content="{theme:Loc mods.refresh}" Command="{Binding RefreshCommand}" Width="80" Margin="12,0,0,0" Padding="0,2"/>

        </StackPanel>



        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">

            <ItemsControl ItemsSource="{Binding Items}">

                <ItemsControl.ItemsPanel>

                    <ItemsPanelTemplate>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top"/>

                    </ItemsPanelTemplate>

                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border>

                            <Border.Style>

                                <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsDependencyCompletion}" Value="True">

                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>

                                            <Setter Property="BorderThickness" Value="2"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Border.Style>

                            <StackPanel>

                                <Image Source="{Binding IconUrl}" Height="56" Width="56" Stretch="Uniform"

                                       HorizontalAlignment="Left" Margin="0,0,0,6"/>

                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>

                                <Border Background="{DynamicResource TabItemBackground}" CornerRadius="3"

                                        Padding="4,1" Margin="0,4,0,0" HorizontalAlignment="Left">

                                    <TextBlock Text="{Binding CategoryLabel}" FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

                                </Border>

                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="11"

                                           Margin="0,6,0,0" Opacity="0.8" MaxHeight="60"/>

                                <TextBlock Text="{Binding Reason}" FontStyle="Italic" FontSize="11" Margin="0,4,0,0"

                                           Foreground="{DynamicResource AccentForeground}"/>

                                <TextBlock FontSize="11" Margin="0,4,0,0"

                                           Foreground="{DynamicResource SecondaryForeground}"><Run Text="{Binding Downloads, StringFormat={}{0:N0}}"/><Run Text="{theme:Loc rec.downloads}"/></TextBlock>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">

                                    <Button Content="{theme:Loc btn.install}" Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"

                                            CommandParameter="{Binding}" Width="56" Padding="0,3" Margin="0,0,6,0"/>

                                    <Button Content="{theme:Loc game.not_interested}" Command="{Binding DataContext.NotInterestedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"

                                            CommandParameter="{Binding}" Width="72" Padding="0,3" Margin="0,0,6,0"/>

                                    <Button Content="{theme:Loc dl.detail}" Command="{Binding DataContext.DetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"

                                            CommandParameter="{Binding}" Width="56" Padding="0,3"/>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>



        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource StatusForeground}" Margin="0,8,0,0"/>

    </Grid>

</UserControl>

