<UserControl x:Class="Chert.App.Views.DataPackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:core="clr-namespace:Chert.Core.Toolbox;assembly=Chert.Core">
    <UserControl.DataContext>
        <vm:DataPackViewModel/>
    </UserControl.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 工具栏 -->
            <RowDefinition Height="*"/>      <!-- 冲突 + 数据包 -->
            <RowDefinition Height="Auto"/>   <!-- 建议 + 状态 -->
        </Grid.RowDefinitions>

        <!-- ===== 工具栏 ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="存档" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource SecondaryForeground}"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Saves}" SelectedItem="{Binding SelectedSave}"
                      DisplayMemberPath="Name"/>

            <TextBlock Grid.Column="2" Text="目标版本" VerticalAlignment="Center" Margin="16,0,8,0"
                       Foreground="{DynamicResource SecondaryForeground}"/>
            <TextBox Grid.Column="3" Text="{Binding TargetVersion, UpdateSourceTrigger=PropertyChanged}"
                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                     BorderBrush="{DynamicResource InputBorder}" Padding="6,3" VerticalContentAlignment="Center"
                     ToolTip="填写如 1.21，用于 pack_format 告警；留空则跳过该检查"/>

            <Button Grid.Column="4" Content="扫描" Command="{Binding ScanCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" Padding="16,4" Margin="10,0,0,0"/>
            <Button Grid.Column="5" Content="刷新存档" Command="{Binding RefreshSavesCommand}"
                    Width="76" Padding="0,4" Margin="6,0,0,0"/>

            <TextBlock Grid.Column="6" Text="{Binding RulesText}" VerticalAlignment="Center" Margin="16,0,8,0"
                       FontSize="11" Foreground="{DynamicResource SecondaryForeground}"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="7" Content="更新规则库" Command="{Binding UpdateRulesCommand}"
                    Width="88" Padding="0,4"/>
            <Button Grid.Column="8" Content="恢复内置" Command="{Binding ResetRulesCommand}"
                    Width="76" Padding="0,4" Margin="6,0,0,0"/>
        </Grid>

        <!-- ===== 冲突列表 + 数据包列表 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- 冲突 -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource ListViewBorder}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource ListViewHeaderBackground}" Padding="10,5">
                        <TextBlock Text="{Binding Summary}" FontSize="11"
                                   Foreground="{DynamicResource SecondaryForeground}"/>
                    </Border>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict}"
                             Background="{DynamicResource ListViewBackground}" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 严重度徽标 -->
                                    <Border Grid.Column="0" CornerRadius="3" Padding="5,1" VerticalAlignment="Top"
                                            Margin="0,1,6,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static core:ConflictSeverity.Critical}">
                                                        <Setter Property="Background" Value="#E74C3C"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="{x:Static core:ConflictSeverity.Warning}">
                                                        <Setter Property="Background" Value="#FF9800"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SeverityText}" FontSize="10" Foreground="White"/>
                                    </Border>

                                    <Border Grid.Column="1" Background="{DynamicResource ControlBackground}"
                                            CornerRadius="3" Padding="5,1" VerticalAlignment="Top" Margin="0,1,8,0">
                                        <TextBlock Text="{Binding KindText}" FontSize="10"
                                                   Foreground="{DynamicResource SecondaryForeground}"/>
                                    </Border>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Resource}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="生效：" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryForeground}"/>
                                            <TextBlock Text="{Binding Winner}" FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}"/>
                                            <TextBlock Text="　被覆盖：" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryForeground}"/>
                                            <TextBlock Text="{Binding LosersText}" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryForeground}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="240"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,6,10,8">
                        <Button Content="跳转到数据包" Command="{Binding JumpToPackCommand}"
                                CommandParameter="{Binding SelectedConflict}" Width="106" Padding="0,3"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 数据包 + 格式告警 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource ControlBackground}"
                        BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="数据包（按加载顺序）" FontWeight="Bold" Margin="0,0,0,6"
                                   Foreground="{DynamicResource PrimaryForeground}"/>
                        <ListBox Grid.Row="1" ItemsSource="{Binding Packs}" Background="Transparent"
                                 BorderThickness="0" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding LoadOrder}" Width="20" FontSize="11"
                                                       Foreground="{DynamicResource SecondaryForeground}"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="20,1,0,0">
                                            <TextBlock Text="{Binding PackFormat, StringFormat=format {0}}" FontSize="10"
                                                       Foreground="{DynamicResource SecondaryForeground}"/>
                                            <TextBlock Text="　zip" FontSize="10"
                                                       Foreground="{DynamicResource SecondaryForeground}"
                                                       Visibility="{Binding IsZip, Converter={StaticResource BoolToVis}}"/>
                                            <TextBlock Text="　缺 pack.mcmeta" FontSize="10" Foreground="#E74C3C"
                                                       Visibility="{Binding MissingMeta, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource ControlBackground}"
                        BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="10" Margin="0,8,0,0" MaxHeight="140">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="格式告警" FontWeight="Bold" Margin="0,0,0,4"
                                   Foreground="{DynamicResource PrimaryForeground}"/>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding FormatWarnings}">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="#FF9800" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 建议 + 状态 ===== -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <Border Background="{DynamicResource ControlBackground}"
                    BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                    CornerRadius="6" Padding="10,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="处理建议：" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryForeground}"/>
                    <TextBlock Text="{Binding AdviceText}" TextWrapping="Wrap" MaxWidth="760"
                               Foreground="{DynamicResource SecondaryForeground}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding StatusMessage}" Margin="0,6,0,0"
                       Foreground="{DynamicResource StatusForeground}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
