<UserControl x:Class="Chert.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chert.App.ViewModels">
    <UserControl.DataContext>
        <vm:HomeViewModel/>
    </UserControl.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：快速启动 + 统计 -->
            <StackPanel Grid.Column="0">
                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="快速启动" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="选择版本：" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,4"/>
                        <!-- ComboBox 用 DisplayMemberPath；DisplayMemberBinding 是 GridViewColumn 的属性 -->
                        <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" Height="28" Margin="0,0,0,10"/>
                        <Button Content="启动游戏" Command="{Binding LaunchCommand}" Height="36"
                                Background="{DynamicResource AccentBrush}" Foreground="White"
                                FontWeight="Bold" BorderThickness="0"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource StatusForeground}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="游玩统计" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <TextBlock Foreground="{DynamicResource SecondaryForeground}" Text="累计时长"/>
                            <TextBlock Text="{Binding Stats.TotalPlayMinutes, StringFormat={}{0} 分钟}" HorizontalAlignment="Right"/>
                            <TextBlock Foreground="{DynamicResource SecondaryForeground}" Text="本周时长"/>
                            <TextBlock Text="{Binding Stats.WeeklyPlayMinutes, StringFormat={}{0} 分钟}" HorizontalAlignment="Right"/>
                            <TextBlock Foreground="{DynamicResource SecondaryForeground}" Text="启动次数"/>
                            <TextBlock Text="{Binding Stats.LaunchCount}" HorizontalAlignment="Right"/>
                            <TextBlock Foreground="{DynamicResource SecondaryForeground}" Text="崩溃次数"/>
                            <TextBlock Text="{Binding Stats.CrashCount}" HorizontalAlignment="Right"/>
                            <TextBlock Foreground="{DynamicResource SecondaryForeground}" Text="最近版本"/>
                            <TextBlock Text="{Binding Stats.RecentVersion}" HorizontalAlignment="Right"/>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 右：推荐预览 -->
            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="为你推荐" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Recommendations}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="Bold" FontSize="13" Text="{Binding Title}"/>
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryForeground}"
                                                   TextWrapping="Wrap" Margin="0,4,0,0" MaxHeight="40"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" Padding="4,1"
                                                    Visibility="{Binding IsDependencyCompletion, Converter={x:Static vm:VisibilityHelper.BoolToVis}}">
                                                <TextBlock Text="依赖补全" FontSize="10" Foreground="White"/>
                                            </Border>
                                            <TextBlock Text="{Binding CategoryLabel}" Foreground="{DynamicResource SecondaryForeground}"
                                                       FontSize="11" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
