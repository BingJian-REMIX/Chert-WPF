<UserControl x:Class="Chert.App.Views.RedundantCleanView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:theme="clr-namespace:Chert.App.Themes">

    <UserControl.DataContext>

        <vm:RedundantCleanViewModel/>

    </UserControl.DataContext>

    <Grid Margin="12">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">

            <Button Content="{theme:Loc datapack.m81}" Command="{Binding ScanCommand}" Width="70" Padding="0,2"/>

            <Button Content="{theme:Loc clean.m216}" Command="{Binding CleanCommand}" Width="90" Padding="0,2" Margin="8,0,0,0"/>

            <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                          IsChecked="{Binding DeleteDirectly, Mode=TwoWay}"

                          Margin="16,0,4,0" VerticalAlignment="Center"/>

            <TextBlock Text="{theme:Loc clean.m217}" VerticalAlignment="Center"

                       Foreground="{DynamicResource PrimaryForeground}"/>

        </StackPanel>



        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"

                      MaxHeight="420">

            <ListBox ItemsSource="{Binding Files}"

                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                     BorderBrush="{DynamicResource InputBorder}">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalContentAlignment="Center">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="{Binding RelativePath}" FontWeight="Bold" Margin="0,0,12,0"/>

                                <TextBlock Text="{Binding SizeBytes, StringFormat={}{0:N0} B}"

                                           Foreground="{DynamicResource SecondaryForeground}" FontSize="11"/>

                            </StackPanel>

                        </CheckBox>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </ScrollViewer>



        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource StatusForeground}" Margin="0,8,0,0"/>

    </Grid>

</UserControl>

