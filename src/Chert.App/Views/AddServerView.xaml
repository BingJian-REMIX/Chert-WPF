<UserControl x:Class="Chert.App.Views.AddServerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:theme="clr-namespace:Chert.App.Themes">
    <!-- 复用全局模态弹窗样式（ModalOverlayStyle 半透明遮罩 + ModalCardStyle 卡片），
         与 UpdateDialog 视觉一致（bug：此前为裸 StackPanel，暗色下呈黑块）。 -->
    <!-- ★ 圆角裁剪只能在 AllowsTransparency 窗口里做，遮罩**不能**铺满整个矩形窗口：
         ModalScrimBrush（#80000000 半透明黑）铺满矩形时，卡片圆角外就露出黑色直角
         （用户实机截图左上角那截黑边）。改法：外层 Grid 背景透明（全屏遮罩由 GameView
         页面本身承担），遮罩只作为**卡片背后**一层同样圆角的容器 —— 圆角外无任何绘制。
         Effect 置空：DropShadowEffect 在透明窗口里会渲染成方形硬边。 -->
    <Grid Background="Transparent">
        <!-- 垫底：与卡片同色并外扩 1px，圆角外不再透出黑色（半透明黑遮罩会形成深色弧线） -->
        <Border Background="{DynamicResource ControlBackground}" CornerRadius="15"
                Padding="0" Margin="-1"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Style="{StaticResource ModalCardStyle}" MaxWidth="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Effect="{x:Null}">
            <!-- DataContext 由 code-behind 注入（含已有名称/地址的编辑场景），此处不再在 XAML 内实例化，
                 否则会要求 AddServerViewModel 提供无参构造函数（bug #11）。 -->
            <StackPanel Margin="16">
                <TextBlock Text="{theme:Loc server.name}" FontWeight="Bold" Margin="0,0,0,4"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}"/>

                <TextBlock Text="{theme:Loc server.address}" FontWeight="Bold" Margin="0,12,0,4"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="8,5"
                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}"/>

                <TextBlock Text="{Binding Error}" Foreground="#E74C3C" FontSize="12" Margin="0,8,0,0"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button x:Name="CancelButton" Content="{theme:Loc btn.cancel}" Width="72" Padding="0,4" Margin="0,0,8,0"/>
                    <Button x:Name="OkButton" Content="{theme:Loc btn.ok}" Width="72" Padding="0,4"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
