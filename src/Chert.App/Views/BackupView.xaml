<UserControl x:Class="Chert.App.Views.BackupView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:theme="clr-namespace:Chert.App.Themes">

    <UserControl.DataContext>

        <vm:BackupViewModel/>

    </UserControl.DataContext>



    <Grid Margin="12">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>   <!-- 策略 -->

            <RowDefinition Height="Auto"/>   <!-- 手动备份 -->

            <RowDefinition Height="*"/>      <!-- 列表 -->

            <RowDefinition Height="Auto"/>   <!-- 状态 -->

        </Grid.RowDefinitions>



        <!-- ===== 备份策略 ===== -->

        <Border Grid.Row="0" Background="{DynamicResource ControlBackground}"

                BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"

                CornerRadius="8" Padding="12" Margin="0,0,0,10">

            <StackPanel>

                <TextBlock Text="{theme:Loc backup.m45}" FontWeight="Bold"

                           Foreground="{DynamicResource PrimaryForeground}" Margin="0,0,0,8"/>



                <!-- 存储路径 -->

                <Grid Margin="0,0,0,8">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{theme:Loc backup.m46}" VerticalAlignment="Center" Width="72"

                               Foreground="{DynamicResource SecondaryForeground}"/>

                    <TextBox Grid.Column="1" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}"

                             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                             BorderBrush="{DynamicResource InputBorder}" Padding="6,3" VerticalContentAlignment="Center"

                             ToolTip="{theme:Loc backup.m47}"/>

                    <Button Grid.Column="2" Content="{theme:Loc backup.m48}" Command="{Binding BrowseFolderCommand}"

                            Width="68" Padding="0,3" Margin="8,0,0,0"/>

                    <Button Grid.Column="3" Content="{theme:Loc backup.m49}" Command="{Binding OpenFolderCommand}"

                            Width="78" Padding="0,3" Margin="6,0,0,0"/>

                </Grid>



                <!-- 频率 / 数量 / 天数 -->

                <WrapPanel Margin="0,0,0,8">

                    <TextBlock Text="{theme:Loc backup.m50}" VerticalAlignment="Center" Width="72"

                               Foreground="{DynamicResource SecondaryForeground}"/>

                    <ComboBox ItemsSource="{Binding Schedules}" SelectedItem="{Binding SelectedSchedule}"

                              Width="96" Margin="0,0,20,0"/>



                    <TextBlock Text="{theme:Loc backup.m51}" VerticalAlignment="Center" Margin="0,0,6,0"

                               Foreground="{DynamicResource SecondaryForeground}"/>

                    <TextBox Text="{Binding KeepPerSource}" Width="52" Padding="6,3"

                             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                             BorderBrush="{DynamicResource InputBorder}"

                             ToolTip="{theme:Loc backup.m52}"/>

                    <TextBlock Text="{theme:Loc backup.m53}" VerticalAlignment="Center" Margin="4,0,20,0"

                               Foreground="{DynamicResource SecondaryForeground}"/>



                    <TextBlock Text="{theme:Loc backup.m54}" VerticalAlignment="Center" Margin="0,0,6,0"

                               Foreground="{DynamicResource SecondaryForeground}"/>

                    <TextBox Text="{Binding MaxAgeDays}" Width="52" Padding="6,3"

                             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                             BorderBrush="{DynamicResource InputBorder}"

                             ToolTip="{theme:Loc backup.m55}"/>

                    <TextBlock Text="{theme:Loc backup.m56}" VerticalAlignment="Center" Margin="4,0,0,0"

                               Foreground="{DynamicResource SecondaryForeground}"/>

                </WrapPanel>



                <!-- 开关（规格 1.4：一律使用滑动开关） -->

                <WrapPanel>

                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                  IsChecked="{Binding BackupBeforeRestore, Mode=TwoWay}"/>

                    <TextBlock Text="{theme:Loc backup.m57}" VerticalAlignment="Center" Margin="8,0,24,0"

                               Foreground="{DynamicResource PrimaryForeground}"/>



                    <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                                  IsChecked="{Binding AutoBeforeLaunch, Mode=TwoWay}"/>

                    <TextBlock Text="{theme:Loc backup.m58}" VerticalAlignment="Center" Margin="8,0,24,0"

                               Foreground="{DynamicResource PrimaryForeground}"/>



                    <Button Content="{theme:Loc backup.m59}" Command="{Binding SavePolicyCommand}"

                            Style="{StaticResource PrimaryButtonStyle}" Padding="14,4"/>

                </WrapPanel>

            </StackPanel>

        </Border>



        <!-- ===== 手动备份 ===== -->

        <Grid Grid.Row="1" Margin="0,0,0,10">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="220"/>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>



            <TextBlock Grid.Column="0" Text="{theme:Loc backup.m60}" VerticalAlignment="Center" Width="72"

                       Foreground="{DynamicResource SecondaryForeground}"/>

            <ComboBox Grid.Column="1" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"

                      DisplayMemberPath="Display"/>



            <TextBlock Grid.Column="2" Text="{theme:Loc backup.m61}" VerticalAlignment="Center" Margin="16,0,6,0"

                       Foreground="{DynamicResource SecondaryForeground}"/>

            <TextBox Grid.Column="3" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"

                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                     BorderBrush="{DynamicResource InputBorder}" Padding="6,3" VerticalContentAlignment="Center"

                     ToolTip="{theme:Loc backup.m62}"/>



            <Button Grid.Column="4" Content="{theme:Loc backup.m63}" Command="{Binding CreateCommand}"

                    Style="{StaticResource PrimaryButtonStyle}" Padding="14,4" Margin="10,0,0,0"/>

            <Button Grid.Column="5" Content="{theme:Loc mods.refresh}" Command="{Binding RefreshCommand}"

                    Width="60" Padding="0,4" Margin="6,0,0,0"/>

        </Grid>



        <!-- ===== 备份列表 ===== -->

        <Border Grid.Row="2" BorderBrush="{DynamicResource ListViewBorder}" BorderThickness="1" CornerRadius="6">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>



                <!-- 表头 -->

                <Grid Grid.Row="0" Background="{DynamicResource ListViewHeaderBackground}" Height="28">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="160"/>

                        <ColumnDefinition Width="60"/>

                        <ColumnDefinition Width="130"/>

                        <ColumnDefinition Width="80"/>

                        <ColumnDefinition Width="70"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{theme:Loc backup.m64}" Margin="10,0,0,0" VerticalAlignment="Center"

                               FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

                    <TextBlock Grid.Column="1" Text="{theme:Loc backup.m65}" VerticalAlignment="Center"

                               FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

                    <TextBlock Grid.Column="2" Text="{theme:Loc backup.m66}" VerticalAlignment="Center"

                               FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

                    <TextBlock Grid.Column="3" Text="{theme:Loc backup.m67}" VerticalAlignment="Center"

                               FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

                    <TextBlock Grid.Column="4" Text="{theme:Loc backup.m68}" VerticalAlignment="Center"

                               FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

                    <TextBlock Grid.Column="5" Text="{theme:Loc backup.m61}" VerticalAlignment="Center"

                               FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

                </Grid>



                <ListBox Grid.Row="1" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}"

                         Background="{DynamicResource ListViewBackground}" BorderThickness="0"

                         HorizontalContentAlignment="Stretch"

                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Grid Height="26">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="160"/>

                                    <ColumnDefinition Width="60"/>

                                    <ColumnDefinition Width="130"/>

                                    <ColumnDefinition Width="80"/>

                                    <ColumnDefinition Width="70"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding SourceName}" VerticalAlignment="Center"

                                           TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>

                                <TextBlock Grid.Column="1" Text="{Binding Kind}" VerticalAlignment="Center" FontSize="11"/>

                                <TextBlock Grid.Column="2" Text="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}"

                                           VerticalAlignment="Center" FontSize="11"/>

                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" VerticalAlignment="Center" FontSize="11"/>

                                <TextBlock Grid.Column="4" Text="{Binding FileCount}" VerticalAlignment="Center" FontSize="11"/>

                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">

                                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="3"

                                            Padding="4,0" Margin="0,0,6,0"

                                            Visibility="{Binding Auto, Converter={StaticResource BoolToVis}}">

                                        <TextBlock Text="{theme:Loc settings.dl_mirror_auto}" FontSize="10" Foreground="White"/>

                                    </Border>

                                    <TextBlock Text="{Binding Note}" FontSize="11" TextTrimming="CharacterEllipsis"

                                               Foreground="{DynamicResource SecondaryForeground}"/>

                                </StackPanel>

                            </Grid>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>



                <!-- 操作行 -->

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,6,10,8">

                    <Button Content="{theme:Loc backup.m69}" Command="{Binding RestoreCommand}" Width="86" Padding="0,3"/>

                    <Button Content="{theme:Loc backup.m70}" Command="{Binding DeleteCommand}" Width="86" Padding="0,3" Margin="8,0,0,0"/>

                    <Button Content="{theme:Loc backup.m71}" Command="{Binding PruneCommand}" Width="96" Padding="0,3" Margin="8,0,0,0"/>

                    <TextBlock Text="{Binding TotalText}" VerticalAlignment="Center" Margin="16,0,0,0"

                               FontSize="11" Foreground="{DynamicResource SecondaryForeground}"

                               TextTrimming="CharacterEllipsis"/>

                </StackPanel>

            </Grid>

        </Border>



        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="0,8,0,0"

                   Foreground="{DynamicResource StatusForeground}" TextWrapping="Wrap"/>

    </Grid>

</UserControl>

