<UserControl x:Class="Chert.App.Views.ModpackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chert.App.ViewModels">
    <UserControl.DataContext>
        <vm:ModpackViewModel/>
    </UserControl.DataContext>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 导出 -->
        <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="导出整合包" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                          Width="220" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                          BorderBrush="{DynamicResource InputBorder}"/>
                <Button Content="刷新" Command="{Binding RefreshCommand}" Width="60" Margin="8,0,0,0" Padding="0,2"/>
            </StackPanel>
            <TextBlock Text="显示名称（可选）" Foreground="{DynamicResource SecondaryForeground}" Margin="0,4,0,4"/>
            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                     BorderBrush="{DynamicResource InputBorder}"/>
            <WrapPanel Margin="0,2">
                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding IncludeMods, Mode=TwoWay}"/>
                <TextBlock Text="包含 Mods" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{DynamicResource PrimaryForeground}"/>
            </WrapPanel>
            <WrapPanel Margin="0,2">
                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding IncludeConfig, Mode=TwoWay}"/>
                <TextBlock Text="包含 Config" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{DynamicResource PrimaryForeground}"/>
            </WrapPanel>
            <WrapPanel Margin="0,2">
                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding IncludeResourcePacks, Mode=TwoWay}"/>
                <TextBlock Text="包含 资源包" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{DynamicResource PrimaryForeground}"/>
            </WrapPanel>
            <WrapPanel Margin="0,2">
                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding IncludeShaderPacks, Mode=TwoWay}"/>
                <TextBlock Text="包含 光影包" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{DynamicResource PrimaryForeground}"/>
            </WrapPanel>
            <WrapPanel Margin="0,2">
                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding IncludeSaves, Mode=TwoWay}"/>
                <TextBlock Text="包含 存档" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{DynamicResource PrimaryForeground}"/>
            </WrapPanel>
            <Button Content="导出…" Command="{Binding ExportCommand}" Width="100" HorizontalAlignment="Left" Margin="0,10,0,0"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="0,4"/>
        </StackPanel>

        <!-- 导入 -->
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="导入整合包" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="支持 Modrinth .mrpack 整合包。" Foreground="{DynamicResource SecondaryForeground}"
                       TextWrapping="Wrap" Margin="0,0,0,10"/>
            <Button Content="选择文件并导入…" Command="{Binding ImportCommand}" Width="160" HorizontalAlignment="Left"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="0,4"/>
        </StackPanel>

        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource StatusForeground}" Margin="0,16,0,0"
                   VerticalAlignment="Bottom"/>
    </Grid>
</UserControl>
