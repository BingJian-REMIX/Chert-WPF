<UserControl x:Class="Chert.App.Views.ModpackView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:theme="clr-namespace:Chert.App.Themes">

    <UserControl.DataContext>

        <vm:ModpackViewModel/>

    </UserControl.DataContext>

    <Grid Margin="12">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="*"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>



        <!-- 导出 -->

        <StackPanel Grid.Column="0" Margin="0,0,8,0">

            <TextBlock Text="{theme:Loc modpack.m170}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">

                <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"

                          Width="220" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                          BorderBrush="{DynamicResource InputBorder}"/>

                <Button Content="{theme:Loc mods.refresh}" Command="{Binding RefreshCommand}" Width="60" Margin="8,0,0,0" Padding="0,2"/>

            </StackPanel>

            <TextBlock Text="{theme:Loc modpack.m171}" Foreground="{DynamicResource SecondaryForeground}" Margin="0,4,0,4"/>

            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"

                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                     BorderBrush="{DynamicResource InputBorder}"/>

            <WrapPanel Margin="0,2">

                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                              IsChecked="{Binding IncludeMods, Mode=TwoWay}"/>

                <TextBlock Text="{theme:Loc modpack.m172}" VerticalAlignment="Center" Margin="8,0,0,0"

                           Foreground="{DynamicResource PrimaryForeground}"/>

            </WrapPanel>

            <WrapPanel Margin="0,2">

                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                              IsChecked="{Binding IncludeConfig, Mode=TwoWay}"/>

                <TextBlock Text="{theme:Loc modpack.m173}" VerticalAlignment="Center" Margin="8,0,0,0"

                           Foreground="{DynamicResource PrimaryForeground}"/>

            </WrapPanel>

            <WrapPanel Margin="0,2">

                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                              IsChecked="{Binding IncludeResourcePacks, Mode=TwoWay}"/>

                <TextBlock Text="{theme:Loc modpack.m174}" VerticalAlignment="Center" Margin="8,0,0,0"

                           Foreground="{DynamicResource PrimaryForeground}"/>

            </WrapPanel>

            <WrapPanel Margin="0,2">

                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                              IsChecked="{Binding IncludeShaderPacks, Mode=TwoWay}"/>

                <TextBlock Text="{theme:Loc modpack.m175}" VerticalAlignment="Center" Margin="8,0,0,0"

                           Foreground="{DynamicResource PrimaryForeground}"/>

            </WrapPanel>

            <WrapPanel Margin="0,2">

                <ToggleButton Style="{StaticResource ToggleSwitchStyle}"

                              IsChecked="{Binding IncludeSaves, Mode=TwoWay}"/>

                <TextBlock Text="{theme:Loc modpack.m176}" VerticalAlignment="Center" Margin="8,0,0,0"

                           Foreground="{DynamicResource PrimaryForeground}"/>

            </WrapPanel>

            <Button Content="{theme:Loc modpack.m177}" Command="{Binding ExportCommand}" Width="100" HorizontalAlignment="Left" Margin="0,10,0,0"

                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="0,4"/>

        </StackPanel>



        <!-- 导入 -->

        <StackPanel Grid.Column="1" Margin="8,0,0,0">

            <TextBlock Text="{theme:Loc modpack.m178}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <TextBlock Text="{theme:Loc modpack.m179}" Foreground="{DynamicResource SecondaryForeground}"

                       TextWrapping="Wrap" Margin="0,0,0,10"/>

            <Button Content="{theme:Loc modpack.m180}" Command="{Binding ImportCommand}" Width="160" HorizontalAlignment="Left"

                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="0,4"/>

        </StackPanel>



        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding StatusMessage}"

                   Foreground="{DynamicResource StatusForeground}" Margin="0,16,0,0"

                   VerticalAlignment="Bottom"/>

    </Grid>

</UserControl>

