<Window x:Class="Chert.App.Views.CrashReportView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        xmlns:theme="clr-namespace:Chert.App.Themes"
        Title="{theme:Loc crash.view.title}" Width="760" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ModalScrimBrush}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <!-- 主卡片：复用已定义的 ModalCardStyle（暗色底 / 圆角 / 阴影） -->
    <Border x:Name="Card" Style="{StaticResource ModalCardStyle}" MaxWidth="720"
            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding ExceptionType}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="1" Text="{Binding Summary}" Margin="0,8,0,4" TextWrapping="Wrap" Foreground="#CC3333"/>

            <!-- 修复面板：仅当可自动修复时显示 -->
            <Border Grid.Row="2" Margin="0,4,0,8" Padding="10"
                    BorderBrush="#3A7B4F" BorderThickness="1" CornerRadius="4"
                    Background="#1A2E20" Visibility="{Binding CanRepair, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="{Binding RepairTitle}" FontWeight="Bold" FontSize="13"/>
                    <TextBlock Text="{Binding RepairDescription}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <ItemsControl ItemsSource="{Binding RepairSteps}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="8,2,0,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 冲突 Mod：请用户选择保留哪一个 -->
                    <StackPanel Visibility="{Binding IsConflictPlan, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                        <TextBlock Text="{theme:Loc crash.keep_mod_hint}" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding ConflictingMods}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Content="{Binding Name}" GroupName="keepMod"
                                                 IsChecked="{Binding IsKeepSelected, Mode=TwoWay}" Margin="8,2,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- 缺失前置：将自动安装 -->
                    <StackPanel Visibility="{Binding IsMissingDepPlan, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                        <TextBlock Text="{theme:Loc crash.missing_dep_hint}" FontWeight="Bold"/>
                        <ItemsControl ItemsSource="{Binding MissingDependencies}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='• {0}'}" Margin="8,2,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- §四.2 降级联动恢复面板：崩溃疑似由存档降级引起时显示 -->
                    <StackPanel Visibility="{Binding HasDowngradeRecovery, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                        <Border BorderBrush="#B5893A" BorderThickness="1" CornerRadius="4" Padding="10" Background="#2E261A">
                            <StackPanel>
                                <TextBlock Text="{theme:Loc crash.downgrade_cause}" FontWeight="Bold" FontSize="13" Foreground="#E0B070"/>
                                <TextBlock Text="{Binding DowngradeRecoveryReason}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="{theme:Loc crash.revert_backup}" Command="{Binding DowngradeRecoveryCommand}"
                                            CommandParameter="RevertBackup" Width="120" Margin="0,0,8,0" Padding="0,4"/>
                                    <Button Content="{theme:Loc crash.retry_other}" Command="{Binding DowngradeRecoveryCommand}"
                                            CommandParameter="RetryOther" Width="120" Margin="0,0,8,0" Padding="0,4"/>
                                    <Button Content="{theme:Loc crash.install_original}" Command="{Binding DowngradeRecoveryCommand}"
                                            CommandParameter="InstallOriginal" Width="130" Padding="0,4"/>
                                </StackPanel>
                                <TextBlock Text="{theme:Loc crash.downgrade_note}"
                                           FontStyle="Italic" FontSize="11" Margin="0,6,0,0" Foreground="#C0A070"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding NonDestructiveNote}" FontStyle="Italic" FontSize="11" Margin="0,6,0,0" Foreground="#8Fb89c"/>
                    <Button Content="{theme:Loc crash.btn_repair}" Command="{Binding TryRepairCommand}"
                            Width="140" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="0,4"/>
                </StackPanel>
            </Border>

            <TabControl Grid.Row="3">
                <TabItem Header="{theme:Loc crash.tab.causes}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4">
                            <TextBlock Text="{theme:Loc crash.causes_label}" FontWeight="Bold"/>
                            <ItemsControl ItemsSource="{Binding Causes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="8,2,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{theme:Loc crash.suggestions_label}" FontWeight="Bold" Margin="0,8,0,0"/>
                            <ItemsControl ItemsSource="{Binding Suggestions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="8,2,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{theme:Loc crash.tab.full}" IsEnabled="{Binding HasReport}">
                    <TextBox Text="{Binding RawReport, Mode=OneWay}" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="4" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{DynamicResource StatusForeground}"/>
                <Button Grid.Column="1" Content="{theme:Loc btn.close}" Width="80" Padding="0,4"
                        Click="CloseButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
