<UserControl x:Class="Chert.App.Views.CommandView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chert.App.ViewModels">
    <UserControl.DataContext>
        <vm:CommandViewModel/>
    </UserControl.DataContext>
    <ScrollViewer Margin="18">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="常用语法表" FontWeight="Bold" FontSize="15"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <ListBox x:Name="RefList" ItemsSource="{Binding Reference}"
                         Background="{DynamicResource InputBackground}"
                         BorderBrush="{DynamicResource InputBorder}"
                         MaxHeight="280" Margin="0,8,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Syntax}" Margin="12,0"
                                           FontFamily="Consolas,Monospace" FontSize="12"
                                           Foreground="{DynamicResource SecondaryForeground}" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="插入" Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding ElementName=RefList, Path=DataContext.InsertCommand}"
                                        CommandParameter="{Binding Syntax}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <StackPanel>
                <TextBlock Text="命令拼接 / 编辑" FontWeight="Bold" FontSize="15"
                           Foreground="{DynamicResource PrimaryForeground}"/>
                <TextBox Text="{Binding Composed}" AcceptsReturn="True" Height="90"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas,Monospace" Margin="0,8,0,0"
                         Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="复制到剪贴板" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CopyCommand}"/>
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0"
                               Foreground="{DynamicResource SecondaryForeground}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
