<UserControl x:Class="Chert.App.Views.DownloadCenterView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:theme="clr-namespace:Chert.App.Themes" Foreground="{DynamicResource PrimaryForeground}">

    <UserControl.DataContext>

        <vm:DownloadCenterViewModel/>

    </UserControl.DataContext>

    <Grid Margin="12">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="160"/>

        </Grid.RowDefinitions>



        <TextBlock Grid.Row="0" Text="{theme:Loc dl.m108}" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>



        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">

            <TextBox Width="240" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" ToolTip="{theme:Loc dl.m109}"/>

            <Button Content="{theme:Loc mods.search}" Command="{Binding SearchCommand}" Margin="8,0,0,0" Padding="8,2"/>

            <ComboBox Width="120" Margin="8,0,0,0" ItemsSource="{Binding Loaders}" SelectedValue="{Binding SelectedLoader}" SelectedValuePath="." ToolTip="{theme:Loc dev.m97}"/>

            <ComboBox Width="120" Margin="8,0,0,0"

                      ItemsSource="{Binding GameVersions}"

                      DisplayMemberPath="Display"

                      SelectedValuePath="Id"

                      SelectedValue="{Binding SelectedGameVersion}"

                      ToolTip="{theme:Loc dev.m98}"/>

            <ComboBox Width="140" Margin="8,0,0,0" ItemsSource="{Binding ProjectTypes}" SelectedValue="{Binding SelectedProjectType}" SelectedValuePath="." ToolTip="{theme:Loc backup.m65}"/>

        </StackPanel>



        <ListBox Grid.Row="2" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"

                 ScrollViewer.VerticalScrollBarVisibility="Auto"

                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}" BorderBrush="{DynamicResource InputBorder}">

            <ListBox.ItemTemplate>

                <DataTemplate>

                    <StackPanel Margin="4">

                        <TextBlock Text="{Binding Title}" FontWeight="Bold"/>

                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.7"/>

                    </StackPanel>

                </DataTemplate>

            </ListBox.ItemTemplate>

        </ListBox>



        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">

            <Button Content="{theme:Loc dl.m110}" Command="{Binding EnqueueCommand}" Width="100" Padding="0,4"/>

            <Button Content="{theme:Loc dl.m111}" Command="{Binding StartQueueCommand}" Width="120" Margin="8,0,0,0" Padding="0,4"

                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"/>

            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"/>

            <Button Content="{theme:Loc dl.m112}" Command="{Binding ClearCompletedCommand}" Width="100" Margin="12,0,0,0" Padding="0,4"/>

        </StackPanel>



        <!-- 清单 #67：下载队列管理（暂停 / 继续 / 限速 / 失败重试） -->
        <WrapPanel Grid.Row="4" Orientation="Horizontal" Margin="0,6,0,0">

            <Button Content="{theme:Loc dl.pause_all}" Command="{Binding PauseAllCommand}" Width="90" Padding="0,4"/>

            <Button Content="{theme:Loc dl.resume_all}" Command="{Binding ResumeAllCommand}" Width="90" Margin="8,0,0,0" Padding="0,4"/>

            <TextBlock Text="{theme:Loc dl.speed_limit}" VerticalAlignment="Center" Margin="16,0,6,0"
                       Foreground="{DynamicResource PrimaryForeground}"/>

            <ComboBox Width="110" ItemsSource="{Binding SpeedLimitChoices}" SelectedItem="{Binding SpeedLimitKbps, Mode=TwoWay}"
                      ToolTip="{theme:Loc dl.speed_limit_tip}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat={}{0} KB/s}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="{theme:Loc dl.auto_retry}" VerticalAlignment="Center" Margin="16,0,6,0"
                       Foreground="{DynamicResource PrimaryForeground}"/>

            <ComboBox Width="70" ItemsSource="{Binding RetryChoices}" SelectedItem="{Binding AutoRetryCount, Mode=TwoWay}"/>

            <TextBlock Text="{Binding QueuePausedText}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource AccentBrush}"/>

        </WrapPanel>



        <ListBox Grid.Row="5" ItemsSource="{Binding Queue}" Margin="0,8,0,0"

                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}" BorderBrush="{DynamicResource InputBorder}">

            <ListBox.ItemTemplate>

                <DataTemplate>

                    <Grid Margin="2">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="120"/>

                            <ColumnDefinition Width="56"/>

                            <ColumnDefinition Width="56"/>

                            <ColumnDefinition Width="56"/>

                            <ColumnDefinition Width="56"/>

                            <ColumnDefinition Width="56"/>

                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">

                            <TextBlock FontWeight="Bold" Text="{Binding Title}"/>

                            <Grid Height="22" Margin="0,2,0,0">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <!-- bug.txt #7：细环形进度条（对齐 Linux 的 Ellipse+Arc 细环） -->

                                <Grid Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0">

                                    <Ellipse Width="18" Height="18" Stroke="{DynamicResource ProgressBackground}"

                                             StrokeThickness="2.5"/>

                                    <Ellipse Width="18" Height="18" Stroke="{DynamicResource AccentBrush}"

                                             StrokeThickness="2.5" StrokeEndLineCap="Round"

                                             StrokeDashArray="{Binding Progress, Converter={StaticResource ProgressToRingDash}, ConverterParameter=56.55}">

                                        <Ellipse.RenderTransform>

                                            <RotateTransform Angle="-90" CenterX="9" CenterY="9"/>

                                        </Ellipse.RenderTransform>

                                    </Ellipse>

                                    <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" FontSize="8"

                                               HorizontalAlignment="Center" VerticalAlignment="Center"

                                               Foreground="{DynamicResource AccentBrush}"/>

                                </Grid>

                                <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center"

                                           TextTrimming="CharacterEllipsis" Opacity="0.8"/>

                            </Grid>

                        </StackPanel>

                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis">

                            <Run Text="{Binding Status, Mode=OneWay}"/>

                            <Run Text="{Binding AttemptsText, Mode=OneWay}" Foreground="{DynamicResource SecondaryForeground}"/>

                        </TextBlock>

                        <Button Grid.Column="2" Content="{theme:Loc dl.pause}" Command="{Binding DataContext.PauseItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                CommandParameter="{Binding}" Padding="2" Margin="4,0"

                                Visibility="{Binding CanPause, Converter={StaticResource BoolToVis}}"/>

                        <Button Grid.Column="3" Content="{theme:Loc dl.resume}" Command="{Binding DataContext.ResumeItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                CommandParameter="{Binding}" Padding="2" Margin="4,0"

                                Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"/>

                        <Button Grid.Column="4" Content="{theme:Loc dl.retry}" Command="{Binding DataContext.RetryItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                CommandParameter="{Binding}" Padding="2" Margin="4,0"

                                Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}"/>

                        <Button Grid.Column="5" Content="{theme:Loc btn.cancel}" Command="{Binding DataContext.CancelItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                CommandParameter="{Binding}" Padding="2"/>

                        <Button Grid.Column="6" Content="{theme:Loc mods.remove}" Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                CommandParameter="{Binding}" Padding="2"/>

                    </Grid>

                </DataTemplate>

            </ListBox.ItemTemplate>

        </ListBox>

    </Grid>

</UserControl>

