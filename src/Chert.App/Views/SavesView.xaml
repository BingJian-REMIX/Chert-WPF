<UserControl x:Class="Chert.App.Views.SavesView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:theme="clr-namespace:Chert.App.Themes">

    <UserControl.DataContext>

        <vm:SavesViewModel/>

    </UserControl.DataContext>

    <Grid Margin="12">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">

            <TextBlock Text="{theme:Loc saves.m218}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>

            <TextBlock Text="{theme:Loc saves.m219}" VerticalAlignment="Center" Margin="16,0,4,0"/>

            <ComboBox ItemsSource="{Binding AvailableVersions}"

                      SelectedItem="{Binding TargetVersion, Mode=TwoWay}"

                      Width="140" VerticalAlignment="Center"/>

            <Button Content="{theme:Loc saves.m220}" Command="{Binding ScanCommand}" Width="100" Margin="12,0,4,0" Padding="0,2"/>

            <Button Content="{theme:Loc saves.m221}" Command="{Binding ScanCorruptionCommand}" Width="80" Margin="0,0,4,0" Padding="0,2"/>

            <TextBlock Text="{theme:Loc saves.m222}" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0"/>

        </StackPanel>



        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource StatusForeground}" Margin="0,0,0,4"/>



        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Saves}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,4">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="10"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>



                                <Rectangle Grid.Column="0" Fill="{Binding SeverityColor}" RadiusX="2" RadiusY="2"/>



                                <StackPanel Grid.Column="1" Margin="8,0,0,0">

                                    <TextBlock FontWeight="Bold" FontSize="13"><Run Text="{Binding SaveName}"/><Run Text="   "/><Run Text="📁 " Foreground="#7AB8FF" FontSize="11"/><Run Text="{Binding Location}" Foreground="#7AB8FF" FontSize="11"/></TextBlock>

                                    <TextBlock Margin="0,2,0,0">

                                        <Run Text="{theme:Loc saves.m223}"/>

                                        <Run Text="{Binding CurrentVersion}"/>

                                        <Run Text="  (dv="/>

                                        <Run Text="{Binding DataVersion}"/>

                                        <Run Text=")"/>

                                    </TextBlock>

                                    <TextBlock Text="{Binding CompatText}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="#BBB"/>

                                    <TextBlock Margin="0,2,0,0" Foreground="#8FA">

                                        <Run Text="{theme:Loc saves.m224}"/>

                                        <Run Text="{Binding BackupText}"/>

                                    </TextBlock>

                                    <TextBlock Margin="0,2,0,0" Foreground="{Binding CorruptionColor}">

                                        <Run Text="{theme:Loc saves.m225}"/>

                                        <Run Text="{Binding CorruptionText}"/>

                                    </TextBlock>

                                </StackPanel>



                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                                    <Button Content="🌱" Padding="6,2" Margin="0,0,6,0"

                                            ToolTip="{theme:Loc saves.m226}"

                                            Command="{Binding DataContext.ExtractSeedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                            CommandParameter="{Binding SavePath}"/>

                                    <Button Content="{theme:Loc saves.m227}" Padding="6,2" Margin="0,0,6,0"

                                            Command="{Binding DataContext.BackupSaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                            CommandParameter="{Binding SavePath}"/>

                                    <Button Content="{theme:Loc saves.m228}" Padding="6,2" Margin="0,0,6,0"

                                            Command="{Binding DataContext.DowngradeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                            CommandParameter="{Binding SavePath}"/>

                                    <Button Content="{theme:Loc saves.m229}" Padding="6,2" Margin="0,0,6,0"

                                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                            CommandParameter="{Binding SavePath}"/>

                                    <Button Content="{theme:Loc btn.delete}" Padding="6,2"

                                            Command="{Binding DataContext.DeleteSaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"

                                            CommandParameter="{Binding SavePath}"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</UserControl>

