<UserControl x:Class="Chert.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:theme="clr-namespace:Chert.App.Themes">
    <UserControl.DataContext>
        <vm:MapViewModel/>
    </UserControl.DataContext>
    <ScrollViewer Margin="18">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{theme:Loc tool.map}" FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryForeground}" Margin="0,0,0,14"/>

            <TextBlock Text="{theme:Loc map.m165}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding ZipPath}" Margin="0,0,8,0"
                         Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}"/>
                <Button Grid.Column="1" Content="{theme:Loc backup.m48}" Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,8,0" Command="{Binding SelectFileCommand}"/>
                <Button Grid.Column="2" Content="{theme:Loc btn.install}" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding InstallCommand}"/>
            </Grid>
            <TextBlock Text="{theme:Loc map.zip_hint}"
                       FontSize="11" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,8"/>

            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryForeground}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
