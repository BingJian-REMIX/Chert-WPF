<UserControl x:Class="Chert.App.Views.PerfView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"

             xmlns:controls="clr-namespace:Chert.App.Controls"
             xmlns:theme="clr-namespace:Chert.App.Themes">

    <UserControl.DataContext>

        <vm:PerfViewModel/>

    </UserControl.DataContext>

    <Grid Margin="12">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">

            <TextBlock Text="{theme:Loc perf.m208}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>

            <Button Content="{theme:Loc mods.refresh}" Command="{Binding RefreshCommand}" Width="70" Margin="16,0,0,0" Padding="0,2"/>

        </StackPanel>



        <!-- bug2.txt #7：实时折线图 -->

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,10">

            <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,6,0">

                <StackPanel>

                    <Grid>

                        <TextBlock Foreground="{DynamicResource SecondaryForeground}" Text="{theme:Loc perf.m209}"/>

                        <TextBlock HorizontalAlignment="Right" FontSize="22" FontWeight="Bold"

                                   Foreground="{DynamicResource AccentBrush}" Text="{Binding CpuUsageText}"/>

                    </Grid>

                    <Border Height="120" Margin="0,8,0,0">

                        <controls:MiniChart Values="{Binding CpuHistory}" Max="100"

                                            Stroke="{DynamicResource AccentBrush}" Fill="{DynamicResource AccentBrush}"/>

                    </Border>

                </StackPanel>

            </Border>

            <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="6,0,0,0">

                <StackPanel>

                    <Grid>

                        <TextBlock Foreground="{DynamicResource SecondaryForeground}" Text="{theme:Loc perf.m210}"/>

                        <TextBlock HorizontalAlignment="Right" FontSize="22" FontWeight="Bold"

                                   Foreground="#5BC0BE" Text="{Binding MemUsedText}"/>

                    </Grid>

                    <Border Height="120" Margin="0,8,0,0">

                        <controls:MiniChart Values="{Binding MemHistory}" Max="100"

                                            Stroke="#5BC0BE" Fill="#5BC0BE"/>

                    </Border>

                </StackPanel>

            </Border>

        </UniformGrid>



        <!-- 概要卡片 -->

        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,10">

            <Border Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="10" Margin="0,0,6,0">

                <StackPanel>

                    <TextBlock Foreground="{DynamicResource SecondaryForeground}" Text="{theme:Loc perf.m211}"/>

                    <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Instances.Count}"/>

                </StackPanel>

            </Border>

            <Border Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="10" Margin="6,0,6,0">

                <StackPanel>

                    <TextBlock Foreground="{DynamicResource SecondaryForeground}" Text="{theme:Loc perf.m212}"/>

                    <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding ProcessorCount}"/>

                </StackPanel>

            </Border>

            <Border Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="10" Margin="6,0,6,0">

                <StackPanel>

                    <TextBlock Foreground="{DynamicResource SecondaryForeground}" Text="{theme:Loc perf.m213}"/>

                    <TextBlock FontSize="14" FontWeight="Bold" Text="{Binding MemoryUsageText}"/>

                </StackPanel>

            </Border>

            <Border Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="10" Margin="6,0,0,0">

                <StackPanel>

                    <TextBlock Foreground="{DynamicResource SecondaryForeground}" Text="{theme:Loc perf.m214}"/>

                    <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding Stats.TotalPlayMinutes}"/>

                </StackPanel>

            </Border>

        </UniformGrid>



        <!-- 逐实例实时资源表 -->

        <ListView Grid.Row="3" ItemsSource="{Binding Instances}"

                  Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                  BorderBrush="{DynamicResource InputBorder}">

            <ListView.Resources>

                <Style TargetType="GridViewColumnHeader">

                    <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}"/>

                    <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>

                    <Setter Property="Padding" Value="6,3"/>

                </Style>

            </ListView.Resources>

            <ListView.View>

                <GridView>

                    <GridViewColumn Header="{theme:Loc about.version}" Width="170" DisplayMemberBinding="{Binding VersionId}"/>

                    <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Pid}"/>

                    <GridViewColumn Header="CPU" Width="70" DisplayMemberBinding="{Binding CpuText}"/>

                    <GridViewColumn Header="{theme:Loc lbl.memory}" Width="100" DisplayMemberBinding="{Binding MemoryText}"/>

                    <GridViewColumn Header="{theme:Loc perf.m215}" Width="170" DisplayMemberBinding="{Binding StartedUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>

                </GridView>

            </ListView.View>

        </ListView>

    </Grid>

</UserControl>

