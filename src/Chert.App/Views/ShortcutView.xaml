<UserControl x:Class="Chert.App.Views.ShortcutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:theme="clr-namespace:Chert.App.Themes">
    <UserControl.DataContext>
        <vm:ShortcutViewModel/>
    </UserControl.DataContext>
    <Grid Margin="12">
        <StackPanel Width="360" HorizontalAlignment="Left">
            <TextBlock Text="{theme:Loc shortcut.title}" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock Text="{theme:Loc about.version}" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                      Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                      BorderBrush="{DynamicResource InputBorder}" Margin="0,0,0,8"/>
            <TextBlock Text="{theme:Loc shortcut.display_name}" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,4"/>
            <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                     Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                     BorderBrush="{DynamicResource InputBorder}"/>
            <Button Content="{theme:Loc shortcut.m254}" Command="{Binding CreateCommand}" Width="120" HorizontalAlignment="Left"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Padding="0,4"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource StatusForeground}" Margin="0,12,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{theme:Loc shortcut.tip}"
                       Foreground="{DynamicResource SecondaryForeground}" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</UserControl>
