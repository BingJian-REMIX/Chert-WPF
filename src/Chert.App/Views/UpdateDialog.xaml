<Window x:Class="Chert.App.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Chert.App.Views"
        xmlns:theme="clr-namespace:Chert.App.Themes"
        mc:Ignorable="d"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Title="{theme:Loc update.found}" Width="480" Height="440">
    <Grid x:Name="RootGrid" Style="{StaticResource ModalOverlayStyle}">
        <!-- 居中卡片：复用已定义的 ModalCardStyle（暗色底 / 圆角 / 阴影） -->
        <Border x:Name="Card" Width="460" MaxHeight="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                Style="{StaticResource ModalCardStyle}">
            <DockPanel LastChildFill="True">
                <!-- 紧急更新横幅（默认隐藏，status=emgent 时由代码显示并配红边） -->
                <Border x:Name="EmergencyBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                        Background="#C0392B" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                    <TextBlock Foreground="White" FontSize="13" FontWeight="Bold"
                               Text="{theme:Loc update.emergency}"/>
                </Border>
                <TextBlock x:Name="TitleText" DockPanel.Dock="Top" FontSize="19" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForeground}" Text="{theme:Loc update.found}"/>
                <TextBlock x:Name="SubtitleText" DockPanel.Dock="Top" Margin="0,4,0,0" FontSize="12"
                           Foreground="{DynamicResource SecondaryForeground}" Text=""/>

                <!-- 下载进度（默认隐藏，点击「下载更新」后显示） -->
                <StackPanel DockPanel.Dock="Bottom" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource SecondaryForeground}"
                               Text="{theme:Loc update.preparing}" Margin="0,0,0,6"/>
                    <ProgressBar x:Name="ProgressBar" Height="10" Minimum="0" Maximum="1" Value="0"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ControlBackground}"/>
                </StackPanel>

                <!-- 按钮行：复用 ModalButtonRowStyle（右置主操作） -->
                <StackPanel DockPanel.Dock="Bottom" Style="{StaticResource ModalButtonRowStyle}">
                    <Button x:Name="LaterButton" Content="{theme:Loc update.later}" Width="84" Padding="0,8"
                            Margin="0,0,10,0" Background="{DynamicResource ControlBackground}"
                            Foreground="{DynamicResource PrimaryForeground}" BorderThickness="1"
                            BorderBrush="{DynamicResource ControlBorder}" Click="Later_Click"/>
                    <Button x:Name="DownloadButton" Content="{theme:Loc update.download}" Width="104" Padding="0,8"
                            Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                            Click="Download_Click"/>
                </StackPanel>

                <!-- 更新日志（Markdown 渲染，可滚动） -->
                <ScrollViewer x:Name="ChangelogScroll" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto"
                              MaxHeight="220">
                    <local:MarkdownTextBlock x:Name="ChangelogBox" FontSize="13"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
