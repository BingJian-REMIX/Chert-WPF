<UserControl x:Class="Chert.App.Views.ModsView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"

             xmlns:theme="clr-namespace:Chert.App.Themes">



    <UserControl.DataContext>

        <vm:ModsViewModel/>

    </UserControl.DataContext>



    <Grid Margin="12">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">

            <TextBlock Text="{theme:Loc mods.mgmt_title}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>

            <Button Content="{theme:Loc btn.refresh}" Command="{Binding RefreshModsCommand}" Width="60" Margin="16,0,4,0" Padding="0,2"/>

            <Button Content="{theme:Loc btn.check_updates}" Command="{Binding CheckUpdatesCommand}" Width="80" Margin="4,0,4,0" Padding="0,2"/>

            <Button Content="{theme:Loc btn.check_deps}" Command="{Binding CheckDependenciesCommand}" Width="80" Margin="4,0,0,0" Padding="0,2"/>

        </StackPanel>



        <!-- 状态与下载进度 -->

        <StackPanel Grid.Row="1" Margin="0,0,0,4">

            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource StatusForeground}" Margin="0,0,0,4"/>

            <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">

                <TextBlock Text="{Binding CurrentTaskName}" Margin="0,0,8,0" VerticalAlignment="Center"/>

                <ProgressBar Width="220" Height="8" Minimum="0" Maximum="1" Value="{Binding UpdateProgress}" VerticalAlignment="Center"/>

            </StackPanel>

        </StackPanel>



        <!-- 依赖检查结果 -->

        <ItemsControl Grid.Row="2" ItemsSource="{Binding DepResults}" Margin="0,0,0,8">

            <ItemsControl.ItemTemplate>

                <DataTemplate>

                    <Border BorderBrush="#E74C3C" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,2" Background="#1A0000">

                        <StackPanel>

                            <TextBlock FontWeight="Bold">

                                <Run Text="{Binding ModName}"/>

                                <Run Text=" ("/>

                                <Run Text="{Binding ModVersion}"/>

                                <Run Text=")"/>

                            </TextBlock>

                            <TextBlock Text="{theme:Loc mods.missing_dep_label}" Foreground="#FF6B6B" Margin="0,4,0,0"/>

                            <ItemsControl ItemsSource="{Binding Missing}" Margin="16,0,0,0">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <TextBlock Foreground="#FF9999">

                                            <Run Text="{Binding DependencyId}"/>

                                            <Run Text=" "/>

                                            <Run Text="{Binding VersionRange}"/>

                                            <Run Text=" "/>

                                            <Run Text="{theme:Loc mods.required_tag}" Foreground="#E74C3C"/>

                                        </TextBlock>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                            <TextBlock Text="{theme:Loc mods.conflict_label}" Foreground="#FFB86C" Margin="0,4,0,0"/>

                            <ItemsControl ItemsSource="{Binding Conflicts}" Margin="16,0,0,0">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <TextBlock Foreground="#FFCC99">

                                            <Run Text="{Binding ConflictId}"/>

                                            <Run Text="{theme:Loc mods.installed_tag}"/>

                                            <Run Text="{Binding InstalledVersion}"/>

                                            <Run Text="{theme:Loc mods.conflict_range_tag}"/>

                                            <Run Text="{Binding ConflictRange}"/>

                                        </TextBlock>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </StackPanel>

                    </Border>

                </DataTemplate>

            </ItemsControl.ItemTemplate>

        </ItemsControl>



        <!-- 清单 #66：核验 / 一键更新 / 批量处理 -->

        <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">

            <TextBlock Text="{theme:Loc mods.select_label}" VerticalAlignment="Center" Margin="0,0,6,0"/>

            <Button Content="{theme:Loc mods.select_all}" Command="{Binding SelectAllCommand}" Padding="6,2" Margin="0,0,4,0"/>

            <Button Content="{theme:Loc mods.select_none}" Command="{Binding SelectNoneCommand}" Padding="6,2" Margin="0,0,4,0"/>

            <Button Content="{theme:Loc mods.select_outdated}" Command="{Binding SelectOutdatedCommand}" Padding="6,2" Margin="0,0,10,0"/>

            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0">

                <Run Text="{theme:Loc mods.selected_count}"/>

                <Run Text="{Binding SelectedCount}"/>

            </TextBlock>

            <Button Content="{theme:Loc mods.verify_selected}" Command="{Binding VerifySelectedCommand}" Padding="6,2" Margin="0,0,4,0"/>

            <Button Content="{theme:Loc mods.verify_all}" Command="{Binding VerifyAllCommand}" Padding="6,2" Margin="0,0,10,0"/>

            <Button Content="{theme:Loc mods.update_selected}" Command="{Binding UpdateSelectedCommand}" Padding="6,2" Margin="0,0,4,0"/>

            <Button Content="{theme:Loc mods.update_all}" Command="{Binding UpdateAllCommand}" Padding="6,2" Margin="0,0,10,0"/>

            <Button Content="{theme:Loc mods.enable}" Command="{Binding EnableSelectedCommand}" Padding="6,2" Margin="0,0,4,0"/>

            <Button Content="{theme:Loc mods.disable}" Command="{Binding DisableSelectedCommand}" Padding="6,2" Margin="0,0,10,0"/>

            <Button Content="{theme:Loc mods.uninstall_selected}" Command="{Binding UninstallSelectedCommand}" Padding="6,2" Margin="0,0,4,0"/>

        </WrapPanel>



        <!-- Mod 列表 -->

        <ListView Grid.Row="4" ItemsSource="{Binding Items}">

            <ListView.View>

                <GridView>

                    <GridViewColumn Header="" Width="34">

                        <GridViewColumn.CellTemplate>

                            <DataTemplate>

                                <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/>

                            </DataTemplate>

                        </GridViewColumn.CellTemplate>

                    </GridViewColumn>

                    <GridViewColumn Header="{theme:Loc mods.col_name}" Width="190" DisplayMemberBinding="{Binding Name}"/>

                    <GridViewColumn Header="{theme:Loc mods.col_modid}" Width="140" DisplayMemberBinding="{Binding ModId}"/>

                    <GridViewColumn Header="{theme:Loc mods.col_version}" Width="90" DisplayMemberBinding="{Binding InstalledVersion}"/>

                    <GridViewColumn Header="{theme:Loc mods.col_loader}" Width="70" DisplayMemberBinding="{Binding Loader}"/>

                    <GridViewColumn Header="{theme:Loc mods.col_latest}" Width="90" DisplayMemberBinding="{Binding LatestVersion}"/>

                    <GridViewColumn Header="{theme:Loc mods.col_state}" Width="70" DisplayMemberBinding="{Binding StateText}"/>

                    <GridViewColumn Header="{theme:Loc mods.col_verify}" Width="280">

                        <GridViewColumn.CellTemplate>

                            <DataTemplate>

                                <TextBlock Text="{Binding VerifyText}" Foreground="{Binding VerifyBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding VerifyText}"/>

                            </DataTemplate>

                        </GridViewColumn.CellTemplate>

                    </GridViewColumn>

                    <GridViewColumn Header="{theme:Loc mods.col_action}" Width="190">

                        <GridViewColumn.CellTemplate>

                            <DataTemplate>

                                <StackPanel Orientation="Horizontal">

                                    <Button Content="{theme:Loc mods.update_one}"

                                            Command="{Binding DataContext.UpdateModCommand, RelativeSource={RelativeSource AncestorType=ListView}}"

                                            CommandParameter="{Binding}" Padding="4,1" Margin="0,0,4,0"/>

                                    <Button Content="{theme:Loc mods.toggle}"

                                            Command="{Binding DataContext.ToggleModCommand, RelativeSource={RelativeSource AncestorType=ListView}}"

                                            CommandParameter="{Binding}" Padding="4,1" Margin="0,0,4,0"/>

                                    <Button Content="{theme:Loc mods.uninstall}"

                                            Command="{Binding DataContext.UninstallModCommand, RelativeSource={RelativeSource AncestorType=ListView}}"

                                            CommandParameter="{Binding}" Padding="4,1"/>

                                </StackPanel>

                            </DataTemplate>

                        </GridViewColumn.CellTemplate>

                    </GridViewColumn>

                </GridView>

            </ListView.View>

        </ListView>

    </Grid>

</UserControl>
