<UserControl x:Class="Chert.App.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chert.App.ViewModels">
    <UserControl.DataContext>
        <vm:ModsViewModel/>
    </UserControl.DataContext>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Mod 管理" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="刷新" Command="{Binding RefreshModsCommand}" Width="60" Margin="16,0,4,0" Padding="0,2"/>
            <Button Content="检查更新" Command="{Binding CheckUpdatesCommand}" Width="80" Margin="4,0,4,0" Padding="0,2"/>
            <Button Content="依赖检查" Command="{Binding CheckDependenciesCommand}" Width="80" Margin="4,0,0,0" Padding="0,2"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Foreground="{DynamicResource StatusForeground}" Margin="0,0,0,4"/>

        <!-- 依赖检查结果 -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding DepResults}" Margin="0,0,0,8">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#E74C3C" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,2" Background="#1A0000">
                        <StackPanel>
                            <TextBlock FontWeight="Bold">
                                <Run Text="{Binding ModName}"/>
                                <Run Text=" ("/>
                                <Run Text="{Binding ModVersion}"/>
                                <Run Text=")"/>
                            </TextBlock>
                            <TextBlock Text="缺失依赖：" Foreground="#FF6B6B" Margin="0,4,0,0" Visibility="{Binding Missing.Count, Converter={x:Null}}" />
                            <ItemsControl ItemsSource="{Binding Missing}" Margin="16,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="#FF9999">
                                            <Run Text="{Binding DependencyId}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding VersionRange}"/>
                                            <Run Text=" [必需]" Foreground="#E74C3C"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="冲突：" Foreground="#FFB86C" Margin="0,4,0,0" Visibility="{Binding Conflicts.Count, Converter={x:Null}}" />
                            <ItemsControl ItemsSource="{Binding Conflicts}" Margin="16,0,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Foreground="#FFCC99">
                                            <Run Text="{Binding ConflictId}"/>
                                            <Run Text=" 已安装 "/>
                                            <Run Text="{Binding InstalledVersion}"/>
                                            <Run Text=" 冲突范围 "/>
                                            <Run Text="{Binding ConflictRange}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Mod 列表 -->
        <ListView Grid.Row="3" ItemsSource="{Binding Mods}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名称" Width="240" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Mod ID" Width="180" DisplayMemberBinding="{Binding ModId}"/>
                    <GridViewColumn Header="版本" Width="100" DisplayMemberBinding="{Binding InstalledVersion}"/>
                    <GridViewColumn Header="加载器" Width="80" DisplayMemberBinding="{Binding Loader}"/>
                    <GridViewColumn Header="最新" Width="100" DisplayMemberBinding="{Binding LatestVersion}"/>
                    <GridViewColumn Header="操作" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="卸载" Command="{Binding DataContext.UninstallModCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding FileName}" Padding="4,1"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
