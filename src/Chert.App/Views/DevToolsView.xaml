<UserControl x:Class="Chert.App.Views.DevToolsView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:theme="clr-namespace:Chert.App.Themes">

    <UserControl.DataContext>

        <vm:DevToolsViewModel/>

    </UserControl.DataContext>



    <Grid Margin="12">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>



        <!-- 子标签 -->

        <WrapPanel Grid.Row="0" Margin="0,0,0,10">

            <RadioButton Content="{theme:Loc dev.m92}" GroupName="devMode" IsChecked="{Binding Mode, Converter={StaticResource StrEq}, ConverterParameter=commands}" Margin="0,0,12,0"/>

            <RadioButton Content="{theme:Loc dev.m93}" GroupName="devMode" IsChecked="{Binding Mode, Converter={StaticResource StrEq}, ConverterParameter=mod}" Margin="0,0,12,0"/>

            <RadioButton Content="{theme:Loc dev.m94}" GroupName="devMode" IsChecked="{Binding Mode, Converter={StaticResource StrEq}, ConverterParameter=resourcepack}" Margin="0,0,12,0"/>

        </WrapPanel>



        <Grid Grid.Row="1">

            <!-- 命令速查 -->

            <Grid Visibility="{Binding ShowCommands, Converter={StaticResource BoolToVis}}">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" Text="{Binding CommandFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"

                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                         BorderBrush="{DynamicResource InputBorder}" Padding="8,5">

                    <TextBox.Resources>

                        <Style TargetType="TextBox">

                            <Style.Triggers>

                                <Trigger Property="Text" Value="">

                                    <Setter Property="ToolTip" Value="搜索命令名/分类/描述"/>

                                </Trigger>

                            </Style.Triggers>

                        </Style>

                    </TextBox.Resources>

                </TextBox>

                <ListBox Grid.Row="1" ItemsSource="{Binding Commands}"

                         Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}">

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <StackPanel Margin="0,2" Visibility="{Binding MatchesFilter, Converter={StaticResource BoolToVis}}">

                                <WrapPanel>

                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"

                                               Foreground="{DynamicResource AccentBrush}" Width="140"/>

                                    <Border Background="{DynamicResource ControlBackground}" CornerRadius="3" Padding="5,1">

                                        <TextBlock Text="{Binding Category}" FontSize="10"

                                                   Foreground="{DynamicResource SecondaryForeground}"/>

                                    </Border>

                                </WrapPanel>

                                <TextBlock Text="{Binding Syntax}" FontSize="11" FontFamily="Consolas" Margin="0,2,0,0"

                                           Foreground="{DynamicResource PrimaryForeground}"/>

                                <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,1,0,4"

                                           Foreground="{DynamicResource SecondaryForeground}"/>

                            </StackPanel>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>



            <!-- Mod 骨架生成 -->

            <StackPanel Visibility="{Binding ShowMod, Converter={StaticResource BoolToVis}}" Width="360">

                <TextBlock Text="{theme:Loc tool.moddev}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                <TextBlock Text="{theme:Loc dev.m95}" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryForeground}"/>

                <TextBox Text="{Binding ModName, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"

                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                         BorderBrush="{DynamicResource InputBorder}"/>

                <TextBlock Text="{theme:Loc dev.m96}" Margin="0,8,0,4" Foreground="{DynamicResource SecondaryForeground}"/>

                <TextBox Text="{Binding ModVersion, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" Width="120"

                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                         BorderBrush="{DynamicResource InputBorder}"/>

                <TextBlock Text="{theme:Loc dev.m97}" Margin="0,8,0,4" Foreground="{DynamicResource SecondaryForeground}"/>

                <ComboBox SelectedItem="{Binding ModLoader}" Width="160">

                    <ComboBoxItem Content="{theme:Loc lbl.fabric}" Tag="fabric"/>

                    <ComboBoxItem Content="{theme:Loc lbl.forge}" Tag="forge"/>

                    <ComboBoxItem Content="NeoForge" Tag="neoforge"/>

                </ComboBox>

                <TextBlock Text="{theme:Loc dev.m98}" Margin="0,8,0,4" Foreground="{DynamicResource SecondaryForeground}"/>

                <TextBox Text="{Binding ModGameVersion, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" Width="120"

                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                         BorderBrush="{DynamicResource InputBorder}"/>

                <TextBlock Text="{theme:Loc dev.m99}" Margin="0,8,0,4" Foreground="{DynamicResource SecondaryForeground}"/>

                <TextBox Text="{Binding ModPackage, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" Width="260"

                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                         BorderBrush="{DynamicResource InputBorder}"/>

                <Button Content="{theme:Loc dev.m100}" Command="{Binding GenerateModCommand}" Width="140" Padding="0,6"

                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0"/>

            </StackPanel>



            <!-- 资源包创建 -->

            <StackPanel Visibility="{Binding ShowResourcePack, Converter={StaticResource BoolToVis}}" Width="360">

                <TextBlock Text="{theme:Loc tool.packmaker}" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>

                <Border Background="{DynamicResource ControlBackground}" CornerRadius="4" Padding="8,6" Margin="0,0,0,10">

                    <StackPanel>

                        <TextBlock Text="{theme:Loc dev.m101}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>

                        <TextBlock Text="{theme:Loc dev.m102}" FontSize="10" Foreground="{DynamicResource SecondaryForeground}" Margin="0,2,0,0"/>

                        <TextBlock Text="{theme:Loc dev.m103}" FontSize="10" Foreground="{DynamicResource SecondaryForeground}" Margin="0,1,0,0"/>

                        <TextBlock Text="{theme:Loc dev.m104}" FontSize="10" Foreground="{DynamicResource SecondaryForeground}" Margin="0,1,0,0"/>

                    </StackPanel>

                </Border>

                <TextBlock Text="{theme:Loc dev.m105}" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryForeground}"/>

                <TextBox Text="{Binding RpName, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"

                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                         BorderBrush="{DynamicResource InputBorder}"/>

                <TextBlock Text="{theme:Loc dev.m106}" Margin="0,8,0,4" Foreground="{DynamicResource SecondaryForeground}"/>

                <TextBox Text="{Binding RpFormat, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" Width="80"

                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                         BorderBrush="{DynamicResource InputBorder}"/>

                <Button Content="{theme:Loc dev.m107}" Command="{Binding GenerateRpCommand}" Width="140" Padding="0,6"

                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>

