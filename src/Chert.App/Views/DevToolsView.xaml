<UserControl x:Class="Chert.App.Views.DevToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chert.App.ViewModels">
    <UserControl.DataContext>
        <vm:DevToolsViewModel/>
    </UserControl.DataContext>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 子标签 -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,10">
            <RadioButton Content="命令速查" GroupName="devMode" IsChecked="{Binding Mode, Converter={StaticResource StrEq}, ConverterParameter=commands}" Margin="0,0,12,0"/>
            <RadioButton Content="Mod 骨架" GroupName="devMode" IsChecked="{Binding Mode, Converter={StaticResource StrEq}, ConverterParameter=mod}" Margin="0,0,12,0"/>
            <RadioButton Content="资源包创建" GroupName="devMode" IsChecked="{Binding Mode, Converter={StaticResource StrEq}, ConverterParameter=resourcepack}" Margin="0,0,12,0"/>
        </WrapPanel>

        <Grid Grid.Row="1">
            <!-- 命令速查 -->
            <Grid Visibility="{Binding ShowCommands, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" Text="{Binding CommandFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}" Padding="8,5">
                    <TextBox.Resources>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="ToolTip" Value="搜索命令名/分类/描述"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <ListBox Grid.Row="1" ItemsSource="{Binding Commands}"
                         Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource InputBorder}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2" Visibility="{Binding MatchesFilter, Converter={StaticResource BoolToVis}}">
                                <WrapPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13"
                                               Foreground="{DynamicResource AccentBrush}" Width="140"/>
                                    <Border Background="{DynamicResource ControlBackground}" CornerRadius="3" Padding="5,1">
                                        <TextBlock Text="{Binding Category}" FontSize="10"
                                                   Foreground="{DynamicResource SecondaryForeground}"/>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="{Binding Syntax}" FontSize="11" FontFamily="Consolas" Margin="0,2,0,0"
                                           Foreground="{DynamicResource PrimaryForeground}"/>
                                <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,1,0,4"
                                           Foreground="{DynamicResource SecondaryForeground}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Mod 骨架生成 -->
            <StackPanel Visibility="{Binding ShowMod, Converter={StaticResource BoolToVis}}" Width="360">
                <TextBlock Text="Mod 开发环境" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                <TextBlock Text="Mod 名称" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryForeground}"/>
                <TextBox Text="{Binding ModName, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"
                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}"/>
                <TextBlock Text="版本号" Margin="0,8,0,4" Foreground="{DynamicResource SecondaryForeground}"/>
                <TextBox Text="{Binding ModVersion, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" Width="120"
                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}"/>
                <TextBlock Text="加载器" Margin="0,8,0,4" Foreground="{DynamicResource SecondaryForeground}"/>
                <ComboBox SelectedItem="{Binding ModLoader}" Width="160">
                    <ComboBoxItem Content="Fabric" Tag="fabric"/>
                    <ComboBoxItem Content="Forge" Tag="forge"/>
                    <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
                </ComboBox>
                <TextBlock Text="游戏版本" Margin="0,8,0,4" Foreground="{DynamicResource SecondaryForeground}"/>
                <TextBox Text="{Binding ModGameVersion, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" Width="120"
                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}"/>
                <TextBlock Text="包名（如 com.example.mymod）" Margin="0,8,0,4" Foreground="{DynamicResource SecondaryForeground}"/>
                <TextBox Text="{Binding ModPackage, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" Width="260"
                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}"/>
                <Button Content="生成项目骨架" Command="{Binding GenerateModCommand}" Width="140" Padding="0,6"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0"/>
            </StackPanel>

            <!-- 资源包创建 -->
            <StackPanel Visibility="{Binding ShowResourcePack, Converter={StaticResource BoolToVis}}" Width="360">
                <TextBlock Text="资源包创建器" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                <Border Background="{DynamicResource ControlBackground}" CornerRadius="4" Padding="8,6" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="新手教程" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="1. 输入名称和 pack_format（1.21=34, 1.20=15, 1.19=9）" FontSize="10" Foreground="{DynamicResource SecondaryForeground}" Margin="0,2,0,0"/>
                        <TextBlock Text="2. 生成后在 assets/minecraft 下放入纹理/模型/声音文件" FontSize="10" Foreground="{DynamicResource SecondaryForeground}" Margin="0,1,0,0"/>
                        <TextBlock Text="3. 打包 zip 或直接放到 .minecraft/resourcepacks" FontSize="10" Foreground="{DynamicResource SecondaryForeground}" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="资源包名称" Margin="0,0,0,4" Foreground="{DynamicResource SecondaryForeground}"/>
                <TextBox Text="{Binding RpName, UpdateSourceTrigger=PropertyChanged}" Padding="6,3"
                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}"/>
                <TextBlock Text="pack_format（MC版本对应的格式号）" Margin="0,8,0,4" Foreground="{DynamicResource SecondaryForeground}"/>
                <TextBox Text="{Binding RpFormat, UpdateSourceTrigger=PropertyChanged}" Padding="6,3" Width="80"
                         Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"
                         BorderBrush="{DynamicResource InputBorder}"/>
                <Button Content="生成资源包" Command="{Binding GenerateRpCommand}" Width="140" Padding="0,6"
                        Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
