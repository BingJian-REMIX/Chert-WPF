<UserControl x:Class="Chert.App.Views.VersionListView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:theme="clr-namespace:Chert.App.Themes">

    <UserControl.DataContext>

        <vm:VersionListViewModel/>

    </UserControl.DataContext>



    <Grid Margin="12">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">

            <Button Content="{theme:Loc ver.m278}" Click="BackButton_Click" Padding="10,3" Margin="0,0,10,0"

                    ToolTip="{theme:Loc ver.m279}"/>

            <TextBlock Text="{theme:Loc ver.m280}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"

                       Foreground="{DynamicResource PrimaryForeground}"/>

            <Button Content="{theme:Loc mods.refresh}" Command="{Binding RefreshCommand}" Margin="12,0,0,0" Padding="10,3"/>

            <Button Content="{theme:Loc ver.m281}" Command="{Binding OpenSettingsCommand}" Margin="8,0,0,0" Padding="10,3"/>

        </StackPanel>



        <Border Grid.Row="1" BorderBrush="{DynamicResource ListViewBorder}" BorderThickness="1" CornerRadius="6">

            <ListBox ItemsSource="{Binding Versions}"

                     SelectedItem="{Binding SelectedVersion}"

                     Background="{DynamicResource ListViewBackground}" BorderThickness="0"

                     HorizontalContentAlignment="Stretch">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <Grid Margin="0,3">

                            <Grid.ToolTip>

                                <MultiBinding StringFormat="{}{0}　[{1}]&#x0a;{2}">

                                    <Binding Path="DisplayName"/>

                                    <Binding Path="IsolationText"/>

                                    <Binding Path="EffectiveDir"/>

                                </MultiBinding>

                            </Grid.ToolTip>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>



                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DisplayName}"

                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>



                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">

                                <Border CornerRadius="3" Padding="6,1" Margin="0,0,6,0"

                                        Background="{DynamicResource AccentBrush}">

                                    <TextBlock Text="{Binding LoaderText}" FontSize="10" Foreground="White"/>

                                </Border>

                                <Border CornerRadius="3" Padding="6,1">

                                    <Border.Style>

                                        <Style TargetType="Border">

                                            <Setter Property="Background" Value="#607D8B"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsIsolated}" Value="True">

                                                    <Setter Property="Background" Value="#4CAF50"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Border.Style>

                                    <TextBlock Text="{Binding IsolationText}" FontSize="10" Foreground="White"/>

                                </Border>

                            </StackPanel>



                            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,2,0,0"

                                       Text="{Binding EffectiveDir}" FontSize="11"

                                       Foreground="{DynamicResource SecondaryForeground}"

                                       TextTrimming="CharacterEllipsis" Opacity="0.9"/>

                        </Grid>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </Border>



        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">

            <Button Content="{theme:Loc btn.launch}" Command="{Binding LaunchCommand}" Width="120" Padding="0,5"

                    Style="{StaticResource PrimaryButtonStyle}"/>

            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="12,0,0,0"

                       Foreground="{DynamicResource StatusForeground}" TextWrapping="Wrap"/>

        </StackPanel>

    </Grid>

</UserControl>

