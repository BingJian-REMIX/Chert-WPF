<UserControl x:Class="Chert.App.Views.VersionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:conv="clr-namespace:Chert.App.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVisibility"/>
        <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility"/>

        <!-- 分组标题 -->
        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,4,0,6"/>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="FieldBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- bug #10：顶部左侧返回按钮（大页导航） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="← 返回" Click="BackButton_Click" Padding="10,3" Margin="0,0,10,0"
                    ToolTip="返回上一页"/>
            <TextBlock Text="版本设置" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                       Foreground="{DynamicResource PrimaryForeground}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ① 基础信息 -->
                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="① 基础信息" Style="{StaticResource GroupHeaderStyle}" Margin="0"/>
                            <Button Grid.Column="1" Content="删除该版本" Command="{Binding DeleteVersionCommand}"
                                    Padding="10,3" Background="#E53935" Foreground="White" BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="显示名" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource FieldBoxStyle}"
                                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,2">
                            <Run Text="版本 Id："/>
                            <Run Text="{Binding VersionId, Mode=OneWay}" FontWeight="SemiBold"/>
                            <Run Text="  ｜  类型："/>
                            <Run Text="{Binding VersionType, Mode=OneWay}"/>
                            <Run Text="  ｜  基版本："/>
                            <Run Text="{Binding BaseMcVersion, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ③ 模组加载器 -->
                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="③ 模组加载器" Style="{StaticResource GroupHeaderStyle}"/>
                        <WrapPanel Margin="0,0,0,4">
                            <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryForeground}">
                                <Run Text="当前：" Foreground="{DynamicResource SecondaryForeground}"/>
                                <Run Text="{Binding DetectedLoaderText, Mode=OneWay}" FontWeight="SemiBold"/>
                            </TextBlock>
                            <Button Content="安装 Fabric" Command="{Binding InstallLoaderCommand}" CommandParameter="fabric"
                                    Padding="10,3" Margin="14,0,6,0"/>
                            <Button Content="安装 Forge" Command="{Binding InstallLoaderCommand}" CommandParameter="forge"
                                    Padding="10,3" Margin="0,0,6,0"/>
                            <Button Content="安装 NeoForge" Command="{Binding InstallLoaderCommand}" CommandParameter="neoforge"
                                    Padding="10,3" Margin="0,0,6,0"/>
                            <Button Content="安装 Quilt" Command="{Binding InstallLoaderCommand}" CommandParameter="quilt"
                                    Padding="10,3"/>
                        </WrapPanel>
                        <TextBlock Text="加载器会安装为新实例（基于上方基版本），请在版本列表切换到它。"
                                   FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>
                    </StackPanel>
                </Border>

                <!-- ④ 隔离与工作目录（bug2.txt #81：独立卡片，避免与相邻分组视觉重叠） -->
                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="④ 隔离与工作目录" Style="{StaticResource GroupHeaderStyle}"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="隔离模式" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding IsolationChoices}"
                                      SelectedValue="{Binding Isolation, Mode=TwoWay}"
                                      SelectedValuePath="Mode" DisplayMemberPath="Text" Padding="6,3"/>
                        </Grid>
                        <Grid Margin="0,0,0,6" Visibility="{Binding IsCustomDir, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="自定义目录" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource FieldBoxStyle}"
                                     Text="{Binding CustomGameDir, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="浏览…" Command="{Binding BrowseCustomDirCommand}"
                                    Padding="10,3" Margin="6,0,0,0"/>
                        </Grid>
                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryForeground}"
                                   TextWrapping="Wrap">
                            <Run Text="有效工作目录："/>
                            <Run Text="{Binding EffectiveGameDirDisplay, Mode=OneWay}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ⑤ Java 与性能 -->
                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⑤ Java 与性能" Style="{StaticResource GroupHeaderStyle}"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Java 路径" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource FieldBoxStyle}"
                                     Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="2" Content="浏览…" Command="{Binding BrowseJavaCommand}"
                                    Padding="10,3" Margin="6,0,0,0"/>
                        </Grid>
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="最大内存" Style="{StaticResource FieldLabelStyle}" Width="88"/>
                            <TextBox Width="90" Style="{StaticResource FieldBoxStyle}"
                                     Text="{Binding MaxMemoryMb, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="MB" Margin="6,0,20,0" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBlock Text="最小内存" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Width="90" Style="{StaticResource FieldBoxStyle}" Margin="8,0,0,0"
                                     Text="{Binding MinMemoryMb, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="MB" Margin="6,0,0,0" Style="{StaticResource FieldLabelStyle}"/>
                        </WrapPanel>
                        <TextBlock Text="额外 JVM 参数（每行一个，追加在全局参数之后）"
                                   FontSize="11" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,3"/>
                        <TextBox Height="56" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource FieldBoxStyle}" Margin="0,0,0,6"
                                 Text="{Binding ExtraJvmArgsText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <!-- ⑥ 分辨率与窗口 -->
                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⑥ 分辨率与窗口" Style="{StaticResource GroupHeaderStyle}"/>
                        <WrapPanel>
                            <TextBlock Text="宽" Style="{StaticResource FieldLabelStyle}" Width="24"/>
                            <TextBox Width="80" Style="{StaticResource FieldBoxStyle}"
                                     Text="{Binding ResolutionWidth, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="高" Style="{StaticResource FieldLabelStyle}" Margin="12,0,0,0"/>
                            <TextBox Width="80" Style="{StaticResource FieldBoxStyle}" Margin="8,0,0,0"
                                     Text="{Binding ResolutionHeight, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Content="全屏启动" IsChecked="{Binding Fullscreen, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="16,0,0,0"
                                      Foreground="{DynamicResource PrimaryForeground}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ⑦ 模组与资源包管理 -->
                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⑦ 模组与资源包管理" Style="{StaticResource GroupHeaderStyle}"/>
                        <WrapPanel Margin="0,0,0,6">
                            <ComboBox Width="110" ItemsSource="{Binding ModTabChoices}"
                                      SelectedValue="{Binding ModTab, Mode=TwoWay}"
                                      SelectedValuePath="Kind" DisplayMemberPath="Text" Padding="6,3"/>
                            <Button Content="刷新" Command="{Binding RefreshModsCommand}" Padding="10,3" Margin="8,0,6,0"/>
                            <Button Content="打开文件夹" Command="{Binding OpenFolderCommand}" CommandParameter="mods"
                                    Padding="10,3" Margin="0,0,6,0"/>
                            <Button Content="检查更新" Command="{Binding CheckUpdatesCommand}" Padding="10,3"
                                    Visibility="{Binding IsModsTab, Converter={StaticResource BoolToVisibility}}"/>
                        </WrapPanel>

                        <Border BorderBrush="{DynamicResource ListViewBorder}" BorderThickness="1" CornerRadius="6"
                               Margin="0,0,0,6" MaxHeight="150">
                            <ListBox ItemsSource="{Binding InstalledItems}" BorderThickness="0"
                                     Background="{DynamicResource ListViewBackground}"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Content="移除" Padding="8,1" FontSize="11"
                                                    Command="{Binding DataContext.RemoveItemCommand,
                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding FileName}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                           Foreground="{DynamicResource SecondaryForeground}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource FieldBoxStyle}"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="搜索 Modrinth" Command="{Binding SearchModsCommand}"
                                    Padding="10,3" Margin="6,0,0,0"/>
                        </Grid>
                        <Border BorderBrush="{DynamicResource ListViewBorder}" BorderThickness="1" CornerRadius="6"
                               MaxHeight="130" Margin="0,0,0,2">
                            <ListBox ItemsSource="{Binding SearchResults}" BorderThickness="0"
                                     Background="{DynamicResource ListViewBackground}"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Right" Content="添加" Padding="8,1" FontSize="11"
                                                    Command="{Binding DataContext.AddModCommand,
                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Slug}" FontSize="11"
                                                           Foreground="{DynamicResource SecondaryForeground}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ⑧ 版本锁定 -->
                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="⑧ 版本锁定" Style="{StaticResource GroupHeaderStyle}"/>
                        <CheckBox Content="锁定该版本（阻止自动更新覆盖，并阻止安装加载器 / 增删 Mod）"
                                  IsChecked="{Binding Locked, Mode=TwoWay}"
                                  Foreground="{DynamicResource PrimaryForeground}"/>
                    </StackPanel>
                </Border>

                <!-- ⑨ 账号绑定 -->
                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,2">
                    <StackPanel>
                        <TextBlock Text="⑨ 账号绑定" Style="{StaticResource GroupHeaderStyle}"/>
                        <WrapPanel>
                            <TextBlock Text="绑定账号" Style="{StaticResource FieldLabelStyle}" Width="88"/>
                            <ComboBox Width="220" ItemsSource="{Binding Accounts}"
                                      SelectedItem="{Binding BoundAccount, Mode=TwoWay}"
                                      DisplayMemberPath="Username" Padding="6,3"/>
                            <Button Content="清除绑定" Command="{Binding ClearAccountBindingCommand}"
                                    Padding="10,3" Margin="8,0,0,0"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部：状态 + 保存 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource StatusForeground}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="保存" Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" Width="86" Padding="0,5"/>
                <Button x:Name="CloseButton" Content="关闭" Width="86" Padding="0,5" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
