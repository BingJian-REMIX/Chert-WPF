<UserControl x:Class="Chert.App.Views.VersionSettingsView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"

             xmlns:conv="clr-namespace:Chert.App.Converters"
             xmlns:theme="clr-namespace:Chert.App.Themes">

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVisibility"/>

        <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisibility"/>



        <!-- 分组标题 -->

        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">

            <Setter Property="FontSize" Value="13"/>

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>

            <Setter Property="Margin" Value="0,4,0,6"/>

        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">

            <Setter Property="FontSize" Value="12"/>

            <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>

            <Setter Property="VerticalAlignment" Value="Center"/>

            <Setter Property="Margin" Value="0,0,8,0"/>

        </Style>

        <Style x:Key="FieldBoxStyle" TargetType="TextBox">

            <Setter Property="Padding" Value="6,3"/>

            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>

            <Setter Property="Foreground" Value="{DynamicResource InputForeground}"/>

            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>

        </Style>

    </UserControl.Resources>



    <Grid Margin="14">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>



        <!-- bug #10：顶部左侧返回按钮（大页导航） -->

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">

            <Button Content="{theme:Loc ver.m278}" Click="BackButton_Click" Padding="10,3" Margin="0,0,10,0"

                    ToolTip="{theme:Loc ver.m279}"/>

            <TextBlock Text="{theme:Loc version.settings.title}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"

                       Foreground="{DynamicResource PrimaryForeground}"/>

        </StackPanel>



        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

            <StackPanel>



                <!-- ① 基础信息 -->

                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,10">

                    <StackPanel>

                        <Grid Margin="0,0,0,6">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{theme:Loc version.m282}" Style="{StaticResource GroupHeaderStyle}" Margin="0"/>

                            <Button Grid.Column="1" Content="{theme:Loc version.m283}" Command="{Binding DeleteVersionCommand}"

                                    Padding="10,3" Background="#E53935" Foreground="White" BorderThickness="0">

                                <Button.Resources>

                                    <Style TargetType="Border">

                                        <Setter Property="CornerRadius" Value="6"/>

                                    </Style>

                                </Button.Resources>

                            </Button>

                        </Grid>

                        <Grid Margin="0,0,0,4">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="88"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{theme:Loc version.display_name}" Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox Grid.Column="1" Style="{StaticResource FieldBoxStyle}"

                                     Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>

                        </Grid>

                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,2">

                            <Run Text="{theme:Loc version.m284}"/>

                            <Run Text="{Binding VersionId, Mode=OneWay}" FontWeight="SemiBold"/>

                            <Run Text="{theme:Loc version.m285}"/>

                            <Run Text="{Binding VersionType, Mode=OneWay}"/>

                            <Run Text="{theme:Loc version.m286}"/>

                            <Run Text="{Binding BaseMcVersion, Mode=OneWay}"/>

                        </TextBlock>

                    </StackPanel>

                </Border>



                <!-- ③ 模组加载器 -->

                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,10">

                    <StackPanel>

                        <TextBlock Text="{theme:Loc version.m287}" Style="{StaticResource GroupHeaderStyle}"/>

                        <WrapPanel Margin="0,0,0,4">

                            <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryForeground}">

                                <Run Text="{theme:Loc version.m288}" Foreground="{DynamicResource SecondaryForeground}"/>

                                <Run Text="{Binding DetectedLoaderText, Mode=OneWay}" FontWeight="SemiBold"/>

                            </TextBlock>

                            <Button Content="{theme:Loc install.fabric}" Command="{Binding InstallLoaderCommand}" CommandParameter="fabric"

                                    Padding="10,3" Margin="14,0,6,0"/>

                            <Button Content="{theme:Loc install.forge}" Command="{Binding InstallLoaderCommand}" CommandParameter="forge"

                                    Padding="10,3" Margin="0,0,6,0"/>

                            <Button Content="{theme:Loc install.neoforge}" Command="{Binding InstallLoaderCommand}" CommandParameter="neoforge"

                                    Padding="10,3" Margin="0,0,6,0"/>

                            <Button Content="{theme:Loc install.quilt}" Command="{Binding InstallLoaderCommand}" CommandParameter="quilt"

                                    Padding="10,3"/>

                        </WrapPanel>

                        <TextBlock Text="{theme:Loc version.m289}"

                                   FontSize="11" Foreground="{DynamicResource SecondaryForeground}"/>

                    </StackPanel>

                </Border>



                <!-- ④ 隔离与工作目录（bug2.txt #81：独立卡片，避免与相邻分组视觉重叠） -->

                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,10"

                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">

                    <StackPanel>

                        <TextBlock Text="{theme:Loc version.m290}" Style="{StaticResource GroupHeaderStyle}"/>

                        <Grid Margin="0,0,0,6">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="88"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{theme:Loc version.isolation}" Style="{StaticResource FieldLabelStyle}"/>

                            <ComboBox Grid.Column="1" ItemsSource="{Binding IsolationChoices}"

                                      SelectedValue="{Binding Isolation, Mode=TwoWay}"

                                      SelectedValuePath="Mode" DisplayMemberPath="Text" Padding="6,3"/>

                        </Grid>

                        <Grid Margin="0,0,0,6" Visibility="{Binding IsCustomDir, Converter={StaticResource BoolToVisibility}}">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="88"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{theme:Loc isolation.custom}" Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox Grid.Column="1" Style="{StaticResource FieldBoxStyle}"

                                     Text="{Binding CustomGameDir, UpdateSourceTrigger=PropertyChanged}"/>

                            <Button Grid.Column="2" Content="{theme:Loc backup.m48}" Command="{Binding BrowseCustomDirCommand}"

                                    Padding="10,3" Margin="6,0,0,0"/>

                        </Grid>

                        <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryForeground}"

                                   TextWrapping="Wrap">

                            <Run Text="{theme:Loc version.m291}"/>

                            <Run Text="{Binding EffectiveGameDirDisplay, Mode=OneWay}" FontWeight="SemiBold"/>

                        </TextBlock>

                    </StackPanel>

                </Border>



                <!-- ⑤ Java 与性能 -->

                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,10">

                    <StackPanel>

                        <TextBlock Text="{theme:Loc version.m292}" Style="{StaticResource GroupHeaderStyle}"/>

                        <Grid Margin="0,0,0,6">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="88"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{theme:Loc settings.java_path}" Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox Grid.Column="1" Style="{StaticResource FieldBoxStyle}"

                                     Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}"/>

                            <Button Grid.Column="2" Content="{theme:Loc backup.m48}" Command="{Binding BrowseJavaCommand}"

                                    Padding="10,3" Margin="6,0,0,0"/>

                        </Grid>

                        <WrapPanel Margin="0,0,0,6">

                            <TextBlock Text="{theme:Loc version.max_memory}" Style="{StaticResource FieldLabelStyle}" Width="88"/>

                            <TextBox Width="90" Style="{StaticResource FieldBoxStyle}"

                                     Text="{Binding MaxMemoryMb, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="MB" Margin="6,0,20,0" Style="{StaticResource FieldLabelStyle}"/>

                            <TextBlock Text="{theme:Loc version.min_memory}" Style="{StaticResource FieldLabelStyle}"/>

                            <TextBox Width="90" Style="{StaticResource FieldBoxStyle}" Margin="8,0,0,0"

                                     Text="{Binding MinMemoryMb, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="MB" Margin="6,0,0,0" Style="{StaticResource FieldLabelStyle}"/>

                        </WrapPanel>

                        <TextBlock Text="{theme:Loc version.m293}"

                                   FontSize="11" Foreground="{DynamicResource SecondaryForeground}" Margin="0,0,0,3"/>

                        <TextBox Height="56" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"

                                 Style="{StaticResource FieldBoxStyle}" Margin="0,0,0,6"

                                 Text="{Binding ExtraJvmArgsText, UpdateSourceTrigger=PropertyChanged}"/>

                    </StackPanel>

                </Border>



                <!-- ⑥ 分辨率与窗口 -->

                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,10">

                    <StackPanel>

                        <TextBlock Text="{theme:Loc version.m294}" Style="{StaticResource GroupHeaderStyle}"/>

                        <WrapPanel>

                            <TextBlock Text="{theme:Loc version.m295}" Style="{StaticResource FieldLabelStyle}" Width="24"/>

                            <TextBox Width="80" Style="{StaticResource FieldBoxStyle}"

                                     Text="{Binding ResolutionWidth, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="{theme:Loc version.m296}" Style="{StaticResource FieldLabelStyle}" Margin="12,0,0,0"/>

                            <TextBox Width="80" Style="{StaticResource FieldBoxStyle}" Margin="8,0,0,0"

                                     Text="{Binding ResolutionHeight, UpdateSourceTrigger=PropertyChanged}"/>

                            <CheckBox Content="{theme:Loc version.fullscreen}" IsChecked="{Binding Fullscreen, Mode=TwoWay}"

                                      VerticalAlignment="Center" Margin="16,0,0,0"

                                      Foreground="{DynamicResource PrimaryForeground}"/>

                        </WrapPanel>

                    </StackPanel>

                </Border>



                <!-- ⑦ 模组与资源包管理 -->

                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,10">

                    <StackPanel>

                        <TextBlock Text="{theme:Loc version.m297}" Style="{StaticResource GroupHeaderStyle}"/>

                        <WrapPanel Margin="0,0,0,6">

                            <ComboBox Width="110" ItemsSource="{Binding ModTabChoices}"

                                      SelectedValue="{Binding ModTab, Mode=TwoWay}"

                                      SelectedValuePath="Kind" DisplayMemberPath="Text" Padding="6,3"/>

                            <Button Content="{theme:Loc mods.refresh}" Command="{Binding RefreshModsCommand}" Padding="10,3" Margin="8,0,6,0"/>

                            <Button Content="{theme:Loc mods.open_folder}" Command="{Binding OpenFolderCommand}" CommandParameter="mods"

                                    Padding="10,3" Margin="0,0,6,0"/>

                            <Button Content="{theme:Loc mods.check_update}" Command="{Binding CheckUpdatesCommand}" Padding="10,3"

                                    Visibility="{Binding IsModsTab, Converter={StaticResource BoolToVisibility}}"/>

                        </WrapPanel>



                        <Border BorderBrush="{DynamicResource ListViewBorder}" BorderThickness="1" CornerRadius="6"

                               Margin="0,0,0,6" MaxHeight="150">

                            <ListBox ItemsSource="{Binding InstalledItems}" BorderThickness="0"

                                     Background="{DynamicResource ListViewBackground}"

                                     HorizontalContentAlignment="Stretch">

                                <ListBox.ItemTemplate>

                                    <DataTemplate>

                                        <DockPanel Margin="0,2">

                                            <Button DockPanel.Dock="Right" Content="{theme:Loc mods.remove}" Padding="8,1" FontSize="11"

                                                    Command="{Binding DataContext.RemoveItemCommand,

                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"

                                                    CommandParameter="{Binding FileName}"/>

                                            <StackPanel>

                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"

                                                           TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding Subtitle}" FontSize="11"

                                                           Foreground="{DynamicResource SecondaryForeground}"/>

                                            </StackPanel>

                                        </DockPanel>

                                    </DataTemplate>

                                </ListBox.ItemTemplate>

                            </ListBox>

                        </Border>



                        <Grid Margin="0,0,0,4">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="Auto"/>

                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Style="{StaticResource FieldBoxStyle}"

                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>

                            <Button Grid.Column="1" Content="{theme:Loc version.m298}" Command="{Binding SearchModsCommand}"

                                    Padding="10,3" Margin="6,0,0,0"/>

                        </Grid>

                        <Border BorderBrush="{DynamicResource ListViewBorder}" BorderThickness="1" CornerRadius="6"

                               MaxHeight="130" Margin="0,0,0,2">

                            <ListBox ItemsSource="{Binding SearchResults}" BorderThickness="0"

                                     Background="{DynamicResource ListViewBackground}"

                                     HorizontalContentAlignment="Stretch">

                                <ListBox.ItemTemplate>

                                    <DataTemplate>

                                        <DockPanel Margin="0,2">

                                            <Button DockPanel.Dock="Right" Content="{theme:Loc mods.add}" Padding="8,1" FontSize="11"

                                                    Command="{Binding DataContext.AddModCommand,

                                                              RelativeSource={RelativeSource AncestorType=ListBox}}"

                                                    CommandParameter="{Binding}"/>

                                            <StackPanel>

                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"

                                                           TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{Binding Slug}" FontSize="11"

                                                           Foreground="{DynamicResource SecondaryForeground}"/>

                                            </StackPanel>

                                        </DockPanel>

                                    </DataTemplate>

                                </ListBox.ItemTemplate>

                            </ListBox>

                        </Border>

                    </StackPanel>

                </Border>



                <!-- ⑧ 版本锁定 -->

                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,10">

                    <StackPanel>

                        <TextBlock Text="{theme:Loc version.m299}" Style="{StaticResource GroupHeaderStyle}"/>

                        <CheckBox Content="{theme:Loc version.m300}"

                                  IsChecked="{Binding Locked, Mode=TwoWay}"

                                  Foreground="{DynamicResource PrimaryForeground}"/>

                    </StackPanel>

                </Border>



                <!-- ⑨ 账号绑定 -->

                <Border Background="{DynamicResource ControlBackground}" CornerRadius="8" Padding="12" Margin="0,0,0,2">

                    <StackPanel>

                        <TextBlock Text="{theme:Loc version.m301}" Style="{StaticResource GroupHeaderStyle}"/>

                        <WrapPanel>

                            <TextBlock Text="{theme:Loc version.m302}" Style="{StaticResource FieldLabelStyle}" Width="88"/>

                            <ComboBox Width="220" ItemsSource="{Binding Accounts}"

                                      SelectedItem="{Binding BoundAccount, Mode=TwoWay}"

                                      DisplayMemberPath="Username" Padding="6,3"/>

                            <Button Content="{theme:Loc version.m303}" Command="{Binding ClearAccountBindingCommand}"

                                    Padding="10,3" Margin="8,0,0,0"/>

                        </WrapPanel>

                    </StackPanel>

                </Border>



            </StackPanel>

        </ScrollViewer>



        <!-- 底部：状态 + 保存 -->

        <Grid Grid.Row="2" Margin="0,10,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap"

                       Foreground="{DynamicResource StatusForeground}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">

                <Button Content="{theme:Loc btn.save}" Command="{Binding SaveCommand}"

                        Style="{StaticResource PrimaryButtonStyle}" Width="86" Padding="0,5"/>

                <Button x:Name="CloseButton" Content="{theme:Loc btn.close}" Width="86" Padding="0,5" Margin="8,0,0,0"/>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>

