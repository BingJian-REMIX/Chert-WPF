<UserControl x:Class="Chert.App.Views.AnnualReportView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="clr-namespace:Chert.App.ViewModels"
             xmlns:theme="clr-namespace:Chert.App.Themes">

    <UserControl.DataContext>

        <vm:AnnualReportViewModel/>

    </UserControl.DataContext>



    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="12" MaxWidth="900">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>   <!-- 标题栏 -->

                <RowDefinition Height="Auto"/>   <!-- 统计卡片 -->

                <RowDefinition Height="Auto"/>   <!-- 月度分布 -->

                <RowDefinition Height="Auto"/>   <!-- 版本排行 + 解读 -->

                <RowDefinition Height="Auto"/>   <!-- 分享 Token -->

                <RowDefinition Height="Auto"/>   <!-- 导入的分享报告 -->

                <RowDefinition Height="Auto"/>   <!-- 状态 -->

            </Grid.RowDefinitions>



            <!-- ===== 标题栏 ===== -->

            <Grid Grid.Row="0" Margin="0,0,0,10">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>



                <TextBlock Grid.Column="0" Text="{theme:Loc annual.m24}" VerticalAlignment="Center" Margin="0,0,8,0"

                           Foreground="{DynamicResource SecondaryForeground}"/>

                <ComboBox Grid.Column="1" ItemsSource="{Binding Years}" SelectedItem="{Binding Year}"

                          Width="84" VerticalContentAlignment="Center"/>



                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">

                    <Run Text="{theme:Loc annual.m25}" Foreground="{DynamicResource SecondaryForeground}"/>

                    <Run Text="{Binding TitleText}" FontWeight="Bold" FontSize="15"

                         Foreground="{DynamicResource AccentBrush}"/>

                </TextBlock>



                <Button Grid.Column="3" Content="{theme:Loc annual.m26}" Command="{Binding CopyTokenCommand}"

                        Width="86" Padding="0,4" Margin="0,0,8,0"/>

                <Button Grid.Column="4" Content="{theme:Loc annual.m27}" Command="{Binding ExportMdCommand}"

                        Width="104" Padding="0,4" Margin="0,0,8,0"/>

                <Button Grid.Column="5" Content="{theme:Loc mods.refresh}" Command="{Binding GenerateCommand}"

                        Width="60" Padding="0,4"/>

            </Grid>



            <!-- ===== 统计卡片 ===== -->

            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">

                <Border Style="{StaticResource CardStyle}" Width="128" Margin="0,0,8,8">

                    <StackPanel>

                        <TextBlock Text="{Binding Data.TotalHours}" FontSize="20" FontWeight="Bold"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                        <TextBlock Text="{theme:Loc annual.m28}" FontSize="11" Margin="0,2,0,0"

                                   Foreground="{DynamicResource SecondaryForeground}"/>

                    </StackPanel>

                </Border>

                <Border Style="{StaticResource CardStyle}" Width="128" Margin="0,0,8,8">

                    <StackPanel>

                        <TextBlock Text="{Binding Data.SessionCount}" FontSize="20" FontWeight="Bold"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                        <TextBlock Text="{theme:Loc annual.m29}" FontSize="11" Margin="0,2,0,0"

                                   Foreground="{DynamicResource SecondaryForeground}"/>

                    </StackPanel>

                </Border>

                <Border Style="{StaticResource CardStyle}" Width="128" Margin="0,0,8,8">

                    <StackPanel>

                        <TextBlock Text="{Binding Data.ActiveDays}" FontSize="20" FontWeight="Bold"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                        <TextBlock Text="{theme:Loc annual.m30}" FontSize="11" Margin="0,2,0,0"

                                   Foreground="{DynamicResource SecondaryForeground}"/>

                    </StackPanel>

                </Border>

                <Border Style="{StaticResource CardStyle}" Width="128" Margin="0,0,8,8">

                    <StackPanel>

                        <TextBlock Text="{Binding Data.LongestStreakDays}" FontSize="20" FontWeight="Bold"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                        <TextBlock Text="{theme:Loc annual.m31}" FontSize="11" Margin="0,2,0,0"

                                   Foreground="{DynamicResource SecondaryForeground}"/>

                    </StackPanel>

                </Border>

                <Border Style="{StaticResource CardStyle}" Width="128" Margin="0,0,8,8">

                    <StackPanel>

                        <TextBlock Text="{Binding Data.LongestSessionMinutes, StringFormat={}{0:F0}m}" FontSize="20" FontWeight="Bold"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                        <TextBlock Text="{theme:Loc annual.m32}" FontSize="11" Margin="0,2,0,0"

                                   Foreground="{DynamicResource SecondaryForeground}"/>

                    </StackPanel>

                </Border>

                <Border Style="{StaticResource CardStyle}" Width="128" Margin="0,0,8,8">

                    <StackPanel>

                        <TextBlock Text="{Binding Data.CrashCount}" FontSize="20" FontWeight="Bold"

                                   Foreground="{DynamicResource DangerBrush}"/>

                        <TextBlock Text="{theme:Loc game.crash_count}" FontSize="11" Margin="0,2,0,0"

                                   Foreground="{DynamicResource SecondaryForeground}"/>

                    </StackPanel>

                </Border>

            </WrapPanel>



            <!-- ===== 月度分布 ===== -->

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,10">

                <StackPanel>

                    <TextBlock Text="{theme:Loc annual.m33}" FontWeight="Bold" Margin="0,0,0,8"

                               Foreground="{DynamicResource PrimaryForeground}"/>

                    <ItemsControl ItemsSource="{Binding MonthlyBars}">

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Grid Margin="0,2">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="36"/>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="56"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" FontSize="11"

                                               VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForeground}"><Run Text="{Binding Month}"/><Run Text="{theme:Loc annual.month}"/></TextBlock>

                                    <Rectangle Grid.Column="1" Height="12" RadiusX="3" RadiusY="3"

                                               HorizontalAlignment="Left" Width="{Binding BarWidth}"

                                               Fill="{DynamicResource AccentBrush}"/>

                                    <TextBlock Grid.Column="2" Text="{Binding Hours, StringFormat={}{0}h}" FontSize="11"

                                               VerticalAlignment="Center" Margin="6,0,0,0"

                                               Foreground="{DynamicResource SecondaryForeground}"/>

                                </Grid>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </Border>



            <!-- ===== 版本排行 + 解读 ===== -->

            <Grid Grid.Row="3" Margin="0,0,0,10">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="8"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>



                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="12,10">

                    <Grid>

                        <Grid.RowDefinitions>

                            <RowDefinition Height="Auto"/>

                            <RowDefinition Height="*"/>

                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{theme:Loc annual.m34}" FontWeight="Bold" Margin="0,0,0,8"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                        <ListBox Grid.Row="1" ItemsSource="{Binding TopVersionRows}" Background="Transparent"

                                 BorderThickness="0" HorizontalContentAlignment="Stretch">

                            <ListBox.ItemTemplate>

                                <DataTemplate>

                                    <Grid Margin="0,3">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="*"/>

                                            <ColumnDefinition Width="Auto"/>

                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Version}" FontWeight="SemiBold"

                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="1" Text="{Binding Hours, StringFormat={}{0}h}" FontSize="11"

                                                   Foreground="{DynamicResource SecondaryForeground}"/>

                                    </Grid>

                                </DataTemplate>

                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Grid>

                </Border>



                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12,10">

                    <StackPanel>

                        <TextBlock Text="{theme:Loc annual.m35}" FontWeight="Bold" Margin="0,0,0,8"

                                   Foreground="{DynamicResource PrimaryForeground}"/>

                        <TextBlock Text="{Binding Narrative}" TextWrapping="Wrap"

                                   Foreground="{DynamicResource SecondaryForeground}" FontSize="12"/>

                    </StackPanel>

                </Border>

            </Grid>



            <!-- ===== 分享 Token ===== -->

            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Padding="12,10" Margin="0,0,0,10">

                <StackPanel>

                    <TextBlock Text="{theme:Loc annual.m36}"

                               FontWeight="Bold" Margin="0,0,0,8" Foreground="{DynamicResource PrimaryForeground}"/>

                    <TextBox Text="{Binding TokenText, Mode=OneWay}" IsReadOnly="True" Height="48"

                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"

                             Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                             BorderBrush="{DynamicResource InputBorder}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">

                        <TextBox Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}"

                                 Width="360" Height="28" VerticalContentAlignment="Center"

                                 Background="{DynamicResource InputBackground}" Foreground="{DynamicResource InputForeground}"

                                 BorderBrush="{DynamicResource InputBorder}"

                                 ToolTip="{theme:Loc annual.m37}"/>

                        <Button Content="{theme:Loc btn.import}" Command="{Binding ImportCommand}" Width="64" Padding="0,4"

                                Margin="8,0,0,0"/>

                        <Button Content="{theme:Loc btn.clear}" Command="{Binding ClearSharedCommand}" Width="64" Padding="0,4"

                                Margin="8,0,0,0"/>

                    </StackPanel>

                </StackPanel>

            </Border>



            <!-- ===== 导入的分享报告 ===== -->

            <Border Grid.Row="5" Padding="12,10" Margin="0,0,10,10">

                <Border.Style>

                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">

                        <Setter Property="Visibility" Value="Collapsed"/>

                        <Style.Triggers>

                            <DataTrigger Binding="{Binding Shared}" Value="{x:Null}">

                                <Setter Property="Visibility" Value="Collapsed"/>

                            </DataTrigger>

                            <DataTrigger Binding="{Binding Shared.HasData}" Value="True">

                                <Setter Property="Visibility" Value="Visible"/>

                            </DataTrigger>

                        </Style.Triggers>

                    </Style>

                </Border.Style>

                <StackPanel>

                    <TextBlock FontWeight="Bold" Margin="0,0,0,6" Foreground="{DynamicResource PrimaryForeground}">

                        <Run Text="{theme:Loc annual.m38}"/>

                        <Run Text="{Binding Shared.Year}"/>

                        <Run Text="{theme:Loc annual.m39}"/>

                        <Run Text="{Binding SharedTitleText}"/>

                        <Run Text="）"/>

                    </TextBlock>

                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryForeground}">

                        <Run Text="{theme:Loc annual.m40}"/>

                        <Run Text="{Binding Shared.TotalHours}"/>

                        <Run Text="{theme:Loc annual.m41}"/>

                        <Run Text="{Binding Shared.SessionCount}"/>

                        <Run Text="{theme:Loc annual.m42}"/>

                        <Run Text="{Binding Shared.ActiveDays}"/>

                        <Run Text="{theme:Loc annual.m43}"/>

                        <Run Text="{Binding Shared.CrashCount}"/>

                        <Run Text="{theme:Loc annual.m44}"/>

                    </TextBlock>

                </StackPanel>

            </Border>



            <TextBlock Grid.Row="6" Text="{Binding StatusMessage}" Margin="0,4,0,0"

                       Foreground="{DynamicResource StatusForeground}" TextWrapping="Wrap"/>

        </Grid>

    </ScrollViewer>

</UserControl>

