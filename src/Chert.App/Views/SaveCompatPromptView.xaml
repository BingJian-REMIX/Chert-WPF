<Window x:Class="Chert.App.Views.SaveCompatPromptView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Chert.App.ViewModels"
        Title="存档版本不兼容" Width="560" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="检测到以下存档的版本高于当前要启动的游戏版本："
                   FontWeight="Bold" TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8">
            <ItemsControl ItemsSource="{Binding Incompatible}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Fill="{Binding SeverityColor}" RadiusX="2" RadiusY="2"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock FontWeight="Bold" Text="{Binding SaveName}"/>
                                    <TextBlock Text="{Binding CompatText}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="#CCC"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource StatusForeground}"
                   TextWrapping="Wrap" Margin="0,4"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="降级这些存档" Command="{Binding DowngradeAllCommand}" Width="120" Padding="0,4" Margin="0,0,8,0"/>
            <Button Content="安装对应版本" Command="{Binding InstallVersionCommand}" Width="110" Padding="0,4" Margin="0,0,8,0"/>
            <Button Content="仍要启动（忽略）" Command="{Binding IgnoreCommand}" Width="120" Padding="0,4"/>
        </StackPanel>
    </Grid>
</Window>
