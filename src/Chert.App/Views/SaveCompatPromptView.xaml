<Window x:Class="Chert.App.Views.SaveCompatPromptView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Chert.App.ViewModels"
        xmlns:theme="clr-namespace:Chert.App.Themes"
        Title="{theme:Loc savecompat.title}" Width="560" Height="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource ModalScrimBrush}"
        Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <!-- 主卡片：复用已定义的 ModalCardStyle（暗色底 / 圆角 / 阴影） -->
    <Border x:Name="Card" Style="{StaticResource ModalCardStyle}"
            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{theme:Loc savecompat.detected}"
                       FontWeight="Bold" TextWrapping="Wrap"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,8">
                <ItemsControl ItemsSource="{Binding Incompatible}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="{Binding SeverityColor}" RadiusX="2" RadiusY="2"/>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <TextBlock FontWeight="Bold" Text="{Binding SaveName}"/>
                                        <TextBlock Text="{Binding CompatText}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="#CCC"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{DynamicResource StatusForeground}"
                       TextWrapping="Wrap" Margin="0,4"/>

            <!-- 按钮行：复用 ModalButtonRowStyle（右置主操作） -->
            <StackPanel Grid.Row="3" Style="{StaticResource ModalButtonRowStyle}" Margin="0,8,0,0">
                <Button Content="{theme:Loc savecompat.downgrade}" Command="{Binding DowngradeAllCommand}" Width="120" Padding="0,4" Margin="0,0,8,0"/>
                <Button Content="{theme:Loc savecompat.install_version}" Command="{Binding InstallVersionCommand}" Width="110" Padding="0,4" Margin="0,0,8,0"/>
                <Button Content="{theme:Loc savecompat.ignore}" Command="{Binding IgnoreCommand}" Width="120" Padding="0,4"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
