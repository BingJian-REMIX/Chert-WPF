<Window x:Class="MCLCS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MCLCS.App.ViewModels"
        xmlns:svc="clr-namespace:MCLCS.App.Services"
        xmlns:theme="clr-namespace:MCLCS.App.Themes"
        xmlns:conv="clr-namespace:MCLCS.App.Converters"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MCLCS"
        Width="1100" Height="720"
        MinWidth="900" MinHeight="600"
        WindowStyle="None"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVisibility"/>
    </Window.Resources>
    <!-- 让 WindowStyle=None 窗口真正无边框：消除 Windows 在窗口最外缘残留的 DWM 白边；
         CaptionHeight=0 保留标题栏手动 DragMove（TitleBar_MouseDown），ResizeBorderThickness 恢复边缘拖拽缩放。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="0" CornerRadius="0"
                            ResizeBorderThickness="6" CaptionHeight="0"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>     <!-- 标题栏（跟随主标签变色） -->
            <RowDefinition Height="*"/>      <!-- 主体：侧边栏 + 内容 -->
            <RowDefinition Height="30"/>     <!-- 状态栏 -->
        </Grid.RowDefinitions>

        <!-- ===== 标题栏 ===== -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource TitleBarBrush}"
              MouseLeftButtonDown="TitleBar_MouseDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="272"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="MCLCS" FontSize="17" FontWeight="Bold"
                       Foreground="{DynamicResource TitleBarForeground}" VerticalAlignment="Center" Margin="16,0,0,0"/>

            <!-- 全局搜索栏 + 下载进度入口（bug #14：下载队列合并至搜索栏右侧弹窗） -->
            <Grid Grid.Column="1" Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="GlobalSearchBox" Grid.Column="0" VerticalAlignment="Center"
                         Padding="8,4" FontSize="12"
                         Background="#30FFFFFF" Foreground="White" CaretBrush="White"
                         BorderBrush="#40FFFFFF" BorderThickness="1"
                         ToolTip="{theme:Loc dl.search_hint}"
                         KeyDown="GlobalSearch_KeyDown"/>

                <!-- 下载进度按钮：无框无底，仅保留环形进度条（bug2.txt #76） -->
                <Button x:Name="DownloadPopupBtn" Grid.Column="1" Width="40" Height="40"
                        Margin="6,0,0,0" Cursor="Hand" Background="Transparent" BorderThickness="0"
                        ToolTip="下载队列 / 进度" Click="DownloadPopupBtn_Click">
                <Grid>
                    <!-- 环形进度：仅在有下载任务时显示（无任务不显环，bug3.txt #2） -->
                    <Grid Visibility="{Binding IsDownloading, Source={x:Static vm:StatusBarViewModel.Current},
                                Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <!-- 背景轨：半透明主题色，避免暗色下出现黑环 -->
                        <Ellipse Width="34" Height="34" Stroke="{DynamicResource TitleBarOverlayForeground}" StrokeThickness="3" Fill="Transparent"/>
                        <!-- 进度环：主题前景色，实时，以图标中心为圆心 -->
                        <Ellipse Width="34" Height="34" Stroke="{DynamicResource TitleBarForeground}" StrokeThickness="3"
                                 StrokeDashArray="{Binding DownloadProgress, Source={x:Static vm:StatusBarViewModel.Current},
                                    Converter={StaticResource ProgressToRingDash}, ConverterParameter=94.25}"
                                 StrokeDashCap="Round" Fill="Transparent" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <theme:PngIcon Token="download" Size="14"/>
                    <!-- 队列项数角标 -->
                    <Border Background="#E53935" CornerRadius="7" MinWidth="14" Height="14"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,-6,-8,0" Padding="3,0"
                            Visibility="{Binding HasQueue, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding QueueCount}"
                                   Foreground="{DynamicResource TitleBarForeground}" FontSize="9" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
                </Button>
            </Grid>

            <!-- 下载队列弹窗（全局，随时可查看 / 开始 / 暂停 / 取消） -->
            <Popup x:Name="DownloadQueuePopup" PlacementTarget="{Binding ElementName=DownloadPopupBtn}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                   HorizontalOffset="-260" VerticalOffset="6">
                <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1"
                        CornerRadius="8" Width="420" Padding="12">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.28" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="下载队列" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource PrimaryForeground}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding QueueCount, StringFormat='共 {0} 项', FallbackValue='共 0 项'}"
                                           VerticalAlignment="Center" Opacity="0.75" Margin="0,0,10,0"
                                           Foreground="{DynamicResource SecondaryForeground}"/>
                                <Button Content="开始下载队列" Padding="10,3"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Command="{Binding StartQueueCommand}"/>
                            </StackPanel>
                        </Grid>

                        <!-- 空状态 -->
                        <TextBlock Text="队列为空，去下载页把资源加入队列吧"
                                   Margin="0,10,0,10" HorizontalAlignment="Center" Opacity="0.6"
                                   Foreground="{DynamicResource SecondaryForeground}"
                                   Visibility="{Binding HasQueue, Converter={StaticResource InvBoolToVisibility}, FallbackValue=Visible}"/>

                        <ItemsControl ItemsSource="{Binding Queue}"
                                      MaxHeight="260">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Title}" FontSize="12"
                                                       Foreground="{DynamicResource PrimaryForeground}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Height="8"
                                                         Margin="0,3,0,0"
                                                         Foreground="{DynamicResource AccentBrush}"
                                                         Background="{DynamicResource ProgressBackground}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11"
                                                   VerticalAlignment="Center" Width="52"
                                                   Foreground="{DynamicResource SecondaryForeground}"/>
                                        <Button Grid.Column="2" Content="{theme:Loc dl.pause}" Padding="6,2" Margin="0,0,4,0"
                                                Command="{Binding DataContext.PauseItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding Status, Converter={StaticResource QueueActionEnabledConverter}, ConverterParameter='pause'}"/>
                                        <Button Grid.Column="3" Content="{theme:Loc btn.cancel}" Padding="6,2"
                                                Command="{Binding DataContext.CancelItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding Status, Converter={StaticResource QueueActionEnabledConverter}, ConverterParameter='cancel'}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- 四色索引贴主标签（bug #5：下移贴标题栏底部、下端直角齐平） -->
            <StackPanel x:Name="TabPanel" Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,0"/>

            <!-- 窗口控制 -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                <Button x:Name="BtnMin" Width="36" Height="30" Click="BtnMin_Click">
                    <theme:PngIcon Token="minimize" Size="12"/>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="BtnMax" Width="36" Height="30" Click="BtnMax_Click">
                    <Grid>
                        <TextBlock x:Name="MaxIcon" Text="&#x25A1;" FontSize="12" Foreground="{DynamicResource TitleBarForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible"/>
                        <TextBlock x:Name="RestoreIcon" Text="&#x1F5D6;" FontSize="12" Foreground="{DynamicResource TitleBarForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button x:Name="BtnClose" Width="36" Height="30" Click="BtnClose_Click">
                    <theme:PngIcon Token="close" Size="12"/>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E74C3C"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>   <!-- 侧边栏列（宽度随 SidebarRoot 变化） -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 全局侧边栏（bug #6：隐藏竖滚动条，避免遮挡图标/截断长名；bug #20：右边线随当前主标签色） -->
            <Border x:Name="SidebarRoot" Grid.Column="0" Width="56"
                    Background="{DynamicResource ControlBackground}"
                    BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SidebarIndicatorBrush}"
                    MouseEnter="Sidebar_MouseEnter" MouseLeave="Sidebar_MouseLeave">
                <ScrollViewer x:Name="SidebarScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="SidebarItemsPanel" Orientation="Vertical" Margin="6,8"/>
                </ScrollViewer>
            </Border>

            <!-- 内容宿主（分页切换动画作用于此） -->
            <Border x:Name="PageBorder" Grid.Column="1" Background="{DynamicResource WindowBackground}"
                    TextElement.Foreground="{DynamicResource PrimaryForeground}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PageTransform" Y="0"/>
                </Border.RenderTransform>
                <!-- Border 仅允许单个子元素，用 Grid 叠放「背景图片层 + 页面宿主」 -->
                <Grid>
                    <!-- 背景图片层（bug #20）：置于内容之下，未设置时隐藏 -->
                    <Image x:Name="BackgroundImage" Stretch="UniformToFill" Visibility="Collapsed"
                           IsHitTestVisible="False" Panel.ZIndex="0"/>
                    <ContentControl x:Name="PageHost" Panel.ZIndex="1"/>
                </Grid>
            </Border>

            <!-- bug #10：版本库大页覆盖层（覆盖内容区，默认隐藏） -->
            <Grid x:Name="BigPageHost" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="50"
                  Visibility="Collapsed" Background="{DynamicResource WindowBackground}"/>
        </Grid>

        <!-- 音乐解码宿主（隐藏，仅用于后台播放） -->
        <MediaElement x:Name="MusicMedia" Visibility="Collapsed"/>

        <!-- ===== 状态栏 ===== -->
        <StatusBar Grid.Row="2" Background="{DynamicResource ControlBackground}"
                   Foreground="{DynamicResource StatusForeground}">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel LastChildFill="False"/>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Text="{Binding JavaVersionText, Source={x:Static vm:StatusBarViewModel.Current}}"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Margin="12,0,0,0"
                           Text="{Binding InstalledCountText, Source={x:Static vm:StatusBarViewModel.Current}}"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock Margin="12,0,0,0"
                           Text="{Binding RunningInstancesText, Source={x:Static vm:StatusBarViewModel.Current}}"/>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Left">
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0">
                    <ProgressBar Width="120" Height="12" Minimum="0" Maximum="100"
                                  Value="{Binding DownloadProgress, Source={x:Static vm:StatusBarViewModel.Current}}"
                                  Foreground="{DynamicResource AccentBrush}"
                                  Background="{DynamicResource ProgressBackground}"/>
                    <TextBlock Margin="8,0,0,0"
                               Text="{Binding DownloadText, Source={x:Static vm:StatusBarViewModel.Current}}"/>
                </StackPanel>
            </StatusBarItem>
            <!-- 音乐播放器迷你条（规格 2.3：状态栏迷你条可展开为完整列表） -->
            <StatusBarItem DockPanel.Dock="Left" Margin="14,0,0,0"
                           Visibility="{Binding HasTrack, Source={x:Static vm:MusicPlayerViewModel.Instance}, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal" x:Name="MusicMini">
                    <Button Width="26" Height="22" BorderThickness="0" Background="Transparent"
                            Command="{Binding PreviousCommand, Source={x:Static vm:MusicPlayerViewModel.Instance}}"
                            ToolTip="上一首" VerticalAlignment="Center" Content="⏮" FontSize="11"/>
                    <Button Width="26" Height="22" BorderThickness="0" Background="Transparent"
                            Command="{Binding PlayPauseCommand, Source={x:Static vm:MusicPlayerViewModel.Instance}}"
                            ToolTip="播放 / 暂停" VerticalAlignment="Center" FontSize="11">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content" Value="▶"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlaying, Source={x:Static vm:MusicPlayerViewModel.Instance}}" Value="True">
                                        <Setter Property="Content" Value="⏸"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Width="26" Height="22" BorderThickness="0" Background="Transparent"
                            Command="{Binding NextCommand, Source={x:Static vm:MusicPlayerViewModel.Instance}}"
                            ToolTip="下一首" VerticalAlignment="Center" Content="⏭" FontSize="11"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock Text="{Binding CurrentTrackDisplay, Source={x:Static vm:MusicPlayerViewModel.Instance}, Mode=OneWay, FallbackValue='未选择曲目'}"
                                   MaxWidth="200" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource StatusForeground}"/>
                        <TextBlock FontSize="10" Opacity="0.65" MaxWidth="200" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource StatusForeground}"
                                   Text="{Binding CurrentTrackMetaText, Source={x:Static vm:MusicPlayerViewModel.Instance}, Mode=OneWay, FallbackValue=''}"/>
                    </StackPanel>
                    <!-- bug #10/#12：微条细长进度条（有曲目即显示；时长未知时禁用） -->
                    <Slider Minimum="0" Maximum="100" Width="80" VerticalAlignment="Center" Margin="10,0,0,0"
                            Value="{Binding ProgressRatio, Source={x:Static vm:MusicPlayerViewModel.Instance}, Mode=OneWay}"
                            Visibility="{Binding HasTrack, Source={x:Static vm:MusicPlayerViewModel.Instance}, Converter={StaticResource BoolToVisibility}}"
                            IsEnabled="{Binding HasProgress, Source={x:Static vm:MusicPlayerViewModel.Instance}, Mode=OneWay}"/>
                    <Button x:Name="MusicExpandBtn" Width="24" Height="22" BorderThickness="0" Background="Transparent"
                            Command="{Binding ExpandCommand, Source={x:Static vm:MusicPlayerViewModel.Instance}}"
                            ToolTip="展开 / 收起播放列表" VerticalAlignment="Center" Content="▤" FontSize="11"/>
                </StackPanel>
            </StatusBarItem>

            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding IsNetworkOk, Source={x:Static vm:StatusBarViewModel.Current},
                                Converter={StaticResource BoolToColor}}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding NetworkStatusText, Source={x:Static vm:StatusBarViewModel.Current}}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- 音乐播放列表弹出层（迷你条展开） -->
        <Popup x:Name="MusicListPopup" PlacementTarget="{Binding ElementName=MusicExpandBtn}"
               Placement="Top" StaysOpen="False" AllowsTransparency="True"
               IsOpen="{Binding Expanded, Source={x:Static vm:MusicPlayerViewModel.Instance}, Mode=OneWay}">
            <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource ControlBorder}"
                    BorderThickness="1" CornerRadius="8" Width="320" Height="300"
                    Padding="10">
                <Grid DataContext="{x:Static vm:MusicPlayerViewModel.Instance}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="播放列表" FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryForeground}" Margin="2,0,0,6"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Tracks}"
                             SelectedItem="{Binding CurrentTrack, Mode=OneWay}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.PlayTrackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" HorizontalContentAlignment="Left"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="6,4" Margin="0,1"
                                        Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}">
                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0"
                                VerticalAlignment="Center">
                        <Button Width="28" Height="24" BorderThickness="0" Background="Transparent"
                                Command="{Binding PreviousCommand}" ToolTip="上一首">
                            <theme:PngIcon Token="previous" Size="12"/>
                        </Button>
                        <Button Width="28" Height="24" BorderThickness="0" Background="Transparent"
                                Command="{Binding PlayPauseCommand}" ToolTip="播放 / 暂停">
                            <theme:PngIcon Size="12">
                                <theme:PngIcon.Style>
                                    <Style TargetType="theme:PngIcon">
                                        <Setter Property="Token" Value="play"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Token" Value="pause"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </theme:PngIcon.Style>
                            </theme:PngIcon>
                        </Button>
                        <Button Width="28" Height="24" BorderThickness="0" Background="Transparent"
                                Command="{Binding NextCommand}" ToolTip="下一首">
                            <theme:PngIcon Token="next" Size="12"/>
                        </Button>
                        <TextBlock Text="{Binding Volume, StringFormat={}{0}%}" Width="34" Margin="6,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForeground}"/>
                        <Slider Minimum="0" Maximum="100" Width="90" VerticalAlignment="Center"
                                Value="{Binding Volume, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <!-- ===== 右下角 Toast 通知层（规格 2.3-16：非阻塞、5 秒自动消失、可查看详情）=====
             覆盖全部三行，但只在卡片本身处可点击，空白区域不拦截下层交互。 -->
        <ItemsControl Grid.Row="0" Grid.RowSpan="3"
                      ItemsSource="{Binding Source={x:Static svc:ToastService.Items}}"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,16,40" Width="330" Background="Transparent">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,6,0,0" CornerRadius="8" Padding="0"
                            Background="{DynamicResource ControlBackground}"
                            BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" Color="Black"/>
                        </Border.Effect>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="0" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 语气色条 -->
                            <Border Grid.Column="0" CornerRadius="8,0,0,8"
                                    Background="{Binding AccentColor, Converter={StaticResource StrToBrush}}"/>

                            <StackPanel Grid.Column="1" Margin="12,10,8,10">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"
                                           Foreground="{DynamicResource PrimaryForeground}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Message}" Margin="0,3,0,0" FontSize="12"
                                           Foreground="{DynamicResource SecondaryForeground}"
                                           TextWrapping="Wrap" MaxHeight="60"/>
                                <Button Content="{Binding ActionText}" Command="{Binding ActionCommand}"
                                        Margin="0,7,0,0" Padding="10,3" HorizontalAlignment="Left"
                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>

                            <Button Grid.Column="2" Command="{Binding CloseCommand}"
                                    Width="26" Height="26" Margin="0,6,6,0"
                                    VerticalAlignment="Top" BorderThickness="0"
                                    Background="Transparent" ToolTip="关闭">
                                <theme:PngIcon Token="close" Size="9"/>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
