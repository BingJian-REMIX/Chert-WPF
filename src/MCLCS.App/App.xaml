<Application x:Class="MCLCS.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MCLCS.App.ViewModels"
             xmlns:conv="clr-namespace:MCLCS.App.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 默认亮色启动（规格：WPF 默认 Light）；运行期 ApplyTheme 会按 mclcs_theme.json 覆盖。 -->
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="Themes/Palette.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 布尔 → 颜色（网络指示灯） -->
            <conv:BoolToColorConverter x:Key="BoolToColor"/>
            <!-- 字符串相等（RadioButton ↔ 字符串属性） -->
            <conv:StringEqualityConverter x:Key="StrEq"/>
            <!-- Ollama 服务状态 → 指示灯画刷 -->
            <conv:OllamaStatusToBrushConverter x:Key="OllamaStatusBrush"/>
            <!-- #RRGGBB 字符串 → 画刷（Toast 色条 / 索引贴颜色预览） -->
            <conv:StringToBrushConverter x:Key="StrToBrush"/>
            <!-- 布尔 → 可见性（全局共用，避免各页重复声明） -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <!-- 布尔取反 → 可见性（BooleanToVisibilityConverter 不认 ConverterParameter，需独立实例） -->
            <conv:InverseBoolToVisibilityConverter x:Key="BoolToVisInvert"/>
            <!-- 非空字符串 → 可见（详情文本、空状态提示） -->
            <conv:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis"/>
            <!-- 进度 0–100 → 环形进度条虚线串（bug.txt #7 细环形，对齐 Linux） -->
            <conv:ProgressToRingDashConverter x:Key="ProgressToRingDash"/>
            <!-- 下载队列状态 → 暂停/取消按钮是否可用 -->
            <conv:QueueActionEnabledConverter x:Key="QueueActionEnabledConverter"/>
            <!-- 动作类型等于/不等于某值 → 显隐（AFK 编辑器按类型切换编辑项） -->
            <conv:StringEqualsToVisibilityConverter x:Key="StrEqualsVis"/>
            <conv:StringNotEqualsToVisibilityConverter x:Key="StrNotEqualsVis"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
