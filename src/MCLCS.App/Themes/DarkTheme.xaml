<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ====== Dark Theme ====== -->

    <!-- Window / Control backgrounds -->
    <SolidColorBrush x:Key="WindowBackground" Color="#0F1115"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#1A1D24"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#2A2F3A"/>
    <SolidColorBrush x:Key="ControlHoverBackground" Color="#252830"/>

    <!-- 卡片（规格 1.4：圆角阴影；半透明玻璃质感，随亮/暗主题切换） -->
    <SolidColorBrush x:Key="CardBackground" Color="#B31A1D24"/>
    <SolidColorBrush x:Key="CardBorderHover" Color="#3B82F6"/>
    <!-- 开关轨道（关闭态） -->
    <SolidColorBrush x:Key="ToggleOffBrush" Color="#3A3F4A"/>

    <!-- Foreground -->
    <SolidColorBrush x:Key="PrimaryForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryForeground" Color="#C8CDD6"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="StatusForeground" Color="#C8CDD6"/>

    <!-- 标题栏前景（窗口控制图标 / 标题文字）：暗色主题下标题栏偏暗，用白；亮色主题见 LightTheme -->
    <SolidColorBrush x:Key="TitleBarForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TitleBarOverlayForeground" Color="#40FFFFFF"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2B6FE0"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E74C3C"/>

    <!-- ListView -->
    <SolidColorBrush x:Key="ListViewBackground" Color="#14161C"/>
    <SolidColorBrush x:Key="ListViewHeaderBackground" Color="#1E2128"/>
    <SolidColorBrush x:Key="ListViewBorder" Color="#2A2F3A"/>

    <!-- TabControl -->
    <SolidColorBrush x:Key="TabBackground" Color="#0F1115"/>
    <SolidColorBrush x:Key="TabItemBackground" Color="#1A1D24"/>
    <SolidColorBrush x:Key="TabItemSelectedBackground" Color="#252830"/>
    <SolidColorBrush x:Key="TabItemHoverBackground" Color="#1E2128"/>

    <!-- Button -->
    <SolidColorBrush x:Key="ButtonBackground" Color="#3B82F6"/>
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#2B6FE0"/>
    <SolidColorBrush x:Key="ButtonDisabledBackground" Color="#3A3F4A"/>

    <!-- TextBox / ComboBox -->
    <SolidColorBrush x:Key="InputBackground" Color="#14161C"/>
    <SolidColorBrush x:Key="InputForeground" Color="#E6E6E6"/>
    <SolidColorBrush x:Key="InputBorder" Color="#2A2F3A"/>
    <SolidColorBrush x:Key="InputFocusBorder" Color="#3B82F6"/>

    <!-- Progress -->
    <SolidColorBrush x:Key="ProgressBackground" Color="#2A2F3A"/>
    <SolidColorBrush x:Key="ProgressForeground" Color="#3B82F6"/>

</ResourceDictionary>
