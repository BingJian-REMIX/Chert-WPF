<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!--
      刻意不启用 UseWindowsForms：该开关会注入 System.Drawing 与 System.Windows.Forms 两个全局 using，
      与 WPF 的 UserControl / Application / Brush / Point / Rectangle / MouseEventArgs 等类型大面积撞名（CS0104），
      而全局 using 无法被文件级 using 遮蔽。选择文件夹改用 WPF 原生 Microsoft.Win32.OpenFolderDialog。
    -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2.5.6</Version>
    <!-- 仅保留简体中文框架资源（zh-Hans），剔除其余语言卫星程序集，缩小发布体积 -->
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <RootNamespace>MCLCS.App</RootNamespace>
    <!-- AssemblyName 保持 MCLCS.App：若改成 MCLCS 会与 CLI 工具的 mclcs 在 Windows 大小写不敏感下等同，
         既触发 NuGet restore 的 Ambiguous project name，又会让二者 exe 在 CLI 输出目录同名互相覆盖。
         故启动器内部名为 MCLCS.App，下面 RenameLauncherToMCLCS 目标把输出 exe 额外复制为用户友好的 MCLCS.exe
         （同时复制 runtimeconfig/deps/pdb）；原 MCLCS.App.exe 保留，供 CLI 工程经 ProjectReference 拷贝其类型。 -->
    <AssemblyName>MCLCS.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 应用图标（Windows 多分辨率 ico）：在资源管理器/任务栏显示，并随打包进 exe。
         托盘图标同样取自该文件（见 Services/TrayIconService.cs）。 -->
    <ApplicationIcon>Resources\MCLCS.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MCLCS.Core\MCLCS.Core.csproj" />
  </ItemGroup>

  <!-- PNG UI 图标：编译进程序集（Resource），不复制到输出目录，运行时不可被直接篡改/读取。
       嵌入 1x（light/dark）与 2x 高清（light@2x/dark@2x），后者供“适配高分辨率屏幕”开关启用。 -->
  <ItemGroup>
    <Resource Include="Resources\Icons\light\**\*.png" />
    <Resource Include="Resources\Icons\dark\**\*.png" />
    <Resource Include="Resources\Icons\light@2x\**\*.png" />
    <Resource Include="Resources\Icons\dark@2x\**\*.png" />
    <!-- 皮肤编辑器默认皮肤（替代旧的全蓝底色）。编译进程序集，运行时经 pack URI 读取。 -->
    <Resource Include="Resources\Skins\dummy.png" />
  </ItemGroup>

  <!-- 系统托盘图标：与 ApplicationIcon 共用 Resources\MCLCS.ico，随构建复制到输出目录（bug #26）。 -->
  <ItemGroup>
    <None Include="Resources\MCLCS.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

    <!-- 构建后把 MCLCS.App.exe 额外复制为用户友好的“MCLCS Launcher.exe”（同时复制 runtimeconfig/deps/pdb）。
       原 MCLCS.App.exe 保留，供 CLI 工程通过 ProjectReference 拷贝其 MCLCS.App 命名空间类型使用。
       说明：AssemblyName 必须保持 MCLCS.App（图标 PackUri 与 CLI 类型引用都依赖它），故只能以“复制”方式给出带空格的产品名 exe，
       而非直接改 AssemblyName（那会复现之前图标全丢 + NuGet 撞名的问题）。 -->
  <Target Name="RenameLauncherToMCLCS" AfterTargets="Build"
          Inputs="$(OutDir)$(TargetName).exe"
          Outputs="$(OutDir)MCLCS Launcher.exe">
    <PropertyGroup>
      <_LauncherSrcBase>$(OutDir)$(TargetName)</_LauncherSrcBase>
      <_LauncherDstBase>$(OutDir)MCLCS Launcher</_LauncherDstBase>
    </PropertyGroup>
    <Copy SourceFiles="$(_LauncherSrcBase).exe"
          DestinationFiles="$(_LauncherDstBase).exe"
          Condition="Exists('$(_LauncherSrcBase).exe')" />
    <Copy SourceFiles="$(_LauncherSrcBase).runtimeconfig.json"
          DestinationFiles="$(_LauncherDstBase).runtimeconfig.json"
          Condition="Exists('$(_LauncherSrcBase).runtimeconfig.json')" />
    <Copy SourceFiles="$(_LauncherSrcBase).deps.json"
          DestinationFiles="$(_LauncherDstBase).deps.json"
          Condition="Exists('$(_LauncherSrcBase).deps.json')" />
    <Copy SourceFiles="$(_LauncherSrcBase).pdb"
          DestinationFiles="$(_LauncherDstBase).pdb"
          Condition="Exists('$(_LauncherSrcBase).pdb')" />
    <!-- 清理上一版复制目标产出的旧名 MCLCS.exe（及配套文件），避免与新的“MCLCS Launcher.exe”并存造成混淆。
         注意：Windows 文件系统大小写不敏感，MCLCS.exe 与 mclcs.exe 视为同一文件；CLI 会把 mclcs.exe 复制到本目录，
         故删除旧名时必须先确认 mclcs.* 不存在，否则会误删 CLI 的 mclcs.exe。 -->
    <Delete Files="$(OutDir)MCLCS.exe" Condition="Exists('$(OutDir)MCLCS.exe') And !Exists('$(OutDir)mclcs.exe')" />
    <Delete Files="$(OutDir)MCLCS.pdb" Condition="Exists('$(OutDir)MCLCS.pdb') And !Exists('$(OutDir)mclcs.pdb')" />
    <Delete Files="$(OutDir)MCLCS.runtimeconfig.json" Condition="Exists('$(OutDir)MCLCS.runtimeconfig.json') And !Exists('$(OutDir)mclcs.runtimeconfig.json')" />
    <Delete Files="$(OutDir)MCLCS.deps.json" Condition="Exists('$(OutDir)MCLCS.deps.json') And !Exists('$(OutDir)mclcs.deps.json')" />
  </Target>

</Project>
